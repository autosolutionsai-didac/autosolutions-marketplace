+// Fixed-window rate limiter keyed by string. A window starts at the first hit
+// for a key and lasts windowMs; hits beyond limit in that window are rejected.
+export function createRateLimiter({ limit = 60, windowMs = 60_000, now = Date.now } = {}) {
+  const windows = new Map()
+
+  return {
+    hit(key) {
+      const t = now()
+      let entry = windows.get(key)
+      if (!entry || t >= entry.windowStart + windowMs) {
+        entry = { windowStart: t, count: 0 }
+        windows.set(key, entry)
+      }
+
+      const allowed = entry.count < limit
+      if (allowed) entry.count++
+      const remaining = allowed ? limit - entry.count : 0
+      const retryAfter = Math.max(1, Math.ceil((entry.windowStart + windowMs - t) / 1000))
+      return { allowed, limit, remaining, retryAfter }
+    },
+  }
+}
