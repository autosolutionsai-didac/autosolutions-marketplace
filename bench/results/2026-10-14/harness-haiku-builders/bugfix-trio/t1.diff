--- a/test/csv.test.js
+++ b/test/csv.test.js
@@ -13,3 +13,16 @@ test('toCSV renders a header and one line per row', () => {
 test('toCSV leaves missing values empty', () => {
   assert.equal(toCSV([{ a: null }], ['a', 'b']), 'a,b\n,\n')
 })
+
+test('toCSV quotes values containing a comma', () => {
+  assert.equal(toCSV([{ key: 'team, alpha', n: 1 }], ['key', 'n']), 'key,n\n"team, alpha",1\n')
+})
+
+test('toCSV doubles double quotes inside quoted values', () => {
+  assert.equal(toCSV([{ a: 'say "hi"' }], ['a']), 'a\n"say ""hi"""\n')
+})
+
+test('toCSV quotes values containing LF or CR', () => {
+  assert.equal(toCSV([{ a: 'a\nb' }], ['a']), 'a\n"a\nb"\n')
+  assert.equal(toCSV([{ a: 'a\rb' }], ['a']), 'a\n"a\rb"\n')
+})
