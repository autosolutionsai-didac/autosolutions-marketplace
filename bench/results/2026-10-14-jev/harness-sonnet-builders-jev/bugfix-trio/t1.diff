--- a/test/csv.test.js
+++ b/test/csv.test.js
@@ -13,3 +13,28 @@ test('toCSV renders a header and one line per row', () => {
 test('toCSV leaves missing values empty', () => {
   assert.equal(toCSV([{ a: null }], ['a', 'b']), 'a,b\n,\n')
 })
+
+test('toCSV quotes values containing a comma', () => {
+  assert.equal(toCSV([{ key: 'team, alpha' }], ['key']), 'key\n"team, alpha"\n')
+})
+
+test('toCSV doubles embedded double quotes', () => {
+  assert.equal(toCSV([{ a: 'say "hi"' }], ['a']), 'a\n"say ""hi"""\n')
+})
+
+test('toCSV quotes values containing LF or CR', () => {
+  assert.equal(toCSV([{ a: 'x\ny' }], ['a']), 'a\n"x\ny"\n')
+  assert.equal(toCSV([{ a: 'x\ry' }], ['a']), 'a\n"x\ry"\n')
+})
+
+test('toCSV leaves plain values and numbers unquoted', () => {
+  assert.equal(toCSV([{ a: 'plain', b: 42, c: 0 }], ['a', 'b', 'c']), 'a,b,c\nplain,42,0\n')
+})
+
+test('toCSV renders null and undefined as empty', () => {
+  assert.equal(toCSV([{ a: null, b: undefined }], ['a', 'b']), 'a,b\n,\n')
+})
+
+test('toCSV escapes header names', () => {
+  assert.equal(toCSV([], ['a,b']), '"a,b"\n')
+})
diff --git a/test/invoice-csv.test.js b/test/invoice-csv.test.js
new file mode 100644
index 0000000..428128e
--- /dev/null
+++ b/test/invoice-csv.test.js
@@ -0,0 +1,36 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createServer } from '../src/server.js'
+import { Ledger } from '../src/ledger.js'
+
+async function start() {
+  const server = createServer({ ledger: new Ledger(), now: () => 1_000 })
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const base = `http://127.0.0.1:${server.address().port}`
+  const close = () => new Promise((resolve) => { server.closeAllConnections(); server.close(resolve) })
+  return { base, close }
+}
+
+const event = { model: 'claude-sonnet-5', usage: { inputTokens: 1_000_000, outputTokens: 100_000 } }
+
+test('invoice CSV quotes an API key containing a comma', async () => {
+  const { base, close } = await start()
+  try {
+    const key = 'team, alpha'
+    const posted = await fetch(`${base}/events`, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json', 'x-api-key': key },
+      body: JSON.stringify(event),
+    })
+    assert.equal(posted.status, 201)
+    const res = await fetch(`${base}/invoices/${encodeURIComponent(key)}?format=csv`)
+    assert.equal(res.status, 200)
+    assert.equal(
+      await res.text(),
+      'key,model,requests,inputTokens,outputTokens,cacheReadTokens,cacheWriteTokens,costMicro\n' +
+        '"team, alpha",claude-sonnet-5,1,1000000,100000,0,0,3000000\n',
+    )
+  } finally {
+    await close()
+  }
+})
