+// Fixed-window in-memory rate limiter keyed by caller
+export function createRateLimiter({ limit = 60, windowMs = 60_000, now = Date.now } = {}) {
+  const entries = new Map()
+
+  function check(key) {
+    const t = now()
+    let entry = entries.get(key)
+    if (!entry || t >= entry.windowStart + windowMs) {
+      entry = { windowStart: t, count: 0 }
+      entries.set(key, entry)
+    }
+    if (entry.count < limit) {
+      entry.count++
+      return { allowed: true, limit, remaining: Math.max(0, limit - entry.count) }
+    }
+    return {
+      allowed: false,
+      limit,
+      remaining: 0,
+      retryAfter: Math.max(1, Math.ceil((entry.windowStart + windowMs - t) / 1000)),
+    }
+  }
+
+  return { check }
+}
