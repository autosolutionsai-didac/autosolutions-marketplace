+// Fixed-window rate limiter keyed by caller, using an injected clock.
+export function createRateLimiter({ limit, windowMs, now }) {
+  const windows = new Map()
+
+  function check(key) {
+    const t = now()
+    let state = windows.get(key)
+    if (!state || t >= state.windowStart + windowMs) {
+      state = { windowStart: t, count: 0 }
+      windows.set(key, state)
+    }
+    if (state.count < limit) {
+      state.count++
+      return { allowed: true, limit, remaining: limit - state.count, retryAfter: 0 }
+    }
+    const retryAfter = Math.max(1, Math.ceil((state.windowStart + windowMs - t) / 1000))
+    return { allowed: false, limit, remaining: 0, retryAfter }
+  }
+
+  return { check }
+}
