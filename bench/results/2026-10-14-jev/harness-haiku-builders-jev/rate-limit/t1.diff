@@ -0,0 +1,30 @@
+// Fixed-window limiter with one window per key. A key's window opens at its
+// first request and lasts windowMs. Up to `limit` requests are allowed per
+// window; the rest are rejected until the window ends, and the next request
+// after that opens a new window.
+export const DEFAULT_RATE_LIMIT = { limit: 60, windowMs: 60000 }
+
+export function createRateLimiter({ limit = 60, windowMs = 60000, now }) {
+  const windows = new Map()
+
+  return {
+    check(key) {
+      const t = now()
+      let state = windows.get(key)
+      if (!state || t >= state.windowStart + windowMs) {
+        state = { windowStart: t, count: 0 }
+        windows.set(key, state)
+      }
+      if (state.count < limit) {
+        state.count++
+        return { allowed: true, limit, remaining: Math.max(0, limit - state.count) }
+      }
+      return {
+        allowed: false,
+        limit,
+        remaining: 0,
+        retryAfter: Math.max(1, Math.ceil((state.windowStart + windowMs - t) / 1000)),
+      }
+    },
+  }
+}
