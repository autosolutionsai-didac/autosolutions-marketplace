--- a/test/csv.test.js
+++ b/test/csv.test.js
@@ -13,3 +13,24 @@ test('toCSV renders a header and one line per row', () => {
 test('toCSV leaves missing values empty', () => {
   assert.equal(toCSV([{ a: null }], ['a', 'b']), 'a,b\n,\n')
 })
+
+test('toCSV quotes fields containing a comma', () => {
+  assert.equal(toCSV([{ key: 'team, alpha', n: 1 }], ['key', 'n']), 'key,n\n"team, alpha",1\n')
+})
+
+test('toCSV doubles embedded double quotes and wraps the field', () => {
+  assert.equal(toCSV([{ v: 'say "hi"' }], ['v']), 'v\n"say ""hi"""\n')
+})
+
+test('toCSV quotes fields containing CR and LF and keeps the raw line break', () => {
+  assert.equal(toCSV([{ v: 'a\nb' }], ['v']), 'v\n"a\nb"\n')
+  assert.equal(toCSV([{ v: 'a\rb' }], ['v']), 'v\n"a\rb"\n')
+})
+
+test('toCSV quotes a header containing a special character', () => {
+  assert.equal(toCSV([], ['a,b', 'c']), '"a,b",c\n')
+})
+
+test('toCSV leaves plain, numeric and empty values unquoted', () => {
+  assert.equal(toCSV([{ a: 'plain', b: 0, c: '' }], ['a', 'b', 'c']), 'a,b,c\nplain,0,\n')
+})
