--- a/src/money.js
+++ b/src/money.js
@@ -12,8 +12,22 @@ export function formatUSD(cents) {
   return `${sign}$${dollars}.${rest}`
 }
 
-// Applies a percentage discount (0 to 100) to an amount in cents.
+// Applies a percentage discount (0 to 100) to an amount in cents. The discounted amount,
+// cents x (100 - percent) / 100, is rounded half up to the nearest cent.
 export function applyDiscount(cents, percent) {
   if (!(percent >= 0 && percent <= 100)) throw new RangeError('percent must be between 0 and 100')
-  return Math.floor((cents * (100 - percent)) / 100)
+  // Integer arithmetic, because floating point can land just below a half cent:
+  // 1375 x (100 - 8.4) / 100 is 1259.4999999999998, not 1259.5.
+  const { units, scale } = toFraction(percent)
+  const divisor = 100n * scale
+  const kept = BigInt(Math.abs(cents)) * (divisor - units)
+  const rounded = Number((2n * kept + divisor) / (2n * divisor))
+  return cents < 0 ? -rounded : rounded
+}
+
+// Returns integers with units / scale equal to the shortest decimal form of n, so 8.4 is
+// 84 / 10 rather than the binary value nearest to 8.4.
+function toFraction(n) {
+  const [, digits, decimals = '', exponent = '0'] = String(n).match(/^(\d+)(?:\.(\d+))?(?:e([-+]\d+))?$/)
+  return { units: BigInt(digits + decimals), scale: 10n ** BigInt(decimals.length - Number(exponent)) }
 }
