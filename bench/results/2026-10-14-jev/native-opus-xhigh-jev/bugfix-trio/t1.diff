 })
+
+test('invoice rounds the discounted total half up to the nearest cent', () => {
+  const ledger = new Ledger({ discounts: { acme: 15 } })
+  // 5,005,000 input tokens at $2 per million is $10.01.
+  ledger.record({ key: 'acme', model: 'claude-sonnet-5', usage: { inputTokens: 5_005_000 }, at: 1 })
+  const invoice = ledger.invoice('acme')
+  assert.equal(invoice.subtotalCents, 1_001)
+  assert.equal(invoice.totalCents, 851)
+})
diff --git a/test/money.test.js b/test/money.test.js
index 917bae5..c33015b 100644
--- a/test/money.test.js
+++ b/test/money.test.js
@@ -22,3 +22,17 @@ test('applyDiscount', () => {
   assert.throws(() => applyDiscount(1_000, 101), RangeError)
   assert.throws(() => applyDiscount(1_000, -1), RangeError)
 })
+
+test('applyDiscount rounds the discounted total half up to the nearest cent', () => {
+  assert.equal(applyDiscount(1_001, 15), 851) // 850.85
+  assert.equal(applyDiscount(10, 15), 9) // 8.5
+  assert.equal(applyDiscount(5, 50), 3) // 2.5
+  assert.equal(applyDiscount(1_003, 15), 853) // 852.55
+  assert.equal(applyDiscount(1_002, 15), 852) // 851.7
+  assert.equal(applyDiscount(1_004, 15), 853) // 853.4
+  // Fractional percents: in floating point 1375 x (100 - 8.4) / 100 is 1259.4999999999998.
+  assert.equal(applyDiscount(1_375, 8.4), 1_260) // 1259.5
+  assert.equal(applyDiscount(2_625, 0.4), 2_615) // 2614.5
+  assert.equal(applyDiscount(1_000, 12.5), 875)
+  assert.equal(applyDiscount(30_000_000, 0.0000001), 30_000_000) // 29999999.97
+})
