+++ b/src/csv.js
@@ -1,13 +1,15 @@
 // Renders rows as CSV with a header line. Lines end with \n.
 export function toCSV(rows, columns) {
-  const lines = [columns.join(',')]
+  const lines = [columns.map(cell).join(',')]
   for (const row of rows) {
     lines.push(columns.map((column) => cell(row[column])).join(','))
   }
   return lines.join('\n') + '\n'
 }
 
+// Quotes a field as RFC 4180 describes, only when it contains a comma, a double quote or a line break.
 function cell(value) {
   if (value === null || value === undefined) return ''
-  return String(value)
+  const text = String(value)
+  return /[",\r\n]/.test(text) ? `"${text.replaceAll('"', '""')}"` : text
 }
