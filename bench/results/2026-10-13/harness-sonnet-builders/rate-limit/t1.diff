diff --git a/test/rate-limit.test.js b/test/rate-limit.test.js
new file mode 100644
index 0000000..adb7939
--- /dev/null
+++ b/test/rate-limit.test.js
@@ -0,0 +1,222 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createServer } from '../src/server.js'
+import { createRateLimiter } from '../src/rate-limit.js'
+import { Ledger } from '../src/ledger.js'
+
+async function start(options = {}) {
+  const server = createServer({ ledger: new Ledger(), now: () => 1_000, ...options })
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const base = `http://127.0.0.1:${server.address().port}`
+  const close = () => new Promise((resolve) => { server.closeAllConnections(); server.close(resolve) })
+  return { base, close }
+}
+
+const get = (base, path, key = 'acme') => fetch(`${base}${path}`, { headers: key ? { 'x-api-key': key } : {} })
+
+test('limiter: allows up to limit then rejects, remaining clamps at 0', () => {
+  let t = 0
+  const rl = createRateLimiter({ limit: 2, windowMs: 10_000, now: () => t })
+  assert.deepEqual(rl.hit('a'), { allowed: true, limit: 2, remaining: 1, retryAfter: 10 })
+  assert.equal(rl.hit('a').remaining, 0)
+  for (let i = 0; i < 3; i++) {
+    const r = rl.hit('a')
+    assert.equal(r.allowed, false)
+    assert.equal(r.remaining, 0)
+  }
+})
+
+test('limiter: defaults to 60 per 60s', () => {
+  const rl = createRateLimiter({ now: () => 0 })
+  let r
+  for (let i = 0; i < 60; i++) r = rl.hit('a')
+  assert.equal(r.allowed, true)
+  assert.equal(r.limit, 60)
+  assert.equal(r.remaining, 0)
+  r = rl.hit('a')
+  assert.equal(r.allowed, false)
+  assert.equal(r.retryAfter, 60)
+})
+
+test('limiter: retryAfter rounds up and is at least 1', () => {
+  let t = 0
+  const rl = createRateLimiter({ limit: 1, windowMs: 10_000, now: () => t })
+  rl.hit('a')
+  t = 2_500
+  assert.equal(rl.hit('a').retryAfter, 8)
+  t = 9_999
+  assert.equal(rl.hit('a').retryAfter, 1)
+})
+
+test('limiter: window resets exactly at windowStart + windowMs', () => {
+  let t = 5_000
+  const rl = createRateLimiter({ limit: 1, windowMs: 10_000, now: () => t })
+  assert.equal(rl.hit('a').allowed, true)
+  t = 14_999
+  assert.equal(rl.hit('a').allowed, false)
+  t = 15_000
+  assert.equal(rl.hit('a').allowed, true)
+})
+
+test('limiter: new window starts at the request time, not the old boundary', () => {
+  let t = 0
+  const rl = createRateLimiter({ limit: 1, windowMs: 10_000, now: () => t })
+  rl.hit('a')
+  t = 14_000
+  assert.equal(rl.hit('a').allowed, true)
+  t = 23_999
+  assert.equal(rl.hit('a').allowed, false)
+  t = 24_000
+  assert.equal(rl.hit('a').allowed, true)
+})
+
+test('limiter: keys are independent', () => {
+  const rl = createRateLimiter({ limit: 1, windowMs: 10_000, now: () => 0 })
+  assert.equal(rl.hit('a').allowed, true)
+  assert.equal(rl.hit('a').allowed, false)
+  assert.equal(rl.hit('b').allowed, true)
+})
+
+test('server: default limit is 60, 61st is 429', async () => {
+  const { base, close } = await start()
+  for (let i = 1; i <= 60; i++) {
+    const res = await get(base, '/docs/api.md')
+    assert.equal(res.status, 200)
+    assert.equal(res.headers.get('x-ratelimit-limit'), '60')
+    assert.equal(res.headers.get('x-ratelimit-remaining'), String(60 - i))
+  }
+  const res = await get(base, '/docs/api.md')
+  assert.equal(res.status, 429)
+  assert.equal(res.headers.get('x-ratelimit-remaining'), '0')
+  await close()
+})
+
+test('server: partial rateLimit merges over defaults', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 5 } })
+  const res = await get(base, '/docs/api.md')
+  assert.equal(res.headers.get('x-ratelimit-limit'), '5')
+  assert.equal(res.headers.get('x-ratelimit-remaining'), '4')
+  await close()
+})
+
+test('server: over-limit request gets 429 with Retry-After and body', async () => {
+  let t = 1_000
+  const { base, close } = await start({ now: () => t, rateLimit: { limit: 2, windowMs: 10_000 } })
+  const first = await get(base, '/docs/api.md')
+  assert.equal(first.status, 200)
+  assert.equal(first.headers.get('x-ratelimit-remaining'), '1')
+  const second = await get(base, '/docs/api.md')
+  assert.equal(second.status, 200)
+  assert.equal(second.headers.get('x-ratelimit-remaining'), '0')
+  t = 3_500
+  const res = await get(base, '/docs/api.md')
+  assert.equal(res.status, 429)
+  assert.match(res.headers.get('content-type'), /application\/json/)
+  assert.equal(res.headers.get('retry-after'), '8')
+  assert.equal(res.headers.get('x-ratelimit-limit'), '2')
+  assert.equal(res.headers.get('x-ratelimit-remaining'), '0')
+  assert.deepEqual(await res.json(), { error: 'rate_limited', retryAfter: 8 })
+  await close()
+})
+
+test('server: Retry-After is at least 1', async () => {
+  let t = 1_000
+  const { base, close } = await start({ now: () => t, rateLimit: { limit: 1, windowMs: 10_000 } })
+  await get(base, '/docs/api.md')
+  t = 10_999
+  const res = await get(base, '/docs/api.md')
+  assert.equal(res.status, 429)
+  assert.equal(res.headers.get('retry-after'), '1')
+  assert.deepEqual(await res.json(), { error: 'rate_limited', retryAfter: 1 })
+  await close()
+})
+
+test('server: window resets at the boundary and restarts at that time', async () => {
+  let t = 1_000
+  const { base, close } = await start({ now: () => t, rateLimit: { limit: 1, windowMs: 10_000 } })
+  assert.equal((await get(base, '/docs/api.md')).status, 200)
+  t = 10_999
+  assert.equal((await get(base, '/docs/api.md')).status, 429)
+  t = 11_000
+  const ok = await get(base, '/docs/api.md')
+  assert.equal(ok.status, 200)
+  assert.equal(ok.headers.get('x-ratelimit-remaining'), '0')
+  t = 12_000
+  const res = await get(base, '/docs/api.md')
+  assert.equal(res.status, 429)
+  assert.equal(res.headers.get('retry-after'), '9')
+  await close()
+})
+
+test('server: keys are independent', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1, windowMs: 10_000 } })
+  assert.equal((await get(base, '/docs/api.md', 'a')).status, 200)
+  assert.equal((await get(base, '/docs/api.md', 'a')).status, 429)
+  assert.equal((await get(base, '/docs/api.md', 'b')).status, 200)
+  await close()
+})
+
+test('server: requests without x-api-key share the anonymous bucket', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 2, windowMs: 10_000 } })
+  const post = () => fetch(`${base}/events`, { method: 'POST', body: '{}' })
+  const first = await post()
+  assert.equal(first.status, 401)
+  assert.equal(first.headers.get('x-ratelimit-remaining'), '1')
+  assert.equal((await post()).status, 401)
+  assert.equal((await post()).status, 429)
+  await close()
+})
+
+test('server: 404 and 403 responses are counted and carry headers', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 3, windowMs: 10_000 } })
+  const nf = await get(base, '/nope')
+  assert.equal(nf.status, 404)
+  assert.equal(nf.headers.get('x-ratelimit-limit'), '3')
+  assert.equal(nf.headers.get('x-ratelimit-remaining'), '2')
+  const forbidden = await fetch(`${base}/admin/keys`, { headers: { 'x-api-key': 'acme', 'x-admin-token': 'wrong' } })
+  assert.equal(forbidden.status, 403)
+  assert.equal(forbidden.headers.get('x-ratelimit-remaining'), '1')
+  await close()
+})
+
+test('server: remaining never goes below 0', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1, windowMs: 10_000 } })
+  await get(base, '/nope')
+  for (let i = 0; i < 4; i++) {
+    const res = await get(base, '/nope')
+    assert.equal(res.status, 429)
+    assert.equal(res.headers.get('x-ratelimit-remaining'), '0')
+  }
+  await close()
+})
+
+test('server: /health is exempt, uncounted and has no rate-limit headers', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 2, windowMs: 10_000 } })
+  for (let i = 0; i < 10; i++) {
+    const res = await get(base, '/health', null)
+    assert.equal(res.status, 200)
+    assert.equal(res.headers.get('x-ratelimit-limit'), null)
+    assert.equal(res.headers.get('x-ratelimit-remaining'), null)
+  }
+  const res = await get(base, '/nope', null)
+  assert.equal(res.headers.get('x-ratelimit-remaining'), '1')
+  await get(base, '/nope', null)
+  assert.equal((await get(base, '/nope', null)).status, 429)
+  assert.equal((await get(base, '/health', null)).status, 200)
+  await close()
+})
+
+test('server: CSV and docs responses carry the headers', async () => {
+  const ledger = new Ledger()
+  ledger.record({ key: 'acme', model: 'claude-sonnet-5', usage: { inputTokens: 1_000, outputTokens: 100 }, at: 1_000 })
+  const { base, close } = await start({ ledger, rateLimit: { limit: 5, windowMs: 10_000 } })
+  const csv = await get(base, '/invoices/acme?format=csv')
+  assert.match(csv.headers.get('content-type'), /text\/csv/)
+  assert.equal(csv.headers.get('x-ratelimit-limit'), '5')
+  assert.equal(csv.headers.get('x-ratelimit-remaining'), '4')
+  const doc = await get(base, '/docs/api.md')
+  assert.equal(doc.status, 200)
+  assert.equal(doc.headers.get('x-ratelimit-limit'), '5')
+  assert.equal(doc.headers.get('x-ratelimit-remaining'), '3')
+  await close()
+})

