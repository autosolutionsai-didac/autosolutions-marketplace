@@ -0,0 +1,22 @@
+// Fixed-window limiter, one window per key. Time comes from `now`.
+export function createRateLimiter({ limit = 60, windowMs = 60_000, now }) {
+  const state = new Map()
+
+  function hit(key) {
+    const t = now()
+    let entry = state.get(key)
+    if (!entry || t >= entry.windowStart + windowMs) {
+      entry = { windowStart: t, count: 0 }
+      state.set(key, entry)
+    }
+    entry.count++
+    return {
+      allowed: entry.count <= limit,
+      limit,
+      remaining: Math.max(0, limit - entry.count),
+      retryAfter: Math.max(1, Math.ceil((entry.windowStart + windowMs - t) / 1000)),
+    }
+  }
+
+  return { hit }
+}
