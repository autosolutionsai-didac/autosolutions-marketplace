diff --git a/test/csv-export.test.js b/test/csv-export.test.js
new file mode 100644
index 0000000..676f2cb
--- /dev/null
+++ b/test/csv-export.test.js
@@ -0,0 +1,32 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createServer } from '../src/server.js'
+import { Ledger } from '../src/ledger.js'
+
+async function start(options = {}) {
+  const server = createServer({ ledger: new Ledger(), now: () => 1_000, ...options })
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const base = `http://127.0.0.1:${server.address().port}`
+  const close = () => new Promise((resolve) => { server.closeAllConnections(); server.close(resolve) })
+  return { base, close }
+}
+
+test('CSV invoice export quotes a key containing a comma', async () => {
+  const { base, close } = await start()
+  try {
+    const posted = await fetch(`${base}/events`, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json', 'x-api-key': 'team, alpha' },
+      body: JSON.stringify({ model: 'claude-sonnet-5', usage: { inputTokens: 1_000_000, outputTokens: 100_000 } }),
+    })
+    assert.equal(posted.status, 201)
+    const res = await fetch(`${base}/invoices/team%2C%20alpha?format=csv`)
+    assert.equal(res.status, 200)
+    assert.equal(
+      await res.text(),
+      'key,model,requests,inputTokens,outputTokens,cacheReadTokens,cacheWriteTokens,costMicro\n"team, alpha",claude-sonnet-5,1,1000000,100000,0,0,3000000\n',
+    )
+  } finally {
+    await close()
+  }
+})
diff --git a/test/csv.test.js b/test/csv.test.js
index 9603268..999cb96 100644
--- a/test/csv.test.js
+++ b/test/csv.test.js
@@ -13,3 +13,24 @@ test('toCSV renders a header and one line per row', () => {
 test('toCSV leaves missing values empty', () => {
   assert.equal(toCSV([{ a: null }], ['a', 'b']), 'a,b\n,\n')
 })
+
+test('toCSV quotes values containing a comma', () => {
+  assert.equal(toCSV([{ a: 'team, alpha' }], ['a']), 'a\n"team, alpha"\n')
+})
+
+test('toCSV doubles embedded double quotes', () => {
+  assert.equal(toCSV([{ a: 'say "hi"' }], ['a']), 'a\n"say ""hi"""\n')
+})
+
+test('toCSV quotes values containing LF or CR', () => {
+  assert.equal(toCSV([{ a: 'one\ntwo' }], ['a']), 'a\n"one\ntwo"\n')
+  assert.equal(toCSV([{ a: 'one\rtwo' }], ['a']), 'a\n"one\rtwo"\n')
+})
+
+test('toCSV quotes header columns too', () => {
+  assert.equal(toCSV([{ 'a,b': 1 }], ['a,b']), '"a,b"\n1\n')
+})
+
+test('toCSV leaves plain values and numbers unquoted', () => {
+  assert.equal(toCSV([{ a: 'plain', b: 42, c: undefined }], ['a', 'b', 'c']), 'a,b,c\nplain,42,\n')
+})
