+// Fixed-window rate limiter: each key gets `limit` hits per window, starting at its first hit.
+export function createRateLimiter({ limit, windowMs, now }) {
+  const windows = new Map()
+
+  return {
+    hit(key) {
+      const t = now()
+      let entry = windows.get(key)
+      if (!entry || t >= entry.windowStart + windowMs) {
+        entry = { windowStart: t, count: 0 }
+        windows.set(key, entry)
+      }
+      const allowed = entry.count < limit
+      if (allowed) entry.count++
+      return {
+        allowed,
+        limit,
+        remaining: Math.max(0, limit - entry.count),
+        retryAfter: Math.max(1, Math.ceil((entry.windowStart + windowMs - t) / 1000)),
+      }
+    },
+  }
+}
