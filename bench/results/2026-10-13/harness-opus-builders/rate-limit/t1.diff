+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createRateLimiter } from '../src/rate-limit.js'
+import { createServer } from '../src/server.js'
+import { Ledger } from '../src/ledger.js'
+
+let t = 0
+const now = () => t
+
+async function start(options = {}) {
+  const server = createServer({ ledger: new Ledger(), now, rateLimit: { limit: 2, windowMs: 10_000 }, ...options })
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const base = `http://127.0.0.1:${server.address().port}`
+  const close = () => new Promise((resolve) => { server.closeAllConnections(); server.close(resolve) })
+  return { base, close }
+}
+
+const event = { model: 'claude-sonnet-5', usage: { inputTokens: 1_000_000, outputTokens: 100_000 } }
+
+function get(base, path, key) {
+  return fetch(`${base}${path}`, { headers: key ? { 'x-api-key': key } : {} })
+}
+
+function post(base, key, body = event) {
+  const headers = { 'content-type': 'application/json' }
+  if (key) headers['x-api-key'] = key
+  return fetch(`${base}/events`, { method: 'POST', headers, body: JSON.stringify(body) })
+}
+
+function assertLimited(res, remaining, limit = '2') {
+  assert.equal(res.headers.get('x-ratelimit-limit'), limit)
+  assert.equal(res.headers.get('x-ratelimit-remaining'), remaining)
+}
+
+test('limiter allows limit hits per window and counts down remaining', () => {
+  t = 0
+  const limiter = createRateLimiter({ limit: 3, windowMs: 10_000, now })
+  assert.deepEqual(limiter.hit('a'), { allowed: true, limit: 3, remaining: 2, retryAfter: 10 })
+  assert.equal(limiter.hit('a').remaining, 1)
+  assert.equal(limiter.hit('a').remaining, 0)
+  assert.deepEqual(limiter.hit('a'), { allowed: false, limit: 3, remaining: 0, retryAfter: 10 })
+  assert.equal(limiter.hit('a').remaining, 0)
+})
+
+test('limiter retryAfter rounds up to whole seconds, minimum 1', () => {
+  t = 0
+  const limiter = createRateLimiter({ limit: 1, windowMs: 10_000, now })
+  limiter.hit('a')
+  t = 2_500
+  assert.equal(limiter.hit('a').retryAfter, 8)
+  t = 9_000
+  assert.equal(limiter.hit('a').retryAfter, 1)
+  t = 9_999
+  const res = limiter.hit('a')
+  assert.equal(res.allowed, false)
+  assert.equal(res.retryAfter, 1)
+})
+
+test('limiter starts a new window at the first hit after the window ends', () => {
+  t = 0
+  const limiter = createRateLimiter({ limit: 1, windowMs: 10_000, now })
+  limiter.hit('a')
+  t = 9_999
+  assert.equal(limiter.hit('a').allowed, false)
+  t = 10_000
+  assert.deepEqual(limiter.hit('a'), { allowed: true, limit: 1, remaining: 0, retryAfter: 10 })
+  t = 15_000
+  assert.equal(limiter.hit('a').retryAfter, 5)
+  t = 19_999
+  assert.equal(limiter.hit('a').allowed, false)
+  t = 20_000
+  assert.equal(limiter.hit('a').allowed, true)
+})
+
+test('limiter keeps keys independent', () => {
+  t = 0
+  const limiter = createRateLimiter({ limit: 1, windowMs: 10_000, now })
+  assert.equal(limiter.hit('a').allowed, true)
+  assert.equal(limiter.hit('a').allowed, false)
+  assert.equal(limiter.hit('b').allowed, true)
+  assert.equal(limiter.hit('b').allowed, false)
+})
+
+test('rate limit: allows limit requests then 429 with Retry-After', async () => {
+  t = 0
+  const { base, close } = await start()
+  try {
+    const first = await get(base, '/docs/api.md', 'acme')
+    assert.equal(first.status, 200)
+    assertLimited(first, '1')
+    const second = await get(base, '/docs/api.md', 'acme')
+    assert.equal(second.status, 200)
+    assertLimited(second, '0')
+    t = 2_500
+    const third = await get(base, '/docs/api.md', 'acme')
+    assert.equal(third.status, 429)
+    assertLimited(third, '0')
+    assert.equal(third.headers.get('retry-after'), '8')
+    assert.deepEqual(await third.json(), { error: 'rate_limited', retryAfter: 8 })
+    t = 9_999
+    const fourth = await get(base, '/docs/api.md', 'acme')
+    assert.equal(fourth.status, 429)
+    assert.equal(fourth.headers.get('retry-after'), '1')
+    assert.deepEqual(await fourth.json(), { error: 'rate_limited', retryAfter: 1 })
+  } finally {
+    await close()
+  }
+})
+
+test('rate limit: window resets at windowStart + windowMs and restarts from that moment', async () => {
+  t = 0
+  const { base, close } = await start()
+  try {
+    await get(base, '/docs/api.md', 'acme')
+    await get(base, '/docs/api.md', 'acme')
+    assert.equal((await get(base, '/docs/api.md', 'acme')).status, 429)
+    t = 10_000
+    const reset = await get(base, '/docs/api.md', 'acme')
+    assert.equal(reset.status, 200)
+    assertLimited(reset, '1')
+    await get(base, '/docs/api.md', 'acme')
+    t = 15_000
+    const rejected = await get(base, '/docs/api.md', 'acme')
+    assert.equal(rejected.status, 429)
+    assert.equal(rejected.headers.get('retry-after'), '5')
+    t = 20_000
+    assert.equal((await get(base, '/docs/api.md', 'acme')).status, 200)
+  } finally {
+    await close()
+  }
+})
+
+test('rate limit: keys are independent and keyless requests share anonymous', async () => {
+  t = 0
+  const { base, close } = await start()
+  try {
+    await get(base, '/docs/api.md', 'a')
+    await get(base, '/docs/api.md', 'a')
+    assert.equal((await get(base, '/docs/api.md', 'a')).status, 429)
+    const b = await get(base, '/docs/api.md', 'b')
+    assert.equal(b.status, 200)
+    assertLimited(b, '1')
+
+    const anon1 = await get(base, '/docs/api.md')
+    assertLimited(anon1, '1')
+    const anon2 = await get(base, '/nope')
+    assert.equal(anon2.status, 404)
+    assertLimited(anon2, '0')
+    assert.equal((await get(base, '/docs/api.md')).status, 429)
+  } finally {
+    await close()
+  }
+})
+
+test('rate limit: runs before auth and routing', async () => {
+  t = 0
+  const saved = process.env.LEDGER_ADMIN_TOKEN
+  process.env.LEDGER_ADMIN_TOKEN = 'secret'
+  const { base, close } = await start()
+  try {
+    const unauth = await post(base, null)
+    assert.equal(unauth.status, 401)
+    assertLimited(unauth, '1')
+    const notFound = await get(base, '/nope')
+    assert.equal(notFound.status, 404)
+    assertLimited(notFound, '0')
+    assert.equal((await post(base, null)).status, 429)
+    assert.equal((await get(base, '/nope')).status, 429)
+
+    const forbidden = await get(base, '/admin/keys', 'admin-probe')
+    assert.equal(forbidden.status, 403)
+    assertLimited(forbidden, '1')
+  } finally {
+    await close()
+    if (saved === undefined) delete process.env.LEDGER_ADMIN_TOKEN
+    else process.env.LEDGER_ADMIN_TOKEN = saved
+  }
+})
+
+test('rate limit: headers on 201, 400, CSV and docs responses', async () => {
+  t = 0
+  const { base, close } = await start({ rateLimit: { limit: 10, windowMs: 10_000 } })
+  try {
+    const created = await post(base, 'acme')
+    assert.equal(created.status, 201)
+    assertLimited(created, '9', '10')
+    const invalid = await post(base, 'acme', { model: 'nope', usage: {} })
+    assert.equal(invalid.status, 400)
+    assertLimited(invalid, '8', '10')
+    const csv = await get(base, '/invoices/acme?format=csv', 'acme')
+    assert.equal(csv.status, 200)
+    assert.match(csv.headers.get('content-type'), /text\/csv/)
+    assertLimited(csv, '7', '10')
+    const docs = await get(base, '/docs/api.md', 'acme')
+    assert.equal(docs.status, 200)
+    assertLimited(docs, '6', '10')
+  } finally {
+    await close()
+  }
+})
+
+test('rate limit: GET /health is exempt, uncounted and has no rate-limit headers', async () => {
+  t = 0
+  const { base, close } = await start()
+  try {
+    for (let i = 0; i < 5; i++) {
+      const res = await get(base, '/health')
+      assert.equal(res.status, 200)
+      assert.equal(res.headers.get('x-ratelimit-limit'), null)
+      assert.equal(res.headers.get('x-ratelimit-remaining'), null)
+      assert.equal(res.headers.get('retry-after'), null)
+    }
+    assertLimited(await get(base, '/nope'), '1')
+    await get(base, '/nope')
+    assert.equal((await get(base, '/nope')).status, 429)
+    const health = await get(base, '/health?x=1')
+    assert.equal(health.status, 200)
+    assert.deepEqual(await health.json(), { ok: true })
+    assert.equal(health.headers.get('x-ratelimit-limit'), null)
+    assert.equal(health.headers.get('x-ratelimit-remaining'), null)
+    assert.equal(health.headers.get('retry-after'), null)
+    assert.equal((await fetch(`${base}/health`, { method: 'POST' })).status, 429)
+  } finally {
+    await close()
+  }
+})
+
+test('rate limit: defaults to 60 per 60s and merges partial options', async () => {
+  t = 0
+  const defaults = createServer({ ledger: new Ledger(), now })
+  await new Promise((resolve) => defaults.listen(0, '127.0.0.1', resolve))
+  try {
+    const res = await fetch(`http://127.0.0.1:${defaults.address().port}/nope`)
+    assert.equal(res.headers.get('x-ratelimit-limit'), '60')
+    assert.equal(res.headers.get('x-ratelimit-remaining'), '59')
+  } finally {
+    await new Promise((resolve) => { defaults.closeAllConnections(); defaults.close(resolve) })
+  }
+
+  const { base, close } = await start({ rateLimit: { limit: 1 } })
