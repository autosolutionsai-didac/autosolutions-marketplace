@@ -0,0 +1,361 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createRateLimiter, DEFAULT_RATE_LIMIT } from '../src/rate-limit.js'
+import { createServer } from '../src/server.js'
+import { Ledger } from '../src/ledger.js'
+
+// Local copy of the start() helper from server.test.js, with a mutable clock.
+async function start(options = {}) {
+  const clock = { t: 1_000 }
+  const server = createServer({ ledger: new Ledger(), now: () => clock.t, ...options })
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const base = `http://127.0.0.1:${server.address().port}`
+  const close = () => new Promise((resolve) => { server.closeAllConnections(); server.close(resolve) })
+  return { base, close, clock }
+}
+
+const event = { model: 'claude-sonnet-5', usage: { inputTokens: 1_000_000, outputTokens: 100_000 } }
+
+function get(base, path, key) {
+  return fetch(`${base}${path}`, { headers: key ? { 'x-api-key': key } : {} })
+}
+
+function post(base, key, body = event) {
+  const headers = { 'content-type': 'application/json' }
+  if (key) headers['x-api-key'] = key
+  return fetch(`${base}/events`, { method: 'POST', headers, body: JSON.stringify(body) })
+}
+
+async function drain(res) {
+  await res.arrayBuffer()
+  return res
+}
+
+test('DEFAULT_RATE_LIMIT is 60 per minute', () => {
+  assert.deepEqual(DEFAULT_RATE_LIMIT, { limit: 60, windowMs: 60_000 })
+})
+
+test('limiter allows `limit` hits per window and counts remaining down to 0', () => {
+  let t = 0
+  const limiter = createRateLimiter({ limit: 3, windowMs: 10_000, now: () => t })
+  assert.deepEqual(limiter.hit('a'), { allowed: true, limit: 3, remaining: 2, retryAfter: 10 })
+  assert.deepEqual(limiter.hit('a'), { allowed: true, limit: 3, remaining: 1, retryAfter: 10 })
+  assert.deepEqual(limiter.hit('a'), { allowed: true, limit: 3, remaining: 0, retryAfter: 10 })
+  t = 2_500
+  assert.deepEqual(limiter.hit('a'), { allowed: false, limit: 3, remaining: 0, retryAfter: 8 })
+  assert.deepEqual(limiter.hit('a'), { allowed: false, limit: 3, remaining: 0, retryAfter: 8 })
+})
+
+test('limiter retryAfter rounds up and is at least 1', () => {
+  let t = 0
+  const a = createRateLimiter({ limit: 1, windowMs: 60_000, now: () => t })
+  a.hit('k')
+  t = 1_500
+  assert.equal(a.hit('k').retryAfter, 59)
+
+  t = 0
+  const b = createRateLimiter({ limit: 1, windowMs: 1_500, now: () => t })
+  b.hit('k')
+  t = 1_499
+  const r = b.hit('k')
+  assert.equal(r.allowed, false)
+  assert.equal(r.retryAfter, 1)
+})
+
+test('limiter window resets exactly at windowStart + windowMs and starts then', () => {
+  let t = 5_000
+  const limiter = createRateLimiter({ limit: 2, windowMs: 1_000, now: () => t })
+  limiter.hit('k')
+  t = 5_400
+  limiter.hit('k')
+  t = 5_999
+  assert.equal(limiter.hit('k').allowed, false)
+  t = 6_000
+  assert.deepEqual(limiter.hit('k'), { allowed: true, limit: 2, remaining: 1, retryAfter: 1 })
+  t = 6_500
+  assert.equal(limiter.hit('k').allowed, true)
+  t = 6_999
+  assert.equal(limiter.hit('k').allowed, false)
+  t = 7_000
+  assert.equal(limiter.hit('k').allowed, true)
+})
+
+test('limiter window starts at the first request after expiry, not on a grid', () => {
+  let t = 0
+  const limiter = createRateLimiter({ limit: 1, windowMs: 1_000, now: () => t })
+  limiter.hit('k')
+  t = 1_700
+  assert.equal(limiter.hit('k').allowed, true)
+  t = 2_500
+  const r = limiter.hit('k')
+  assert.equal(r.allowed, false)
+  assert.equal(r.retryAfter, 1)
+  t = 2_700
+  assert.equal(limiter.hit('k').allowed, true)
+})
+
+test('limiter keys are independent', () => {
+  let t = 0
+  const limiter = createRateLimiter({ limit: 1, windowMs: 1_000, now: () => t })
+  assert.equal(limiter.hit('a').allowed, true)
+  assert.equal(limiter.hit('a').allowed, false)
+  t = 500
+  assert.equal(limiter.hit('b').allowed, true)
+  assert.equal(limiter.hit('b').allowed, false)
+  t = 1_000
+  assert.equal(limiter.hit('a').allowed, true)
+  assert.equal(limiter.hit('b').allowed, false)
+})
+
+test('limiter calls now() exactly once per hit', () => {
+  let calls = 0
+  const limiter = createRateLimiter({ limit: 1, windowMs: 1_000, now: () => { calls++; return 0 } })
+  limiter.hit('a')
+  limiter.hit('a')
+  limiter.hit('b')
+  assert.equal(calls, 3)
+})
+
+test('server: default limit is 60, the 61st request gets 429', async () => {
+  const { base, close } = await start()
+  try {
+    for (let i = 1; i <= 60; i++) {
+      const res = await drain(await get(base, '/docs/api.md', 'acme'))
+      assert.equal(res.status, 200)
+      assert.equal(res.headers.get('x-ratelimit-limit'), '60')
+      assert.equal(res.headers.get('x-ratelimit-remaining'), String(60 - i))
+    }
+    const res = await get(base, '/docs/api.md', 'acme')
+    assert.equal(res.status, 429)
+    assert.equal(res.headers.get('x-ratelimit-remaining'), '0')
+    assert.equal(res.headers.get('retry-after'), '60')
+    assert.deepEqual(await res.json(), { error: 'rate_limited', retryAfter: 60 })
+  } finally {
+    await close()
+  }
+})
+
+test('server: limit and windowMs overrides, remaining never negative, 429 body', async () => {
+  const { base, close, clock } = await start({ rateLimit: { limit: 2, windowMs: 10_000 } })
+  try {
+    let res = await drain(await get(base, '/docs/api.md', 'acme'))
+    assert.equal(res.headers.get('x-ratelimit-limit'), '2')
+    assert.equal(res.headers.get('x-ratelimit-remaining'), '1')
+    res = await drain(await get(base, '/docs/api.md', 'acme'))
+    assert.equal(res.headers.get('x-ratelimit-remaining'), '0')
+    clock.t += 3_200
+    for (let i = 0; i < 3; i++) {
+      res = await get(base, '/docs/api.md', 'acme')
+      assert.equal(res.status, 429)
+      assert.equal(res.headers.get('content-type'), 'application/json')
+      assert.equal(res.headers.get('x-ratelimit-limit'), '2')
+      assert.equal(res.headers.get('x-ratelimit-remaining'), '0')
+      assert.equal(res.headers.get('retry-after'), '7')
+      assert.equal(await res.text(), '{"error":"rate_limited","retryAfter":7}')
+    }
+  } finally {
+    await close()
+  }
+})
+
+test('server: partial override keeps the other default', async () => {
+  const { base, close, clock } = await start({ rateLimit: { limit: 1 } })
+  try {
+    await drain(await get(base, '/docs/api.md', 'a'))
+    clock.t += 59_999
+    const res = await get(base, '/docs/api.md', 'a')
+    assert.equal(res.status, 429)
+    assert.equal(res.headers.get('retry-after'), '1')
+    await drain(res)
+    clock.t += 1
+    assert.equal((await drain(await get(base, '/docs/api.md', 'a'))).status, 200)
+  } finally {
+    await close()
+  }
+})
+
+test('server: Retry-After rounds up', async () => {
+  const a = await start({ rateLimit: { limit: 1, windowMs: 60_000 } })
+  try {
+    await drain(await get(a.base, '/docs/api.md', 'x'))
+    a.clock.t += 1_500
+    const res = await get(a.base, '/docs/api.md', 'x')
+    assert.equal(res.headers.get('retry-after'), '59')
+    assert.deepEqual(await res.json(), { error: 'rate_limited', retryAfter: 59 })
+  } finally {
+    await a.close()
+  }
+
+  const b = await start({ rateLimit: { limit: 1, windowMs: 1_500 } })
+  try {
+    await drain(await get(b.base, '/docs/api.md', 'x'))
+    b.clock.t += 1_499
+    const res = await get(b.base, '/docs/api.md', 'x')
+    assert.equal(res.headers.get('retry-after'), '1')
+    assert.deepEqual(await res.json(), { error: 'rate_limited', retryAfter: 1 })
+  } finally {
+    await b.close()
+  }
+})
+
+test('server: window resets exactly at windowStart + windowMs', async () => {
+  const { base, close, clock } = await start({ rateLimit: { limit: 2, windowMs: 1_000 } })
+  try {
+    await drain(await get(base, '/docs/api.md', 'k'))
+    clock.t += 500
+    await drain(await get(base, '/docs/api.md', 'k'))
+    clock.t += 499
+    assert.equal((await drain(await get(base, '/docs/api.md', 'k'))).status, 429)
+    clock.t += 1 // exactly windowStart + windowMs
+    let res = await drain(await get(base, '/docs/api.md', 'k'))
+    assert.equal(res.status, 200)
+    assert.equal(res.headers.get('x-ratelimit-remaining'), '1')
+    // The new window started at this moment, so it lasts a full windowMs from here.
+    clock.t += 999
+    res = await drain(await get(base, '/docs/api.md', 'k'))
+    assert.equal(res.status, 200)
+    assert.equal(res.headers.get('x-ratelimit-remaining'), '0')
+    res = await get(base, '/docs/api.md', 'k')
+    assert.equal(res.status, 429)
+    assert.equal(res.headers.get('retry-after'), '1')
+    await drain(res)
+    clock.t += 1
+    assert.equal((await drain(await get(base, '/docs/api.md', 'k'))).status, 200)
+  } finally {
+    await close()
+  }
+})
+
+test('server: separate keys are independent, missing key shares anonymous', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1 } })
+  try {
+    assert.equal((await drain(await get(base, '/docs/api.md', 'a'))).status, 200)
+    assert.equal((await drain(await get(base, '/docs/api.md', 'a'))).status, 429)
+    assert.equal((await drain(await get(base, '/docs/api.md', 'b'))).status, 200)
+    assert.equal((await drain(await get(base, '/docs/api.md'))).status, 200)
+    assert.equal((await drain(await get(base, '/docs/api.md'))).status, 429)
+    assert.equal((await drain(await post(base, null))).status, 429)
+    // An empty header also counts as anonymous.
+    const res = await drain(await fetch(`${base}/docs/api.md`, { headers: { 'x-api-key': '' } }))
+    assert.equal(res.status, 429)
+  } finally {
+    await close()
+  }
+})
+
+test('server: 401, 403 and 404 responses are counted, limited and carry headers', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 3 } })
+  try {
+    let res = await drain(await post(base, null))
+    assert.equal(res.status, 401)
+    assert.equal(res.headers.get('x-ratelimit-limit'), '3')
+    assert.equal(res.headers.get('x-ratelimit-remaining'), '2')
+    res = await drain(await get(base, '/nope'))
+    assert.equal(res.status, 404)
+    assert.equal(res.headers.get('x-ratelimit-remaining'), '1')
+    res = await drain(await fetch(`${base}/admin/keys`, { headers: { 'x-admin-token': 'wrong' } }))
+    assert.equal(res.status, 403)
+    assert.equal(res.headers.get('x-ratelimit-remaining'), '0')
+    res = await drain(await post(base, null))
+    assert.equal(res.status, 429)
+    assert.equal(res.headers.get('x-ratelimit-remaining'), '0')
+    // POST /health is not exempt: it is limited like any other request.
+    res = await drain(await fetch(`${base}/health`, { method: 'POST' }))
+    assert.equal(res.status, 429)
+  } finally {
+    await close()
+  }
+})
+
