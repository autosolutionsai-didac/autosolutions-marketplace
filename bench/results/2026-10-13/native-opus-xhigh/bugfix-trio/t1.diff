--- a/src/csv.js
+++ b/src/csv.js
@@ -1,13 +1,16 @@
-// Renders rows as CSV with a header line. Lines end with \n.
+// Renders rows as CSV with a header line. Lines end with \n. Fields are quoted as in RFC 4180.
 export function toCSV(rows, columns) {
-  const lines = [columns.join(',')]
+  const lines = [columns.map(cell).join(',')]
   for (const row of rows) {
     lines.push(columns.map((column) => cell(row[column])).join(','))
   }
   return lines.join('\n') + '\n'
 }
 
+// Quotes a field only when it contains a comma, a double quote, a CR or an LF, and doubles the
+// double quotes inside it.
 function cell(value) {
   if (value === null || value === undefined) return ''
-  return String(value)
+  const text = String(value)
+  return /[",\r\n]/.test(text) ? `"${text.replaceAll('"', '""')}"` : text
 }
diff --git a/src/money.js b/src/money.js
index 95a7ad7..d060472 100644
--- a/src/money.js
+++ b/src/money.js
@@ -12,8 +12,28 @@ export function formatUSD(cents) {
   return `${sign}$${dollars}.${rest}`
 }
 
-// Applies a percentage discount (0 to 100) to an amount in cents.
+// Applies a percentage discount (0 to 100) to an amount in cents: cents x (100 - percent) / 100,
+// rounded half up to the nearest cent. The math is done on exact integers, because floating point
+// turns some halves into x.4999... (1,250 cents with 0.04% off is 1,249.5 cents, so 1,250).
 export function applyDiscount(cents, percent) {
   if (!(percent >= 0 && percent <= 100)) throw new RangeError('percent must be between 0 and 100')
-  return Math.floor((cents * (100 - percent)) / 100)
+  const { units, scale } = toFraction(percent)
+  const numerator = BigInt(cents) * (100n * scale - units)
+  const denominator = 100n * scale
+  // Half up is floor(n / d + 1/2) = floor((2n + d) / 2d).
+  return Number(floorDiv(2n * numerator + denominator, 2n * denominator))
+}
+
+// A number as units / scale, read from its shortest decimal form: 12.5 is 125 / 10, 1e-7 is
+// 1 / 10_000_000. Only for numbers below 1e21, which String() never writes with a positive exponent.
+function toFraction(x) {
+  const [mantissa, exponent = '0'] = String(x).split('e')
+  const [whole, fraction = ''] = mantissa.split('.')
+  return { units: BigInt(whole + fraction), scale: 10n ** BigInt(fraction.length - Number(exponent)) }
+}
+
+// BigInt division truncates towards zero; this rounds down. d must be positive.
+function floorDiv(n, d) {
+  const q = n / d
+  return n % d < 0n ? q - 1n : q
 }
