 })
+
+test('invoice rounds the discounted total half up', () => {
+  const ledger = new Ledger({ discounts: { acme: 15 } })
+  // claude-sonnet-5 input is $2 per million tokens: 5,005,000 tokens = $10.01
+  ledger.record({ key: 'acme', model: 'claude-sonnet-5', usage: { inputTokens: 5_005_000 }, at: 1 })
+  const invoice = ledger.invoice('acme')
+  assert.equal(invoice.subtotalCents, 1_001)
+  assert.equal(invoice.totalCents, 851)
+})
diff --git a/test/money.test.js b/test/money.test.js
index 917bae5..dc90054 100644
--- a/test/money.test.js
+++ b/test/money.test.js
@@ -22,3 +22,12 @@ test('applyDiscount', () => {
   assert.throws(() => applyDiscount(1_000, 101), RangeError)
   assert.throws(() => applyDiscount(1_000, -1), RangeError)
 })
+
+test('applyDiscount rounds the discounted amount half up to the nearest cent', () => {
+  assert.equal(applyDiscount(10, 15), 9) // 8.5 cents
+  assert.equal(applyDiscount(1_001, 15), 851) // 850.85 cents
+  assert.equal(applyDiscount(1_004, 15), 853) // 853.4 cents
+  // Exactly half a cent with a fractional percent: floating point gives 1,249.4999...
+  assert.equal(applyDiscount(1_250, 0.04), 1_250) // 1,249.5 cents
+  assert.equal(applyDiscount(2_500, 0.18), 2_496) // 2,495.5 cents
+})
