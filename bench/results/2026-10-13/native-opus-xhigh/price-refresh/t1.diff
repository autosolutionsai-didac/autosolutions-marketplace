+test('costOf prices one request on each Claude 5.5 model', () => {
+  // A 51,000-token prompt, under the 100,000-token threshold for claude-haiku-5-5.
+  const usage = { inputTokens: 3_000, outputTokens: 1_000, cacheReadTokens: 40_000, cacheWriteTokens: 8_000 }
+  // claude-haiku-5-5: 0.1, 0.5, 0.01, 0.125 USD per million tokens
+  assert.equal(costOf(usage, 'claude-haiku-5-5'), 300 + 500 + 400 + 1_000)
+  // claude-sonnet-5-5: 2, 10, 0.1, 2.5 USD per million tokens
+  assert.equal(costOf(usage, 'claude-sonnet-5-5'), 6_000 + 10_000 + 4_000 + 20_000)
+  // claude-opus-5-5: 4, 20, 0.2, 5 USD per million tokens
+  assert.equal(costOf(usage, 'claude-opus-5-5'), 12_000 + 20_000 + 8_000 + 40_000)
+})
+
