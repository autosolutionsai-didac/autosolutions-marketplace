+++ b/src/money.js
@@ -12,8 +12,37 @@ export function formatUSD(cents) {
   return `${sign}$${dollars}.${rest}`
 }
 
-// Applies a percentage discount (0 to 100) to an amount in cents.
+// Applies a percentage discount (0 to 100) to cents, rounding half up to the nearest cent.
+// Both arguments are coerced with Number(). cents should be integer cents; any finite
+// value is accepted and the exact product is rounded. Non-finite cents throw a RangeError.
 export function applyDiscount(cents, percent) {
   if (!(percent >= 0 && percent <= 100)) throw new RangeError('percent must be between 0 and 100')
-  return Math.floor((cents * (100 - percent)) / 100)
+  const c = Number(cents)
+  if (!Number.isFinite(c)) throw new RangeError('cents must be a finite number')
+  const p = decimalParts(Number(percent))
+  const a = decimalParts(c)
+  // cents * (100 - percent) / 100, with percent = p.digits / p.scale and cents = a.digits / a.scale
+  const hundred = 100n * p.scale
+  const num = a.digits * (hundred - p.digits)
+  const den = hundred * a.scale
+  return Number(floorDiv(2n * num + den, 2n * den))
+}
+
+// Returns {digits, scale} with value === digits / scale exactly, reading the shortest decimal form.
+function decimalParts(value) {
+  const [mantissa, exp = '0'] = String(value).split('e')
+  const [whole, frac = ''] = mantissa.split('.')
+  let places = frac.length - Number(exp)
+  let digits = BigInt(whole + frac)
+  if (places < 0) {
+    digits *= 10n ** BigInt(-places)
+    places = 0
+  }
+  return { digits, scale: 10n ** BigInt(places) }
+}
+
+// Floor division for BigInt with a positive divisor.
+function floorDiv(a, b) {
+  const q = a / b
+  return a % b !== 0n && a < 0n ? q - 1n : q
 }
