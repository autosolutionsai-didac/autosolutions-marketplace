diff --git a/test/invoice-csv.test.js b/test/invoice-csv.test.js
new file mode 100644
index 0000000..1030103
--- /dev/null
+++ b/test/invoice-csv.test.js
@@ -0,0 +1,74 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createServer } from '../src/server.js'
+import { Ledger } from '../src/ledger.js'
+
+async function start(options = {}) {
+  const server = createServer({ ledger: new Ledger(), now: () => 1_000, ...options })
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const base = `http://127.0.0.1:${server.address().port}`
+  const close = () => new Promise((resolve) => { server.closeAllConnections(); server.close(resolve) })
+  return { base, close }
+}
+
+const event = { model: 'claude-sonnet-5', usage: { inputTokens: 1_000_000, outputTokens: 100_000 } }
+
+function post(base, key, body = event) {
+  const headers = { 'content-type': 'application/json' }
+  if (key) headers['x-api-key'] = key
+  return fetch(`${base}/events`, { method: 'POST', headers, body: JSON.stringify(body) })
+}
+
+const HEADER = 'key,model,requests,inputTokens,outputTokens,cacheReadTokens,cacheWriteTokens,costMicro\n'
+
+// Splits one CSV line into fields using RFC 4180 rules.
+function parseLine(line) {
+  const fields = []
+  let i = 0
+  for (;;) {
+    let field = ''
+    if (line[i] === '"') {
+      for (i++; i < line.length; ) {
+        if (line[i] === '"' && line[i + 1] === '"') { field += '"'; i += 2 }
+        else if (line[i] === '"') { i++; break }
+        else field += line[i++]
+      }
+    } else {
+      while (i < line.length && line[i] !== ',') field += line[i++]
+    }
+    fields.push(field)
+    if (line[i] !== ',') break
+    i++
+  }
+  return fields
+}
+
+test('GET /invoices/:key CSV quotes a key containing a comma', async () => {
+  const { base, close } = await start()
+  try {
+    await post(base, 'team, alpha')
+    const res = await fetch(`${base}/invoices/${encodeURIComponent('team, alpha')}?format=csv`)
+    assert.equal(res.status, 200)
+    const body = await res.text()
+    assert.equal(body, HEADER + '"team, alpha",claude-sonnet-5,1,1000000,100000,0,0,3000000\n')
+    const [headerLine, dataLine] = body.trimEnd().split('\n')
+    assert.equal(parseLine(headerLine).length, 8)
+    const fields = parseLine(dataLine)
+    assert.equal(fields.length, 8)
+    assert.equal(fields[0], 'team, alpha')
+  } finally {
+    await close()
+  }
+})
+
+test('GET /invoices/:key CSV doubles quotes in a key', async () => {
+  const { base, close } = await start()
+  try {
+    await post(base, 'say "hi"')
+    const res = await fetch(`${base}/invoices/${encodeURIComponent('say "hi"')}?format=csv`)
+    assert.equal(res.status, 200)
+    assert.equal(await res.text(), HEADER + '"say ""hi""",claude-sonnet-5,1,1000000,100000,0,0,3000000\n')
+  } finally {
+    await close()
+  }
+})
diff --git a/test/money.test.js b/test/money.test.js
index 917bae5..23be5ae 100644
--- a/test/money.test.js
+++ b/test/money.test.js
@@ -22,3 +22,38 @@ test('applyDiscount', () => {
   assert.throws(() => applyDiscount(1_000, 101), RangeError)
   assert.throws(() => applyDiscount(1_000, -1), RangeError)
 })
+
+test('applyDiscount rounds half up to the nearest cent', () => {
+  assert.equal(applyDiscount(1_001, 15), 851)
+  assert.equal(applyDiscount(10, 15), 9)
+  assert.equal(applyDiscount(1, 50), 1)
+  assert.equal(applyDiscount(3, 50), 2)
+  assert.equal(applyDiscount(10, 25), 8)
+  assert.equal(applyDiscount(1, 60), 0)
+  assert.equal(applyDiscount(1, 40), 1)
+  assert.equal(applyDiscount(999, 15), 849)
+  assert.equal(applyDiscount(1, 50.5), 0)
+  assert.equal(applyDiscount(5, 0.1), 5)
+  assert.equal(applyDiscount(3, 12.5), 3)
+  assert.equal(applyDiscount(4, 12.5), 4)
+  assert.equal(applyDiscount(1_000, 33.3), 667)
+  assert.equal(applyDiscount(1, 1e-7), 1)
+  assert.equal(applyDiscount(0, 33.3), 0)
+  assert.equal(applyDiscount(7, 0), 7)
+  assert.equal(applyDiscount(7, 100), 0)
+  assert.equal(applyDiscount(Number.MAX_SAFE_INTEGER, 50), 4_503_599_627_370_496)
+  assert.equal(typeof applyDiscount(Number.MAX_SAFE_INTEGER, 50), 'number')
+  assert.throws(() => applyDiscount(1_000, NaN), RangeError)
+  assert.throws(() => applyDiscount(1_000, undefined), RangeError)
+})
+
+test('applyDiscount coerces inputs like the range check does', () => {
+  assert.equal(applyDiscount(1_000, true), 990)
+  assert.equal(applyDiscount(1_000, null), 1_000)
+  assert.equal(applyDiscount(1_000, '15'), 850)
+  assert.equal(applyDiscount(10.5, 10), 9)
+  assert.equal(applyDiscount(1.5, 0), 2)
+  assert.equal(applyDiscount(-1_001, 15), -851)
+  assert.throws(() => applyDiscount(Infinity, 10), { name: 'RangeError', message: 'cents must be a finite number' })
+  assert.throws(() => applyDiscount(NaN, 10), RangeError)
+})
