 // Renders rows as CSV with a header line. Lines end with \n.
 export function toCSV(rows, columns) {
-  const lines = [columns.join(',')]
+  const lines = [columns.map(cell).join(',')]
   for (const row of rows) {
     lines.push(columns.map((column) => cell(row[column])).join(','))
   }
   return lines.join('\n') + '\n'
 }
 
+// Quotes per RFC 4180 when the value contains a comma, quote, CR or LF.
 function cell(value) {
   if (value === null || value === undefined) return ''
-  return String(value)
+  const s = String(value)
+  if (/[",\r\n]/.test(s)) return '"' + s.replace(/"/g, '""') + '"'
+  return s
 }
diff --git a/src/money.js b/src/money.js
index 95a7ad7..56fa114 100644
--- a/src/money.js
+++ b/src/money.js
@@ -13,7 +13,28 @@ export function formatUSD(cents) {
 }
 
 // Applies a percentage discount (0 to 100) to an amount in cents.
+// The result is cents * (100 - percent) / 100 rounded half up to the nearest
+// integer cent. Negative cents round half away from zero. The percent is taken
+// as its exact decimal string (String(percent)) and the math is done in BigInt,
+// so binary floating point never changes a rounding decision.
 export function applyDiscount(cents, percent) {
   if (!(percent >= 0 && percent <= 100)) throw new RangeError('percent must be between 0 and 100')
-  return Math.floor((cents * (100 - percent)) / 100)
+  const { mantissa, scale } = decimalParts(percent)
+  const unit = 10n ** scale
+  const num = BigInt(Math.abs(cents)) * (100n * unit - mantissa)
+  const den = 100n * unit
+  const rounded = Number((2n * num + den) / (2n * den))
+  return cents < 0 ? 0 - rounded : rounded
+}
+
+// Splits a non-negative number's shortest string form into P and s, so that value = P / 10^s.
+function decimalParts(value) {
+  const match = /^(\d+)(?:\.(\d+))?(?:e([+-]\d+))?$/.exec(String(value))
+  const frac = match[2] ?? ''
+  const exp = Number(match[3] ?? 0) - frac.length
+  let mantissa = BigInt(match[1] + frac)
+  let scale = 0n
+  if (exp >= 0) mantissa *= 10n ** BigInt(exp)
+  else scale = BigInt(-exp)
+  return { mantissa, scale }
 }
