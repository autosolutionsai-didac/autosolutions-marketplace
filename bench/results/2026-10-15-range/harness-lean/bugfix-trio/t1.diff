diff --git a/test/csv.test.js b/test/csv.test.js
index 9603268..564633b 100644
--- a/test/csv.test.js
+++ b/test/csv.test.js
@@ -13,3 +13,28 @@ test('toCSV renders a header and one line per row', () => {
 test('toCSV leaves missing values empty', () => {
   assert.equal(toCSV([{ a: null }], ['a', 'b']), 'a,b\n,\n')
 })
+
+test('toCSV quotes fields containing a comma', () => {
+  assert.equal(toCSV([{ key: 'team, alpha', n: 1 }], ['key', 'n']), 'key,n\n"team, alpha",1\n')
+})
+
+test('toCSV doubles double quotes inside quoted fields', () => {
+  assert.equal(toCSV([{ a: 'say "hi"' }, { a: '"' }], ['a']), 'a\n"say ""hi"""\n""""\n')
+})
+
+test('toCSV quotes fields containing line breaks verbatim', () => {
+  assert.equal(toCSV([{ a: 'a\nb' }, { a: 'a\rb' }, { a: 'a\r\nb' }], ['a']), 'a\n"a\nb"\n"a\rb"\n"a\r\nb"\n')
+})
+
+test('toCSV quotes once and doubles every inner quote when several special characters appear', () => {
+  assert.equal(toCSV([{ a: 'a,"b"\nc' }], ['a']), 'a\n"a,""b""\nc"\n')
+})
+
+test('toCSV leaves plain, numeric, empty, padded and tab values unquoted', () => {
+  const rows = [{ a: 'plain' }, { a: 0 }, { a: '' }, { a: ' padded ' }, { a: 'tab\there' }, { a: null }]
+  assert.equal(toCSV(rows, ['a']), 'a\nplain\n0\n\n padded \ntab\there\n\n')
+})
+
+test('toCSV quotes header names with special characters', () => {
+  assert.equal(toCSV([{ 'a,b': 1, 'c"d': 2, plain: 3 }], ['a,b', 'c"d', 'plain']), '"a,b","c""d",plain\n1,2,3\n')
+})
diff --git a/test/money.test.js b/test/money.test.js
index 917bae5..3271843 100644
--- a/test/money.test.js
+++ b/test/money.test.js
@@ -22,3 +22,54 @@ test('applyDiscount', () => {
   assert.throws(() => applyDiscount(1_000, 101), RangeError)
   assert.throws(() => applyDiscount(1_000, -1), RangeError)
 })
+
+test('applyDiscount rounds half up to the nearest cent', () => {
+  assert.equal(applyDiscount(1_001, 15), 851)
+  assert.equal(applyDiscount(10, 15), 9)
+  assert.equal(applyDiscount(1_001, 10), 901)
+  assert.equal(applyDiscount(1_004, 10), 904)
+  assert.equal(applyDiscount(1_003, 15), 853)
+  assert.equal(applyDiscount(1, 50), 1)
+  assert.equal(applyDiscount(1, 51), 0)
+  assert.equal(applyDiscount(5, 50), 3)
+  assert.equal(applyDiscount(20, 12.5), 18)
+})
+
+test('applyDiscount is exact for non-integer percents', () => {
+  assert.equal(applyDiscount(1_500, 66.7), 500)
+  assert.equal(applyDiscount(3_500, 66.7), 1_166)
+  assert.equal(applyDiscount(100, 0.5), 100)
+  assert.equal(applyDiscount(1_000, 12.5), 875)
+  assert.equal(applyDiscount(7, 0.01), 7)
+  assert.equal(applyDiscount(1_000, 1e-7), 1_000)
+})
+
+test('applyDiscount boundaries', () => {
+  for (const p of [0, 15, 100]) assert.equal(applyDiscount(0, p), 0)
+  for (const c of [0, 1, 999, 1_000]) assert.equal(applyDiscount(c, 0), c)
+  assert.equal(applyDiscount(1_000, 100), 0)
+  assert.equal(applyDiscount(9_007_199_254_740_991, 0), 9_007_199_254_740_991)
+  assert.equal(applyDiscount(1_000_000_000_001, 15), 850_000_000_001)
+})
+
+test('applyDiscount rounds negative cents half away from zero', () => {
+  assert.equal(applyDiscount(-10, 15), -9)
+  assert.equal(applyDiscount(-1, 50), -1)
+})
+
+test('applyDiscount matches exact half-up rounding for every tenth of a percent', () => {
+  for (let cents = 0; cents <= 300; cents++) {
+    for (let k = 0; k <= 1_000; k++) {
+      // cents * (1000 - k) / 1000 rounded half up, in integers
+      const expected = Math.floor((2 * cents * (1_000 - k) + 1_000) / 2_000)
+      assert.equal(applyDiscount(cents, k / 10), expected, `cents=${cents} percent=${k / 10}`)
+    }
+  }
+})
+
+test('applyDiscount always returns an integer and rejects out-of-range percents', () => {
+  assert.equal(Number.isInteger(applyDiscount(1_003, 33.3)), true)
+  for (const p of [101, -1, NaN, 100.0001]) {
+    assert.throws(() => applyDiscount(1_000, p), RangeError)
+  }
+})
