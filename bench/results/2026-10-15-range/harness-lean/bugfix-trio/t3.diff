--- a/test/csv.test.js
+++ b/test/csv.test.js
@@ -13,3 +13,43 @@ test('toCSV renders a header and one line per row', () => {
 test('toCSV leaves missing values empty', () => {
   assert.equal(toCSV([{ a: null }], ['a', 'b']), 'a,b\n,\n')
 })
+
+test('toCSV quotes cells containing a comma, quote, CR or LF', () => {
+  const cases = [
+    ['a,b', '"a,b"'],
+    ['a"b', '"a""b"'],
+    ['a\nb', '"a\nb"'],
+    ['a\rb', '"a\rb"'],
+    ['a\r\nb', '"a\r\nb"'],
+    ['"', '""""'],
+    [',', '","'],
+    ['""', '""""""'],
+    ['say "hi", bye', '"say ""hi"", bye"'],
+  ]
+  for (const [value, expected] of cases) {
+    assert.equal(toCSV([{ a: value }], ['a']), `a\n${expected}\n`, JSON.stringify(value))
+  }
+})
+
+test('toCSV leaves fields without special characters unquoted', () => {
+  const values = ['plain', '', 0, -3, 2.5, ' x ', ';', "it's", 'a b']
+  const expected = ['plain', '', '0', '-3', '2.5', ' x ', ';', "it's", 'a b']
+  const rows = values.map((a) => ({ a }))
+  assert.equal(toCSV(rows, ['a']), 'a\n' + expected.map((e) => e + '\n').join(''))
+})
+
+test('toCSV renders null and undefined as empty unquoted fields', () => {
+  assert.equal(toCSV([{ a: null, b: undefined }], ['a', 'b']), 'a,b\n,\n')
+})
+
+test('toCSV quotes non-string values by their String() form', () => {
+  assert.equal(toCSV([{ a: ['a', 'b'] }], ['a']), 'a\n"a,b"\n')
+})
+
+test('toCSV quotes header cells the same way', () => {
+  assert.equal(toCSV([], ['a,b', 'c']), '"a,b",c\n')
+})
+
+test('toCSV keeps embedded CR and LF verbatim inside quoted fields', () => {
+  assert.equal(toCSV([{ a: 'x\r\ny', b: 'z' }], ['a', 'b']), 'a,b\n"x\r\ny",z\n')
+})
diff --git a/test/invoice-csv.test.js b/test/invoice-csv.test.js
new file mode 100644
index 0000000..49bd66d
--- /dev/null
+++ b/test/invoice-csv.test.js
@@ -0,0 +1,48 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createServer } from '../src/server.js'
+import { Ledger } from '../src/ledger.js'
+
+async function start() {
+  const server = createServer({ ledger: new Ledger(), now: () => 1_000 })
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const base = `http://127.0.0.1:${server.address().port}`
+  const close = () => new Promise((resolve) => { server.closeAllConnections(); server.close(resolve) })
+  return { base, close }
+}
+
+const event = { model: 'claude-sonnet-5', usage: { inputTokens: 1_000_000, outputTokens: 100_000 } }
+
+function post(base, key) {
+  return fetch(`${base}/events`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json', 'x-api-key': key },
+    body: JSON.stringify(event),
+  })
+}
+
+test('invoice CSV quotes a key containing a comma', async (t) => {
+  const { base, close } = await start()
+  t.after(close)
+  await post(base, 'team, alpha')
+  const res = await fetch(`${base}/invoices/${encodeURIComponent('team, alpha')}?format=csv`)
+  assert.equal(res.status, 200)
+  assert.equal(
+    await res.text(),
+    'key,model,requests,inputTokens,outputTokens,cacheReadTokens,cacheWriteTokens,costMicro\n' +
+      '"team, alpha",claude-sonnet-5,1,1000000,100000,0,0,3000000\n',
+  )
+})
+
+test('invoice CSV doubles quotes in a key containing a double quote', async (t) => {
+  const { base, close } = await start()
+  t.after(close)
+  await post(base, 'say "hi"')
+  const res = await fetch(`${base}/invoices/${encodeURIComponent('say "hi"')}?format=csv`)
+  assert.equal(res.status, 200)
+  assert.equal(
+    await res.text(),
+    'key,model,requests,inputTokens,outputTokens,cacheReadTokens,cacheWriteTokens,costMicro\n' +
+      '"say ""hi""",claude-sonnet-5,1,1000000,100000,0,0,3000000\n',
+  )
+})
