-// Applies a percentage discount (0 to 100) to an amount in cents.
+// Exact decimal fraction mantissa / 10^scale for the shortest round-trip form of a percent.
+function percentFraction(percent) {
+  const [, whole, fraction = '', exponent = '0'] = /^(\d+)(?:\.(\d+))?(?:e([+-]\d+))?$/.exec(String(Number(percent)))
+  return { mantissa: BigInt(whole + fraction), scale: fraction.length - Number(exponent) }
+}
+
+// Applies a percentage discount (0 to 100) to an amount in cents, rounding half up to the nearest cent.
+// Exact integer arithmetic; negative amounts round half away from zero.
 export function applyDiscount(cents, percent) {
   if (!(percent >= 0 && percent <= 100)) throw new RangeError('percent must be between 0 and 100')
-  return Math.floor((cents * (100 - percent)) / 100)
+  if (!Number.isInteger(cents)) throw new RangeError('cents must be an integer')
+  const { mantissa, scale } = percentFraction(percent)
+  const den = 100n * 10n ** BigInt(scale)
+  const num = BigInt(Math.abs(cents)) * (den - mantissa)
+  const result = Number((2n * num + den) / (2n * den))
+  return cents < 0 && result !== 0 ? -result : result
 }
