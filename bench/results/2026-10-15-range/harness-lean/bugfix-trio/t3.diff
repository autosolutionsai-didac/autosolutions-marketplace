diff --git a/test/money.test.js b/test/money.test.js
index 917bae5..d34dfae 100644
--- a/test/money.test.js
+++ b/test/money.test.js
@@ -22,3 +22,41 @@ test('applyDiscount', () => {
   assert.throws(() => applyDiscount(1_000, 101), RangeError)
   assert.throws(() => applyDiscount(1_000, -1), RangeError)
 })
+
+test('applyDiscount rounds half up to the nearest cent', () => {
+  assert.equal(applyDiscount(1_001, 15), 851)
+  assert.equal(applyDiscount(10, 15), 9)
+  assert.equal(applyDiscount(1, 50), 1)
+  assert.equal(applyDiscount(3, 50), 2)
+  assert.equal(applyDiscount(4, 12.5), 4)
+  assert.equal(applyDiscount(125, 64.4), 45)
+  assert.equal(applyDiscount(500, 34.9), 326)
+  assert.equal(applyDiscount(1_001, 10), 901)
+  assert.equal(applyDiscount(1_004, 15), 853)
+  assert.equal(applyDiscount(1_006, 15), 855)
+  assert.equal(applyDiscount(1_000, 1e-7), 1_000)
+  assert.equal(applyDiscount(1_000, 1.5e-10), 1_000)
+  assert.equal(applyDiscount(1_000, 99.95), 1)
+  assert.equal(applyDiscount(1_001, '15'), 851)
+  assert.equal(applyDiscount(Number.MAX_SAFE_INTEGER, 50), 4503599627370496)
+  assert.equal(applyDiscount(-10, 15), -9)
+})
+
+test('applyDiscount boundaries', () => {
+  for (const cents of [0, 1, 7, 999, 1_001, 123_457]) assert.equal(applyDiscount(cents, 0), cents)
+  for (const cents of [0, 1, 7, 999, 1_001]) assert.equal(applyDiscount(cents, 100), 0)
+  for (const percent of [0, 0.5, 12.5, 33.3, 99.95, 100]) assert.equal(applyDiscount(0, percent), 0)
+  for (const percent of [0, 1e-7, 12.5, 33.3, 99.95, 100]) {
+    for (const cents of [1, 2, 3, 999, 1_001]) {
+      const result = applyDiscount(cents, percent)
+      assert.ok(Number.isInteger(result) && result >= 0 && result <= cents)
+    }
+  }
+})
+
+test('applyDiscount rejects invalid input', () => {
+  for (const percent of [NaN, undefined, -1, 101, -0.0001, 100.0001]) {
+    assert.throws(() => applyDiscount(1_000, percent), RangeError)
+  }
+  assert.throws(() => applyDiscount(1.5, 10), RangeError)
+})
