@@ -0,0 +1,52 @@
+export const DEFAULT_RATE_LIMIT = { limit: 60, windowMs: 60_000 }
+
+// Expired windows are only swept once this many keys are tracked, at most once per windowMs.
+const SWEEP_THRESHOLD = 10_000
+
+// Fixed-window limiter keyed by string. Time only comes from the injected now().
+export function createRateLimiter({ limit = DEFAULT_RATE_LIMIT.limit, windowMs = DEFAULT_RATE_LIMIT.windowMs, now } = {}) {
+  // Bounded so counts stay exact and windowStart + windowMs never rounds back to windowStart.
+  if (!Number.isSafeInteger(limit) || limit < 1) {
+    throw new RangeError(`limit must be an integer from 1 to ${Number.MAX_SAFE_INTEGER}, got ${limit}`)
+  }
+  if (!(typeof windowMs === 'number' && windowMs >= 1 && windowMs <= Number.MAX_SAFE_INTEGER)) {
+    throw new RangeError(`windowMs must be a number from 1 to ${Number.MAX_SAFE_INTEGER}, got ${windowMs}`)
+  }
+  if (typeof now !== 'function') throw new TypeError('now must be a function')
+
+  const windows = new Map()
+  let nextSweep = -Infinity
+
+  const expired = (entry, t) => t >= entry.windowStart + windowMs
+
+  return {
+    get size() {
+      return windows.size
+    },
+
+    hit(key) {
+      const t = now()
+      if (!Number.isFinite(t)) throw new TypeError(`now() must return a finite number, got ${t}`)
+
+      if (windows.size >= SWEEP_THRESHOLD && t >= nextSweep) {
+        for (const [k, entry] of windows) if (expired(entry, t)) windows.delete(k)
+        nextSweep = t + windowMs
+      }
+
+      let entry = windows.get(key)
+      if (!entry || expired(entry, t)) {
+        entry = { windowStart: t, count: 0 }
+        windows.set(key, entry)
+      }
+
+      if (entry.count < limit) {
+        entry.count += 1
+        return { allowed: true, limit, remaining: limit - entry.count }
+      }
+
+      // windowMs - elapsed never rounds past a whole second the way windowStart + windowMs - t can.
+      const retryAfter = Math.max(1, Math.ceil((windowMs - (t - entry.windowStart)) / 1000))
+      return { allowed: false, limit, remaining: 0, retryAfter }
+    },
+  }
+}
