+})
+
+test('GET /health is never limited, counted or decorated', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 5 } })
+  for (let i = 0; i < 100; i++) {
+    const res = await request(base, '/health', { key: 'k' })
