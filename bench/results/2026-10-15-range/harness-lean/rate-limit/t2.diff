+++ b/test/rate-limit.test.js
@@ -0,0 +1,414 @@
+import http from 'node:http'
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createRateLimiter } from '../src/rate-limit.js'
+import { createServer } from '../src/server.js'
+import { Ledger } from '../src/ledger.js'
+
+async function start(options = {}) {
+  const clock = { t: 1_000 }
+  const server = createServer({ ledger: new Ledger(), now: () => clock.t, ...options })
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const base = `http://127.0.0.1:${server.address().port}`
+  const close = () => new Promise((resolve) => { server.closeAllConnections(); server.close(resolve) })
+  return { base, clock, close }
+}
+
+async function request(base, path, { key, method = 'GET', body, headers = {} } = {}) {
+  const all = { ...headers }
+  if (key !== undefined) all['x-api-key'] = key
+  if (body) all['content-type'] = 'application/json'
+  const res = await fetch(`${base}${path}`, { method, headers: all, body: body && JSON.stringify(body) })
+  return { status: res.status, headers: res.headers, text: await res.text() }
+}
+
+const event = { model: 'claude-sonnet-5', usage: { inputTokens: 1_000, outputTokens: 100 } }
+
+test('limiter allows exactly limit requests per window, then rejects', () => {
+  const limiter = createRateLimiter({ limit: 3, windowMs: 1_000, now: () => 0 })
+  assert.equal(limiter.hit('a').allowed, true)
+  assert.equal(limiter.hit('a').allowed, true)
+  assert.equal(limiter.hit('a').allowed, true)
+  assert.equal(limiter.hit('a').allowed, false)
+})
+
+test('limiter remaining counts down and stays 0 when rejected', () => {
+  const limiter = createRateLimiter({ limit: 3, windowMs: 1_000, now: () => 0 })
+  assert.deepEqual(limiter.hit('a'), { allowed: true, limit: 3, remaining: 2 })
+  assert.deepEqual(limiter.hit('a'), { allowed: true, limit: 3, remaining: 1 })
+  assert.deepEqual(limiter.hit('a'), { allowed: true, limit: 3, remaining: 0 })
+  assert.deepEqual(limiter.hit('a'), { allowed: false, limit: 3, remaining: 0, retryAfter: 1 })
+  assert.deepEqual(limiter.hit('a'), { allowed: false, limit: 3, remaining: 0, retryAfter: 1 })
+})
+
+test('limiter window ends at windowStart + windowMs, inclusive for the new window', () => {
+  let t = 0
+  const limiter = createRateLimiter({ limit: 1, windowMs: 60_000, now: () => t })
+  assert.equal(limiter.hit('a').allowed, true)
+  t = 59_999
+  assert.equal(limiter.hit('a').allowed, false)
+  t = 60_000
+  assert.deepEqual(limiter.hit('a'), { allowed: true, limit: 1, remaining: 0 })
+})
+
+test('limiter anchors a new window at the request time, not at a multiple of windowMs', () => {
+  let t = 0
+  const limiter = createRateLimiter({ limit: 1, windowMs: 60_000, now: () => t })
+  assert.equal(limiter.hit('a').allowed, true)
+  t = 150_000
+  assert.equal(limiter.hit('a').allowed, true)
+  t = 209_999
+  assert.equal(limiter.hit('a').allowed, false)
+  t = 210_000
+  assert.equal(limiter.hit('a').allowed, true)
+})
+
+test('limiter keeps keys independent', () => {
+  const limiter = createRateLimiter({ limit: 1, windowMs: 1_000, now: () => 0 })
+  assert.equal(limiter.hit('a').allowed, true)
+  assert.equal(limiter.hit('a').allowed, false)
+  assert.equal(limiter.hit('b').allowed, true)
+})
+
+test('limiter retryAfter rounds up whole seconds', () => {
+  let t = 0
+  const limiter = createRateLimiter({ limit: 1, windowMs: 60_000, now: () => t })
+  limiter.hit('a')
+  t = 59_999
+  assert.equal(limiter.hit('a').retryAfter, 1)
+  t = 59_000
+  assert.equal(limiter.hit('a').retryAfter, 1)
+  t = 58_999
+  assert.equal(limiter.hit('a').retryAfter, 2)
+  t = 0
+  assert.equal(limiter.hit('a').retryAfter, 60)
+
+  const short = createRateLimiter({ limit: 1, windowMs: 1_500, now: () => 0 })
+  short.hit('a')
+  assert.equal(short.hit('a').retryAfter, 2)
+
+  const long = createRateLimiter({ limit: 1, windowMs: 3_600_000, now: () => 0 })
+  long.hit('a')
+  assert.equal(long.hit('a').retryAfter, 3600)
+})
+
+test('limiter retryAfter is an integer for non-integer seconds mid-window', () => {
+  let t = 1_000
+  const limiter = createRateLimiter({ limit: 1, windowMs: 1_500, now: () => t })
+  limiter.hit('a')
+  t = 1_400
+  assert.equal(limiter.hit('a').retryAfter, 2)
+  t = 2_000
+  assert.equal(limiter.hit('a').retryAfter, 1)
+  t = 2_499
+  assert.equal(limiter.hit('a').retryAfter, 1)
+})
+
+test('limiter with limit 1 resets after a single request', () => {
+  let t = 0
+  const limiter = createRateLimiter({ limit: 1, windowMs: 1_000, now: () => t })
+  assert.deepEqual(limiter.hit('a'), { allowed: true, limit: 1, remaining: 0 })
+  assert.equal(limiter.hit('a').allowed, false)
+  t = 5_000
+  assert.deepEqual(limiter.hit('a'), { allowed: true, limit: 1, remaining: 0 })
+})
+
+test('limiter gap longer than several windows starts one window at the request time', () => {
+  let t = 0
+  const limiter = createRateLimiter({ limit: 2, windowMs: 1_000, now: () => t })
+  limiter.hit('a')
+  limiter.hit('a')
+  t = 10_500
+  assert.deepEqual(limiter.hit('a'), { allowed: true, limit: 2, remaining: 1 })
+  assert.deepEqual(limiter.hit('a'), { allowed: true, limit: 2, remaining: 0 })
+  t = 10_999
+  assert.equal(limiter.hit('a').allowed, false)
+})
+
+test('limiter retryAfter does not round up a whole window with a fractional clock', () => {
+  let t
+  const limiter = createRateLimiter({ limit: 1, windowMs: 3_000, now: () => t })
+  for (const start of [262011.0429006881, 0.1, 1.7e12 + 0.3, 12345.678]) {
+    t = start
+    limiter.hit(String(start))
+    assert.equal(limiter.hit(String(start)).retryAfter, 3, `start ${start}`)
+  }
+})
+
+test('limiter validates limit and windowMs', () => {
+  const now = () => 0
+  for (const limit of [0, -1, 1.5, NaN, Infinity, '5']) {
+    assert.throws(() => createRateLimiter({ limit, now }), RangeError, `limit ${limit}`)
+  }
+  for (const windowMs of [0, -1, 0.5, 1e-5, NaN, Infinity, '1000']) {
+    assert.throws(() => createRateLimiter({ windowMs, now }), RangeError, `windowMs ${windowMs}`)
+  }
+  assert.throws(() => createRateLimiter({ limit: 1 }), TypeError)
+})
+
+test('limiter rejects limit and windowMs beyond MAX_SAFE_INTEGER', () => {
+  const now = () => 0
+  for (const limit of [2 ** 53, 2 ** 54, 1e21]) {
+    assert.throws(() => createRateLimiter({ limit, now }), RangeError, `limit ${limit}`)
+  }
+  for (const windowMs of [2 ** 53, 1e20, Number.MAX_VALUE]) {
+    assert.throws(() => createRateLimiter({ windowMs, now }), RangeError, `windowMs ${windowMs}`)
+  }
+})
+
+test('limiter accepts the largest safe limit and windowMs', () => {
+  const max = Number.MAX_SAFE_INTEGER
+  const rl = createRateLimiter({ limit: max, windowMs: 1000, now: () => 0 })
+  assert.deepEqual(rl.hit('k'), { allowed: true, limit: max, remaining: max - 1 })
+  assert.deepEqual(rl.hit('k'), { allowed: true, limit: max, remaining: max - 2 })
+
+  const long = createRateLimiter({ limit: 1, windowMs: max, now: () => 0 })
+  long.hit('k')
+  const r = long.hit('k')
+  assert.equal(r.allowed, false)
+  assert.equal(String(r.retryAfter), String(Math.ceil(max / 1000)))
+})
+
+test('limiter enforces the smallest window at Date.now-scale clock values', () => {
+  let t = 1.7e12
+  const limiter = createRateLimiter({ limit: 1, windowMs: 1, now: () => t })
+  assert.equal(limiter.hit('a').allowed, true)
+  assert.equal(limiter.hit('a').allowed, false)
+  t += 1
+  assert.equal(limiter.hit('a').allowed, true)
+})
+
+test('limiter sweeps expired windows once many keys are tracked', () => {
+  let t = 0
+  const limiter = createRateLimiter({ limit: 2, windowMs: 1000, now: () => t })
+  for (let i = 0; i < 10_000; i++) limiter.hit(`k${i}`)
+  assert.equal(limiter.size, 10_000)
+
+  // Nothing has expired yet, so the sweep keeps every window.
+  t = 999
+  assert.equal(limiter.hit('k0').remaining, 0)
+  assert.equal(limiter.size, 10_000)
+
+  // The next sweep waits a full window; expired keys still start fresh windows meanwhile.
+  t = 1000
+  assert.deepEqual(limiter.hit('k0'), { allowed: true, limit: 2, remaining: 1 })
+  assert.deepEqual(limiter.hit('fresh'), { allowed: true, limit: 2, remaining: 1 })
+  assert.equal(limiter.size, 10_001)
+
+  t = 1999
+  assert.deepEqual(limiter.hit('k0'), { allowed: true, limit: 2, remaining: 0 })
+  assert.equal(limiter.size, 2)
+  assert.deepEqual(limiter.hit('k1'), { allowed: true, limit: 2, remaining: 1 })
+})
+
+test('limiter sweep keeps windows that have not ended', () => {
+  let t = 0
+  const limiter = createRateLimiter({ limit: 2, windowMs: 1000, now: () => t })
+  for (let i = 0; i < 9_999; i++) limiter.hit(`old${i}`)
+  t = 500
+  limiter.hit('live')
+  t = 1000
+  limiter.hit('trigger')
+  assert.equal(limiter.size, 2)
+  assert.deepEqual(limiter.hit('live'), { allowed: true, limit: 2, remaining: 0 })
+  assert.equal(limiter.hit('live').allowed, false)
+})
+
+test('defaults are limit 60 and windowMs 60000', async () => {
+  const { base, close } = await start()
+  for (let i = 0; i < 60; i++) {
+    const res = await request(base, '/nope', { key: 'k' })
+    assert.equal(res.status, 404)
+    assert.equal(res.headers.get('x-ratelimit-limit'), '60')
+    assert.equal(res.headers.get('x-ratelimit-remaining'), String(59 - i))
+  }
+  const blocked = await request(base, '/nope', { key: 'k' })
+  assert.equal(blocked.status, 429)
+  assert.equal(blocked.headers.get('x-ratelimit-remaining'), '0')
+  assert.equal(blocked.headers.get('retry-after'), '60')
+  await close()
+})
+
+test('a partial rateLimit object merges with the defaults', async () => {
+  const { base, clock, close } = await start({ rateLimit: { limit: 2 } })
+  assert.equal((await request(base, '/nope', { key: 'k' })).status, 404)
+  assert.equal((await request(base, '/nope', { key: 'k' })).status, 404)
+  assert.equal((await request(base, '/nope', { key: 'k' })).status, 429)
+  clock.t = 1_000 + 59_999
+  assert.equal((await request(base, '/nope', { key: 'k' })).status, 429)
+  clock.t = 1_000 + 60_000
+  assert.equal((await request(base, '/nope', { key: 'k' })).status, 404)
+  await close()
+
+  const other = await start({ rateLimit: { windowMs: 1_000 } })
+  const res = await request(other.base, '/nope', { key: 'k' })
+  assert.equal(res.headers.get('x-ratelimit-limit'), '60')
+  await other.close()
+})
+
+test('a 429 has Retry-After, a matching JSON body and Remaining 0', async () => {
+  const { base, clock, close } = await start({ rateLimit: { limit: 1, windowMs: 1_500 } })
+  await request(base, '/nope', { key: 'k' })
+  const res = await request(base, '/nope', { key: 'k' })
+  assert.equal(res.status, 429)
+  assert.equal(res.headers.get('content-type'), 'application/json')
+  assert.equal(res.headers.get('x-ratelimit-remaining'), '0')
+  assert.equal(res.headers.get('retry-after'), '2')
+  assert.deepEqual(JSON.parse(res.text), { error: 'rate_limited', retryAfter: 2 })
+  assert.equal(res.text, '{"error":"rate_limited","retryAfter":2}')
+
+  clock.t = 2_000
+  const later = await request(base, '/nope', { key: 'k' })
+  assert.equal(later.headers.get('retry-after'), '1')
+  assert.deepEqual(JSON.parse(later.text), { error: 'rate_limited', retryAfter: 1 })
+  await close()
+})
+
+test('401, 404, 403 and 400 responses are counted and carry the headers', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 3 } })
+  const unauthorized = await request(base, '/events', { method: 'POST', body: event })
+  assert.equal(unauthorized.status, 401)
+  assert.equal(unauthorized.headers.get('x-ratelimit-limit'), '3')
+  assert.equal(unauthorized.headers.get('x-ratelimit-remaining'), '2')
+
+  const notFound = await request(base, '/nope', { key: 'k' })
+  assert.equal(notFound.status, 404)
+  assert.equal(notFound.headers.get('x-ratelimit-remaining'), '2')
+
+  const forbidden = await request(base, '/admin/keys', { key: 'k', headers: { 'x-admin-token': 'wrong' } })
+  assert.equal(forbidden.status, 403)
+  assert.equal(forbidden.headers.get('x-ratelimit-remaining'), '1')
+
+  const invalid = await request(base, '/events', { key: 'k', method: 'POST', body: { model: 'nope', usage: {} } })
+  assert.equal(invalid.status, 400)
+  assert.equal(invalid.headers.get('x-ratelimit-remaining'), '0')
+
+  const blocked = await request(base, '/nope', { key: 'k' })
+  assert.equal(blocked.status, 429)
+  assert.equal(blocked.headers.get('x-ratelimit-remaining'), '0')
+  await close()
+})
+
+test('requests without x-api-key share the anonymous bucket, separate from real keys', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1 } })
+  const first = await request(base, '/events', { method: 'POST', body: event })
+  assert.equal(first.status, 401)
+  const second = await request(base, '/events', { method: 'POST', body: event, headers: { 'x-api-key': '' } })
