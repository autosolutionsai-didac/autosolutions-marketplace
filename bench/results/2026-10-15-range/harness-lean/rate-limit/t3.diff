@@ -0,0 +1,36 @@
+// Fixed-window request limiter. Each key gets `limit` requests per window; time comes from the caller.
+export const DEFAULT_RATE_LIMIT = { limit: 60, windowMs: 60000 }
+
+const MIN_SWEEP = 1024
+
+export function createRateLimiter({ limit = DEFAULT_RATE_LIMIT.limit, windowMs = DEFAULT_RATE_LIMIT.windowMs } = {}) {
+  if (!Number.isSafeInteger(limit) || limit < 0) throw new RangeError('limit must be a non-negative safe integer')
+  if (!Number.isFinite(windowMs) || windowMs <= 0) throw new RangeError('windowMs must be a finite number above 0')
+
+  const state = new Map()
+  let sweepAt = MIN_SWEEP
+
+  // Drops entries whose window has ended, so the map cannot grow without bound.
+  function sweep(now) {
+    for (const [key, entry] of state) {
+      if (now >= entry.windowStart + windowMs) state.delete(key)
+    }
+    sweepAt = Math.max(MIN_SWEEP, state.size * 2)
+  }
+
+  return {
+    hit(key, now) {
+      if (state.size >= sweepAt) sweep(now)
+      let entry = state.get(key)
+      if (!entry || now >= entry.windowStart + windowMs) {
+        entry = { windowStart: now, count: 0 }
+        state.set(key, entry)
+      }
+      entry.count += 1
+      const allowed = entry.count <= limit
+      if (allowed) return { allowed, limit, remaining: Math.max(0, limit - entry.count), retryAfter: null }
+      const retryAfter = Math.max(1, Math.ceil((entry.windowStart + windowMs - now) / 1000))
+      return { allowed, limit, remaining: 0, retryAfter }
+    },
+  }
+}
