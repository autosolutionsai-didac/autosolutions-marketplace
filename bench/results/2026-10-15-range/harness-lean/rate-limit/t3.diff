@@ -0,0 +1,361 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createServer } from '../src/server.js'
+import { Ledger } from '../src/ledger.js'
+import { DEFAULT_RATE_LIMIT, createRateLimiter } from '../src/rate-limit.js'
+
+let t = 0
+
+async function start(options = {}) {
+  const server = createServer({ ledger: new Ledger(), now: () => t, ...options })
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const base = `http://127.0.0.1:${server.address().port}`
+  const close = () => new Promise((resolve) => { server.closeAllConnections(); server.close(resolve) })
+  return { base, close }
+}
+
+const event = { model: 'claude-sonnet-5', usage: { inputTokens: 1_000, outputTokens: 100 } }
+
+function get(base, path, key) {
+  const headers = {}
+  if (key !== undefined) headers['x-api-key'] = key
+  return fetch(`${base}${path}`, { headers })
+}
+
+function post(base, key, body = event) {
+  const headers = { 'content-type': 'application/json' }
+  if (key) headers['x-api-key'] = key
+  return fetch(`${base}/events`, { method: 'POST', headers, body: JSON.stringify(body) })
+}
+
+function remaining(res) {
+  return res.headers.get('x-ratelimit-remaining')
+}
+
+test('default limit is 60 per key and the 61st request is rejected', async () => {
+  t = 0
+  const { base, close } = await start()
+  for (let n = 1; n <= 60; n++) {
+    const res = await get(base, '/nope', 'acme')
+    assert.equal(res.status, 404)
+    assert.equal(res.headers.get('x-ratelimit-limit'), '60')
+    assert.equal(remaining(res), String(60 - n))
+  }
+  const res = await get(base, '/nope', 'acme')
+  assert.equal(res.status, 429)
+  assert.equal(remaining(res), '0')
+  await close()
+})
+
+test('custom small limit counts down and then rejects', async () => {
+  t = 0
+  const { base, close } = await start({ rateLimit: { limit: 3 } })
+  assert.equal(remaining(await get(base, '/nope', 'a')), '2')
+  assert.equal(remaining(await get(base, '/nope', 'a')), '1')
+  assert.equal(remaining(await get(base, '/nope', 'a')), '0')
+  const res = await get(base, '/nope', 'a')
+  assert.equal(res.status, 429)
+  assert.equal(remaining(res), '0')
+  await close()
+})
+
+test('429 body and Retry-After carry the same integer', async () => {
+  t = 0
+  const { base, close } = await start({ rateLimit: { limit: 1, windowMs: 60000 } })
+  await get(base, '/nope', 'a')
+  t = 1500
+  const res = await get(base, '/nope', 'a')
+  assert.equal(res.status, 429)
+  assert.equal(res.headers.get('retry-after'), '59')
+  assert.equal(res.headers.get('content-type'), 'application/json')
+  assert.equal(await res.text(), '{"error":"rate_limited","retryAfter":59}')
+  await close()
+})
+
+test('Retry-After rounds up and has a minimum of 1', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1, windowMs: 60000 } })
+  const retryAfter = async (at) => {
+    t = at
+    return (await get(base, '/nope', 'a')).headers.get('retry-after')
+  }
+  t = 0
+  assert.equal((await get(base, '/nope', 'a')).status, 404)
+  assert.equal(await retryAfter(59001), '1')
+  assert.equal(await retryAfter(59999), '1')
+  assert.equal(await retryAfter(0), '60')
+  await close()
+
+  const short = await start({ rateLimit: { limit: 1, windowMs: 1500.5 } })
+  t = 0
+  await get(short.base, '/nope', 'a')
+  const res = await get(short.base, '/nope', 'a')
+  assert.equal(res.status, 429)
+  assert.equal(res.headers.get('retry-after'), '2')
+  await short.close()
+})
+
+test('window resets exactly at windowStart + windowMs', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1, windowMs: 1000 } })
+  t = 0
+  assert.equal((await get(base, '/nope', 'a')).status, 404)
+  t = 999
+  assert.equal((await get(base, '/nope', 'a')).status, 429)
+  t = 1000
+  const res = await get(base, '/nope', 'a')
+  assert.equal(res.status, 404)
+  assert.equal(remaining(res), '0')
+  await close()
+})
+
+test('a new window starts at the first request after expiry, not an aligned boundary', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1, windowMs: 60000 } })
+  t = 0
+  assert.equal((await get(base, '/nope', 'a')).status, 404)
+  t = 70000
+  assert.equal((await get(base, '/nope', 'a')).status, 404)
+  t = 129999
+  assert.equal((await get(base, '/nope', 'a')).status, 429)
+  t = 130000
+  assert.equal((await get(base, '/nope', 'a')).status, 404)
+  await close()
+})
+
+test('rejected requests do not extend the window', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1, windowMs: 1000 } })
+  t = 0
+  assert.equal((await get(base, '/nope', 'a')).status, 404)
+  t = 500
+  assert.equal((await get(base, '/nope', 'a')).status, 429)
+  t = 999
+  assert.equal((await get(base, '/nope', 'a')).status, 429)
+  t = 1000
+  assert.equal((await get(base, '/nope', 'a')).status, 404)
