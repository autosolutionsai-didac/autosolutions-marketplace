+// Fixed-window rate limiter. All timing comes from the injected `now()`.
+export function createRateLimiter({ limit = 60, windowMs = 60_000, now } = {}) {
+  if (typeof limit !== 'number') throw new TypeError(`limit must be a number, got ${typeof limit}`)
+  if (!Number.isInteger(limit) || limit < 0) throw new RangeError(`limit must be an integer >= 0, got ${limit}`)
+  if (typeof windowMs !== 'number') throw new TypeError(`windowMs must be a number, got ${typeof windowMs}`)
+  if (!Number.isFinite(windowMs) || windowMs <= 0) throw new RangeError(`windowMs must be a finite number > 0, got ${windowMs}`)
+  if (typeof now !== 'function') throw new TypeError('now must be a function')
+
+  const entries = new Map()
+
+  function hit(key) {
+    const t = now()
+    let entry = entries.get(key)
+    if (!entry || t >= entry.windowStart + windowMs) {
+      entry = { windowStart: t, count: 0 }
+      entries.set(key, entry)
+    }
+    if (entry.count < limit) {
+      entry.count++
+      return { allowed: true, limit, remaining: limit - entry.count, retryAfter: 0 }
+    }
+    const retryAfter = Math.max(1, Math.ceil((entry.windowStart + windowMs - t) / 1000))
+    return { allowed: false, limit, remaining: 0, retryAfter }
+  }
+
+  return { hit }
+}
