diff --git a/src/money.js b/src/money.js
index 95a7ad7..e16ec02 100644
--- a/src/money.js
+++ b/src/money.js
@@ -13,7 +13,24 @@ export function formatUSD(cents) {
 }
 
 // Applies a percentage discount (0 to 100) to an amount in cents.
+// The result is cents x (100 - percent) / 100, computed exactly from the
+// percent's decimal form and rounded half up (ties toward +Infinity) to a whole cent.
 export function applyDiscount(cents, percent) {
-  if (!(percent >= 0 && percent <= 100)) throw new RangeError('percent must be between 0 and 100')
-  return Math.floor((cents * (100 - percent)) / 100)
+  if (typeof percent !== 'number' || !(percent >= 0 && percent <= 100)) {
+    throw new RangeError('percent must be between 0 and 100')
+  }
+  // percent = P / 10^s exactly; String() may use exponent form such as '1e-7'
+  const [mantissa, exp = '0'] = String(percent).split('e')
+  const [whole, frac = ''] = mantissa.split('.')
+  const scale = frac.length - Number(exp)
+  const digits = BigInt(whole + frac)
+  const P = scale < 0 ? digits * 10n ** BigInt(-scale) : digits
+  const den = 100n * 10n ** BigInt(Math.max(scale, 0))
+  const num = BigInt(cents) * (den - P)
+  // floor((2 num + den) / (2 den)); BigInt division truncates, so fix up negatives
+  const top = 2n * num + den
+  const bottom = 2n * den
+  let q = top / bottom
+  if (top % bottom < 0n) q -= 1n
+  return Number(q) + 0
 }
