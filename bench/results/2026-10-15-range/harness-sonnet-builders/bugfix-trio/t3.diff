@@ -9,5 +9,8 @@ export function toCSV(rows, columns) {
 
 function cell(value) {
   if (value === null || value === undefined) return ''
-  return String(value)
+  const text = String(value)
+  // RFC 4180: quote fields with a comma, quote, CR or LF; double inner quotes
