diff --git a/test/csv.test.js b/test/csv.test.js
index 9603268..498764b 100644
--- a/test/csv.test.js
+++ b/test/csv.test.js
@@ -13,3 +13,31 @@ test('toCSV renders a header and one line per row', () => {
 test('toCSV leaves missing values empty', () => {
   assert.equal(toCSV([{ a: null }], ['a', 'b']), 'a,b\n,\n')
 })
+
+test('toCSV quotes fields containing a comma', () => {
+  assert.equal(toCSV([{ key: 'team, alpha', n: 1 }], ['key', 'n']), 'key,n\n"team, alpha",1\n')
+})
+
+test('toCSV doubles double quotes inside quoted fields', () => {
+  assert.equal(toCSV([{ a: 'say "hi"', b: '"' }], ['a', 'b']), 'a,b\n"say ""hi""",""""\n')
+})
+
+test('toCSV quotes fields containing line breaks', () => {
+  const rows = [{ a: 'a\nb', b: 'a\rb', c: 'a\r\nb' }]
+  assert.equal(toCSV(rows, ['a', 'b', 'c']), 'a,b,c\n"a\nb","a\rb","a\r\nb"\n')
+})
+
+test('toCSV leaves fields without special characters unquoted', () => {
+  const values = [0, 3000000, 'plain', ' pad ', 'a b', 'a;b', "it's", 'héllo ✓', '']
+  const cols = values.map((_, i) => `c${i}`)
+  const row = Object.fromEntries(cols.map((c, i) => [c, values[i]]))
+  assert.equal(toCSV([row], cols), cols.join(',') + '\n' + values.join(',') + '\n')
+})
+
+test('toCSV quotes non-string values by their string form', () => {
+  assert.equal(toCSV([{ a: ['a', 'b'] }], ['a']), 'a\n"a,b"\n')
+})
+
+test('toCSV quotes header names with the same rule', () => {
+  assert.equal(toCSV([{ 'a,b': 1, 'c"d': 2 }], ['a,b', 'c"d']), '"a,b","c""d"\n1,2\n')
+})
