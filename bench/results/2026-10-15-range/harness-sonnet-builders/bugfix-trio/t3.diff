+})
diff --git a/test/money.test.js b/test/money.test.js
index 917bae5..a3911f4 100644
--- a/test/money.test.js
+++ b/test/money.test.js
@@ -22,3 +22,35 @@ test('applyDiscount', () => {
   assert.throws(() => applyDiscount(1_000, 101), RangeError)
   assert.throws(() => applyDiscount(1_000, -1), RangeError)
 })
+
+test('applyDiscount rounds half up to the nearest cent', () => {
+  assert.equal(applyDiscount(1_001, 15), 851)
+  assert.equal(applyDiscount(10, 15), 9)
+  assert.equal(applyDiscount(1_004, 15), 853)
+  assert.equal(applyDiscount(3_000, 14.15), 2_576)
+  assert.equal(applyDiscount(20, 2.5), 20)
+  assert.equal(applyDiscount(1, 50), 1)
+  assert.equal(applyDiscount(1, 51), 0)
+  assert.equal(applyDiscount(1_001, 0), 1_001)
+  assert.equal(applyDiscount(1_001, 100), 0)
+  assert.equal(applyDiscount(0, 15), 0)
+  assert.equal(applyDiscount(1_000, 1e-7), 1_000)
+  assert.equal(applyDiscount(1_000, 5e-7), 1_000)
+  assert.equal(applyDiscount(Number.MAX_SAFE_INTEGER, 50), 4_503_599_627_370_496)
+  assert.equal(applyDiscount(Number.MAX_SAFE_INTEGER, 0), Number.MAX_SAFE_INTEGER)
+})
+
+test('applyDiscount handles negative cents without -0', () => {
+  assert.equal(applyDiscount(-10, 15), -8)
+  assert.equal(applyDiscount(-11, 50), -5)
+  assert.equal(applyDiscount(-1_004, 15), -853)
+  assert.equal(applyDiscount(-Number.MAX_SAFE_INTEGER, 50), -4_503_599_627_370_495)
+  assert.ok(Object.is(applyDiscount(-10, 100), 0))
+  assert.ok(Object.is(applyDiscount(0, 50), 0))
+})
+
+test('applyDiscount rejects invalid percents', () => {
+  for (const bad of [101, -1, NaN, undefined, Infinity, null, '15']) {
+    assert.throws(() => applyDiscount(1_000, bad), RangeError)
+  }
+})
