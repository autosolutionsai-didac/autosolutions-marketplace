+
+test('invoice rounds the discounted total half up', () => {
+  const ledger = new Ledger({ discounts: { k: 15 } })
+  // haiku input is $1 per million tokens: 10_010_000 tokens = $10.01
+  ledger.record({ key: 'k', model: 'claude-haiku-4-5', usage: { inputTokens: 10_010_000 }, at: 1 })
