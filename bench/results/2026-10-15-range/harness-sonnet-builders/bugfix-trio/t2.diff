diff --git a/src/money.js b/src/money.js
index 95a7ad7..1f174e0 100644
--- a/src/money.js
+++ b/src/money.js
@@ -12,8 +12,26 @@ export function formatUSD(cents) {
   return `${sign}$${dollars}.${rest}`
 }
 
-// Applies a percentage discount (0 to 100) to an amount in cents.
+// Exact decimal form of a percent: percent = numerator / scale, from String(percent).
+function toRational(percent) {
+  const m = /^(\d+)(?:\.(\d+))?(?:e([+-]?\d+))?$/.exec(String(percent))
+  const frac = m[2] ?? ''
+  const exp = Number(m[3] ?? 0) - frac.length
+  const digits = BigInt(m[1] + frac)
+  return exp >= 0
+    ? { numerator: digits * 10n ** BigInt(exp), scale: 1n }
+    : { numerator: digits, scale: 10n ** BigInt(-exp) }
+}
+
+// Applies a percentage discount (0 to 100) to an amount in integer cents.
+// The result is cents * (100 - percent) / 100 computed exactly, rounded half up
+// to the nearest cent (ties go away from zero for negative amounts).
 export function applyDiscount(cents, percent) {
   if (!(percent >= 0 && percent <= 100)) throw new RangeError('percent must be between 0 and 100')
-  return Math.floor((cents * (100 - percent)) / 100)
+  if (!Number.isSafeInteger(cents)) throw new RangeError('cents must be an integer')
+  const { numerator, scale } = toRational(percent)
+  const den = 100n * scale
+  const num = BigInt(Math.abs(cents)) * (den - numerator)
+  const rounded = (2n * num + den) / (2n * den)
+  return Number(cents < 0 ? -rounded : rounded)
 }
