diff --git a/test/csv.test.js b/test/csv.test.js
index 9603268..6ab68a8 100644
--- a/test/csv.test.js
+++ b/test/csv.test.js
@@ -13,3 +13,34 @@ test('toCSV renders a header and one line per row', () => {
 test('toCSV leaves missing values empty', () => {
   assert.equal(toCSV([{ a: null }], ['a', 'b']), 'a,b\n,\n')
 })
+
+test('toCSV quotes a value containing a comma', () => {
+  assert.equal(toCSV([{ key: 'team, alpha', requests: 1 }], ['key', 'requests']), 'key,requests\n"team, alpha",1\n')
+})
+
+test('toCSV doubles embedded double quotes', () => {
+  assert.equal(toCSV([{ a: 'say "hi"' }], ['a']), 'a\n"say ""hi"""\n')
+})
+
+test('toCSV quotes a lone double quote', () => {
+  assert.equal(toCSV([{ a: '"' }], ['a']), 'a\n""""\n')
+})
+
+test('toCSV quotes a value that is only a comma', () => {
+  assert.equal(toCSV([{ a: ',' }], ['a']), 'a\n","\n')
+})
+
+test('toCSV quotes LF, CR and CRLF verbatim', () => {
+  assert.equal(toCSV([{ a: 'x\ny' }], ['a']), 'a\n"x\ny"\n')
+  assert.equal(toCSV([{ a: 'x\ry' }], ['a']), 'a\n"x\ry"\n')
+  assert.equal(toCSV([{ a: 'x\r\ny' }], ['a']), 'a\n"x\r\ny"\n')
+})
+
+test('toCSV quotes header names with the same rules', () => {
+  assert.equal(toCSV([{ 'a,b': 1, 'c"d': 2 }], ['a,b', 'c"d']), '"a,b","c""d"\n1,2\n')
+})
+
+test('toCSV leaves plain values unquoted', () => {
+  const row = { a: '', b: 0, c: ' pad ', d: 'tab\t;semi', e: 'café ✓', f: null, g: undefined, h: 12.5 }
+  assert.equal(toCSV([row], Object.keys(row)), 'a,b,c,d,e,f,g,h\n,0, pad ,tab\t;semi,café ✓,,,12.5\n')
+})
diff --git a/test/money.test.js b/test/money.test.js
index 917bae5..46dc686 100644
--- a/test/money.test.js
+++ b/test/money.test.js
@@ -22,3 +22,46 @@ test('applyDiscount', () => {
   assert.throws(() => applyDiscount(1_000, 101), RangeError)
   assert.throws(() => applyDiscount(1_000, -1), RangeError)
 })
+
+test('applyDiscount rounds half up to the nearest cent', () => {
+  assert.equal(applyDiscount(1_001, 15), 851)
+  assert.equal(applyDiscount(10, 15), 9)
+  assert.equal(applyDiscount(1, 50), 1)
+  assert.equal(applyDiscount(3, 50), 2)
+  assert.equal(applyDiscount(1, 49), 1)
+  assert.equal(applyDiscount(1, 51), 0)
+  assert.equal(applyDiscount(4, 12.5), 4)
+  assert.equal(applyDiscount(1_001, 0.5), 996)
+  assert.equal(applyDiscount(1_350, 10), 1_215)
+})
+
+test('applyDiscount is exact for non-integer percents and large amounts', () => {
+  assert.equal(applyDiscount(1_250, 0.04), 1_250)
+  assert.equal(applyDiscount(625, 1.04), 619)
+  assert.equal(applyDiscount(100, 1e-7), 100)
+  assert.equal(applyDiscount(Number.MAX_SAFE_INTEGER, 50), 4_503_599_627_370_496)
+  assert.equal(applyDiscount(Number.MAX_SAFE_INTEGER, 15), 7_656_119_366_529_842)
+})
+
+test('applyDiscount boundaries and negative amounts', () => {
+  for (const p of [0, 0.04, 50, 100]) {
+    assert.ok(Object.is(applyDiscount(0, p), 0))
+    assert.ok(Object.is(applyDiscount(-0, p), 0))
+  }
+  assert.equal(applyDiscount(12_345, 0), 12_345)
+  assert.equal(applyDiscount(12_345, 100), 0)
+  assert.ok(Object.is(applyDiscount(-5, 100), 0))
+  assert.equal(applyDiscount(-1, 50), -1)
+  assert.equal(applyDiscount(-10, 15), -9)
+  assert.equal(applyDiscount(-1_250, 0.04), -1_250)
+})
+
+test('applyDiscount rejects invalid cents and percent', () => {
+  assert.throws(() => applyDiscount(1.5, 10), RangeError)
+  assert.throws(() => applyDiscount(NaN, 10), RangeError)
+  assert.throws(() => applyDiscount(Infinity, 10), RangeError)
+  assert.throws(() => applyDiscount(2 ** 53, 10), RangeError)
+  assert.throws(() => applyDiscount(100, NaN), RangeError)
+  assert.throws(() => applyDiscount(100, 101), RangeError)
+  assert.throws(() => applyDiscount(100, -1), RangeError)
+})
