--- a/src/csv.js
+++ b/src/csv.js
@@ -1,13 +1,16 @@
 // Renders rows as CSV with a header line. Lines end with \n.
 export function toCSV(rows, columns) {
-  const lines = [columns.join(',')]
+  const lines = [columns.map(cell).join(',')]
   for (const row of rows) {
     lines.push(columns.map((column) => cell(row[column])).join(','))
   }
   return lines.join('\n') + '\n'
 }
 
+// Renders one field, quoting it per RFC 4180 when it holds a comma, quote, CR or LF.
 function cell(value) {
   if (value === null || value === undefined) return ''
-  return String(value)
+  const text = String(value)
+  if (/[",\r\n]/.test(text)) return '"' + text.replace(/"/g, '""') + '"'
+  return text
 }
diff --git a/src/money.js b/src/money.js
index 95a7ad7..5b686e3 100644
--- a/src/money.js
+++ b/src/money.js
@@ -12,8 +12,20 @@ export function formatUSD(cents) {
   return `${sign}$${dollars}.${rest}`
 }
 
-// Applies a percentage discount (0 to 100) to an amount in cents.
+// Applies a percentage discount (0 to 100) to cents, exact, rounded half up (ties away from zero if negative).
 export function applyDiscount(cents, percent) {
   if (!(percent >= 0 && percent <= 100)) throw new RangeError('percent must be between 0 and 100')
-  return Math.floor((cents * (100 - percent)) / 100)
+  if (cents < 0) return 0 - applyDiscount(-cents, percent)
+  // percent is the decimal written by String(percent), i.e. P / 10^k
+  const [mantissa, exp = '0'] = String(percent).split('e')
+  const [whole, frac = ''] = mantissa.split('.')
+  let P = BigInt(whole + frac)
+  let k = frac.length - Number(exp)
+  if (k < 0) {
+    P *= 10n ** BigInt(-k)
+    k = 0
+  }
+  const den = 100n * 10n ** BigInt(k)
+  const num = BigInt(cents) * (100n * 10n ** BigInt(k) - P)
+  return Number((2n * num + den) / (2n * den))
 }
