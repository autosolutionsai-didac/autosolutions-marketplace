diff --git a/test/csv.test.js b/test/csv.test.js
index 9603268..3f1d11c 100644
--- a/test/csv.test.js
+++ b/test/csv.test.js
@@ -13,3 +13,33 @@ test('toCSV renders a header and one line per row', () => {
 test('toCSV leaves missing values empty', () => {
   assert.equal(toCSV([{ a: null }], ['a', 'b']), 'a,b\n,\n')
 })
+
+test('toCSV quotes fields containing commas', () => {
+  assert.equal(toCSV([{ key: 'team, alpha', n: 1 }], ['key', 'n']), 'key,n\n"team, alpha",1\n')
+})
+
+test('toCSV doubles embedded double quotes', () => {
+  assert.equal(toCSV([{ a: 'say "hi"', b: '"' }], ['a', 'b']), 'a,b\n"say ""hi""",""""\n')
+})
+
+test('toCSV quotes fields with LF, CR and CRLF and preserves them', () => {
+  const rows = [{ a: 'a\nb', b: 'a\rb', c: 'a\r\nb' }]
+  assert.equal(toCSV(rows, ['a', 'b', 'c']), 'a,b,c\n"a\nb","a\rb","a\r\nb"\n')
+})
+
+test('toCSV handles several specials in one field', () => {
+  assert.equal(toCSV([{ a: 'a,"b"\nc' }], ['a']), 'a\n"a,""b""\nc"\n')
+})
+
+test('toCSV leaves fields without specials unquoted', () => {
+  const rows = [{ a: 'plain', b: 3000000, c: 0, d: false, e: '', f: '  \t ', g: 'café', h: undefined }]
+  assert.equal(toCSV(rows, ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h']), 'a,b,c,d,e,f,g,h\nplain,3000000,0,false,,  \t ,café,\n')
+})
+
+test('toCSV quotes header columns and stringifies non-string values', () => {
+  assert.equal(toCSV([{ 'x,y': [1, 2], 'q"': 'z' }], ['x,y', 'q"']), '"x,y","q"""\n"1,2",z\n')
+})
+
+test('toCSV with no rows gives only the header line', () => {
+  assert.equal(toCSV([], ['a', 'b']), 'a,b\n')
+})
diff --git a/test/money.test.js b/test/money.test.js
index 917bae5..158d982 100644
--- a/test/money.test.js
+++ b/test/money.test.js
@@ -22,3 +22,47 @@ test('applyDiscount', () => {
   assert.throws(() => applyDiscount(1_000, 101), RangeError)
   assert.throws(() => applyDiscount(1_000, -1), RangeError)
 })
+
+test('applyDiscount rounds half up to the nearest cent', () => {
+  assert.equal(applyDiscount(1001, 15), 851)
+  assert.equal(applyDiscount(10, 15), 9)
+  assert.equal(applyDiscount(1, 50), 1)
+  assert.equal(applyDiscount(3, 50), 2)
+  assert.equal(applyDiscount(1001, 10), 901)
+  assert.equal(applyDiscount(1004, 15), 853)
+})
+
+test('applyDiscount is exact for non-integer percents', () => {
+  assert.equal(applyDiscount(500, 99.9), 1)
+  assert.equal(applyDiscount(1500, 57.7), 635)
+  assert.equal(applyDiscount(3, 12.5), 3)
+  assert.equal(applyDiscount(20, 97.5), 1)
+  assert.equal(applyDiscount(1000, 1e-7), 1000)
+  assert.equal(applyDiscount(1, 1e-7), 1)
+  assert.equal(applyDiscount(1000, 5e-324), 1000)
+  assert.equal(applyDiscount(1000, 1.5e-7), 1000)
+})
+
+test('applyDiscount boundaries, large and negative values', () => {
+  assert.equal(applyDiscount(1001, 0), 1001)
+  assert.equal(applyDiscount(1001, 100), 0)
+  assert.equal(applyDiscount(0, 15), 0)
+  assert.equal(applyDiscount(1, 60), 0)
+  assert.equal(applyDiscount(9007199254740991, 50), 4503599627370496)
+  assert.equal(applyDiscount(-1001, 15), -851)
+  assert.equal(applyDiscount(-1, 60), 0)
+})
+
+test('applyDiscount still rejects out-of-range percents', () => {
+  for (const p of [101, -1, NaN, -0.0001, 100.0001]) {
+    assert.throws(() => applyDiscount(100, p), RangeError)
+  }
+})
+
+test('applyDiscount matches an exact integer reference', () => {
+  for (let c = 0; c <= 2000; c++) {
+    for (let p = 0; p <= 100; p++) {
+      assert.equal(applyDiscount(c, p), Math.floor((2 * c * (100 - p) + 100) / 200))
+    }
+  }
+})
