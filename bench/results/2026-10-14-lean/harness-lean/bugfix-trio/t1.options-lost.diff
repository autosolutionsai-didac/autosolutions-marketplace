--- a/test/csv.test.js
+++ b/test/csv.test.js
@@ -13,3 +13,23 @@ test('toCSV renders a header and one line per row', () => {
 test('toCSV leaves missing values empty', () => {
   assert.equal(toCSV([{ a: null }], ['a', 'b']), 'a,b\n,\n')
 })
+
+test('toCSV quotes fields containing a comma', () => {
+  assert.equal(toCSV([{ key: 'team, alpha', n: 1 }], ['key', 'n']), 'key,n\n"team, alpha",1\n')
+})
+
+test('toCSV doubles embedded double quotes', () => {
+  assert.equal(toCSV([{ a: 'say "hi"' }], ['a']), 'a\n"say ""hi"""\n')
+})
+
+test('toCSV quotes fields containing LF or CR', () => {
+  assert.equal(toCSV([{ a: 'a\nb', b: 'a\rb' }], ['a', 'b']), 'a,b\n"a\nb","a\rb"\n')
+})
+
+test('toCSV quotes header names that need it', () => {
+  assert.equal(toCSV([{ 'a,b': 1 }], ['a,b']), '"a,b"\n1\n')
+})
+
+test('toCSV leaves plain values unquoted', () => {
+  assert.equal(toCSV([{ a: 'two words', b: "it's", c: 5, d: '' }], ['a', 'b', 'c', 'd']), "a,b,c,d\ntwo words,it's,5,\n")
+})
