diff --git a/test/csv.test.js b/test/csv.test.js
index 9603268..ac97c99 100644
--- a/test/csv.test.js
+++ b/test/csv.test.js
@@ -13,3 +13,15 @@ test('toCSV renders a header and one line per row', () => {
 test('toCSV leaves missing values empty', () => {
   assert.equal(toCSV([{ a: null }], ['a', 'b']), 'a,b\n,\n')
 })
+
+test('toCSV quotes fields with commas, quotes and line breaks', () => {
+  assert.equal(toCSV([{ key: 'team, alpha', n: 1 }], ['key', 'n']), 'key,n\n"team, alpha",1\n')
+  assert.equal(toCSV([{ key: 'say "hi"', n: 2 }], ['key', 'n']), 'key,n\n"say ""hi""",2\n')
+  assert.equal(toCSV([{ key: 'a\nb', n: 3 }], ['key', 'n']), 'key,n\n"a\nb",3\n')
+  assert.equal(toCSV([{ key: 'a\rb', n: 4 }], ['key', 'n']), 'key,n\n"a\rb",4\n')
+  assert.equal(toCSV([{ key: 'plain', n: 5 }], ['key', 'n']), 'key,n\nplain,5\n')
+})
+
+test('toCSV quotes header names that contain special characters', () => {
+  assert.equal(toCSV([{ 'a,b': 1, c: 2 }], ['a,b', 'c']), '"a,b",c\n1,2\n')
+})
