diff --git a/test/server.test.js b/test/server.test.js
index fc813ff..00125bb 100644
--- a/test/server.test.js
+++ b/test/server.test.js
@@ -74,3 +74,16 @@ test('admin endpoints check the token', async () => {
   await close()
   delete process.env.LEDGER_ADMIN_TOKEN
 })
+
+test('GET /invoices/:key returns 404 for a key without usage', async () => {
+  const { base, close } = await start()
+  await post(base, 'acme')
+  const json = await fetch(`${base}/invoices/nobody`)
+  assert.equal(json.status, 404)
+  assert.deepEqual(await json.json(), { error: 'not_found' })
+  const csv = await fetch(`${base}/invoices/nobody?format=csv`)
+  assert.equal(csv.status, 404)
+  assert.deepEqual(await csv.json(), { error: 'not_found' })
+  assert.equal((await fetch(`${base}/invoices/other`)).status, 404)
+  await close()
+})
