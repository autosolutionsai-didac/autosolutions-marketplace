 // Renders rows as CSV with a header line. Lines end with \n.
 export function toCSV(rows, columns) {
-  const lines = [columns.join(',')]
+  const lines = [columns.map((column) => cell(column)).join(',')]
   for (const row of rows) {
     lines.push(columns.map((column) => cell(row[column])).join(','))
   }
   return lines.join('\n') + '\n'
 }
 
+// RFC 4180: quote fields containing comma, double quote, CR or LF; double inner quotes.
 function cell(value) {
   if (value === null || value === undefined) return ''
-  return String(value)
+  const text = String(value)
+  if (/[",\r\n]/.test(text)) return `"${text.replace(/"/g, '""')}"`
+  return text
 }
