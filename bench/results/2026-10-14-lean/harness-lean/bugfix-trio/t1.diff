   assert.throws(() => applyDiscount(1_000, -1), RangeError)
 })
+
+test('applyDiscount rounds half up to the nearest cent', () => {
+  assert.equal(applyDiscount(1_001, 15), 851)
+  assert.equal(applyDiscount(10, 15), 9)
+  assert.equal(applyDiscount(1, 15), 1)
+  assert.equal(applyDiscount(1, 60), 0)
+})
+
+test('applyDiscount rounds half up exactly for fractional percents', () => {
+  assert.equal(applyDiscount(125, 64.4), 45) // 125 x 35.6 / 100 = 44.5
+  assert.equal(applyDiscount(2_625, 0.4), 2_615) // 2614.5
+  assert.equal(applyDiscount(10_500, 0.9), 10_406) // 10405.5
+  assert.equal(applyDiscount(10, 12.5), 9) // 8.75
+})
