 // Applies a percentage discount (0 to 100) to an amount in cents.
+// The result is rounded half up to the nearest cent. The percent is taken as the
+// decimal it prints as (64.4, not 64.399...), and the math is done in exact integers
+// so float error can't push a half cent down.
 export function applyDiscount(cents, percent) {
   if (!(percent >= 0 && percent <= 100)) throw new RangeError('percent must be between 0 and 100')
-  return Math.floor((cents * (100 - percent)) / 100)
+  const { digits, scale } = toDecimal(Number(percent))
+  const whole = 100n * scale
+  // floor(cents * (whole - digits) / whole + 1/2)
+  const n = 2n * BigInt(cents) * (whole - digits) + whole
+  const d = 2n * whole
+  return Number(n / d - (n % d < 0n ? 1n : 0n))
+}
+
+// Splits a non-negative number into digits / scale using its shortest decimal form,
+// e.g. 64.4 -> 644n / 10n and 1e-7 -> 1n / 10000000n.
+function toDecimal(n) {
+  const [mantissa, exponent = '0'] = String(n).split('e')
+  const [int, fraction = ''] = mantissa.split('.')
+  return { digits: BigInt(int + fraction), scale: 10n ** BigInt(fraction.length - Number(exponent)) }
 }
