@@ -13,3 +13,21 @@ test('toCSV renders a header and one line per row', () => {
 test('toCSV leaves missing values empty', () => {
   assert.equal(toCSV([{ a: null }], ['a', 'b']), 'a,b\n,\n')
 })
+
+test('toCSV quotes fields containing a comma, header included', () => {
+  assert.equal(toCSV([{ key: 'team, alpha', n: 1 }], ['key', 'n']), 'key,n\n"team, alpha",1\n')
+  assert.equal(toCSV([{ 'a,b': 'x' }], ['a,b']), '"a,b"\nx\n')
+})
+
+test('toCSV doubles embedded double quotes and wraps the field', () => {
+  assert.equal(toCSV([{ v: 'say "hi"' }], ['v']), 'v\n"say ""hi"""\n')
+})
+
+test('toCSV keeps LF and CR inside quoted fields', () => {
+  assert.equal(toCSV([{ v: 'line1\nline2' }], ['v']), 'v\n"line1\nline2"\n')
+  assert.equal(toCSV([{ v: 'a\rb' }], ['v']), 'v\n"a\rb"\n')
+})
+
+test('toCSV leaves plain values and numbers unquoted', () => {
+  assert.equal(toCSV([{ a: 'plain', b: 42, c: '' }], ['a', 'b', 'c']), 'a,b,c\nplain,42,\n')
+})
