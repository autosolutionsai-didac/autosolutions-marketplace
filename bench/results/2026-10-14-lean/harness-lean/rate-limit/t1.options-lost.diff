@@ -0,0 +1,185 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createServer } from '../src/server.js'
+import { createRateLimiter } from '../src/rate-limit.js'
+import { Ledger } from '../src/ledger.js'
+
+async function start(options = {}) {
+  const clock = { t: 0 }
+  const server = createServer({ ledger: new Ledger(), now: () => clock.t, ...options })
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const base = `http://127.0.0.1:${server.address().port}`
+  const close = () => new Promise((resolve) => { server.closeAllConnections(); server.close(resolve) })
+  return { base, close, clock }
+}
+
+function get(base, path, key) {
+  return fetch(`${base}${path}`, { headers: key ? { 'x-api-key': key } : {} })
+}
+
+test('limiter allows up to the limit and counts remaining down to 0', () => {
+  const rl = createRateLimiter({ limit: 3, windowMs: 10000, now: () => 0 })
+  assert.deepEqual([1, 2, 3].map(() => rl.hit('a').remaining), [2, 1, 0])
+  assert.equal(rl.hit('a').allowed, false)
+  assert.equal(rl.hit('a').remaining, 0)
+})
+
+test('limiter rejection neither counts nor moves the window', () => {
+  let t = 0
+  const rl = createRateLimiter({ limit: 1, windowMs: 10000, now: () => t })
+  assert.equal(rl.hit('a').allowed, true)
+  t = 4000
+  assert.equal(rl.hit('a').retryAfter, 6)
+  t = 9000
+  assert.equal(rl.hit('a').retryAfter, 1)
+  t = 10000
+  assert.equal(rl.hit('a').allowed, true)
+})
+
+test('limiter retryAfter rounds up with a minimum of 1', () => {
+  let t = 0
+  const rl = createRateLimiter({ limit: 1, windowMs: 10000, now: () => t })
+  rl.hit('a')
+  t = 500
+  assert.equal(rl.hit('a').retryAfter, 10)
+  t = 9999
+  assert.equal(rl.hit('a').retryAfter, 1)
+})
+
+test('limiter starts a new window exactly at windowStart + windowMs', () => {
+  let t = 100
+  const rl = createRateLimiter({ limit: 1, windowMs: 1000, now: () => t })
+  assert.equal(rl.hit('a').allowed, true)
+  t = 1099
+  assert.equal(rl.hit('a').allowed, false)
+  t = 1100
+  const r = rl.hit('a')
+  assert.equal(r.allowed, true)
+  assert.equal(r.remaining, 0)
+})
+
+test('limiter keys are independent', () => {
+  const rl = createRateLimiter({ limit: 1, windowMs: 1000, now: () => 0 })
+  assert.equal(rl.hit('a').allowed, true)
+  assert.equal(rl.hit('a').allowed, false)
+  assert.equal(rl.hit('b').allowed, true)
+})
+
+test('third request gets 429 with Retry-After and body', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 2, windowMs: 10000 } })
+  for (const remaining of ['1', '0']) {
+    const ok = await get(base, '/nothing', 'k')
+    assert.equal(ok.headers.get('x-ratelimit-limit'), '2')
+    assert.equal(ok.headers.get('x-ratelimit-remaining'), remaining)
+  }
+  const res = await get(base, '/nothing', 'k')
+  assert.equal(res.status, 429)
+  assert.equal(res.headers.get('retry-after'), '10')
+  assert.equal(res.headers.get('x-ratelimit-limit'), '2')
+  assert.equal(res.headers.get('x-ratelimit-remaining'), '0')
+  const body = await res.json()
+  assert.deepEqual(body, { error: 'rate_limited', retryAfter: 10 })
+  assert.equal(res.headers.get('retry-after'), String(body.retryAfter))
+  await close()
+})
+
+test('401 and 404 responses are counted and carry headers', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 3, windowMs: 10000 } })
+  const r1 = await fetch(`${base}/events`, { method: 'POST', body: '{}' })
+  assert.equal(r1.status, 401)
+  assert.equal(r1.headers.get('x-ratelimit-limit'), '3')
+  assert.equal(r1.headers.get('x-ratelimit-remaining'), '2')
+  const r2 = await get(base, '/nope')
+  assert.equal(r2.status, 404)
+  assert.equal(r2.headers.get('x-ratelimit-remaining'), '1')
+  await close()
+})
+
+test('missing keys share anonymous bucket; different keys are independent', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1, windowMs: 10000 } })
+  assert.equal((await get(base, '/nope')).status, 404)
+  assert.equal((await get(base, '/nope')).status, 429)
+  assert.equal((await get(base, '/nope', 'a')).status, 404)
+  assert.equal((await get(base, '/nope', 'b')).status, 404)
+  assert.equal((await get(base, '/nope', 'a')).status, 429)
+  await close()
+})
+
+test('GET /health is exempt, uncounted and has no rate-limit headers', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1, windowMs: 10000 } })
+  await get(base, '/nope')
+  await get(base, '/nope', 'a')
+  assert.equal((await get(base, '/nope')).status, 429)
+  assert.equal((await get(base, '/nope', 'a')).status, 429)
+  for (let i = 0; i < 3; i++) {
+    const res = await get(base, '/health?x=1', 'a')
+    assert.equal(res.status, 200)
+    assert.equal(res.headers.get('x-ratelimit-limit'), null)
+    assert.equal(res.headers.get('x-ratelimit-remaining'), null)
+  }
+  const anon = await get(base, '/health')
+  assert.equal(anon.status, 200)
+  assert.equal(anon.headers.get('x-ratelimit-limit'), null)
+  assert.equal((await get(base, '/nope', 'b')).status, 404)
+  await close()
+})
+
+test('GET /health does not consume quota from a fresh bucket', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 2, windowMs: 10000 } })
+  try {
+    for (let i = 0; i < 5; i++) {
+      assert.equal((await get(base, '/health', 'c')).status, 200)
+      assert.equal((await get(base, '/health')).status, 200)
+    }
+    const keyed = await get(base, '/nope', 'c')
+    assert.equal(keyed.status, 404)
+    assert.equal(keyed.headers.get('x-ratelimit-remaining'), '1')
+    const anon = await get(base, '/nope')
+    assert.equal(anon.status, 404)
+    assert.equal(anon.headers.get('x-ratelimit-remaining'), '1')
+  } finally {
+    await close()
+  }
+})
+
+test('new window allows requests again', async () => {
+  const { base, close, clock } = await start({ rateLimit: { limit: 1, windowMs: 10000 } })
+  assert.equal((await get(base, '/nope')).status, 404)
+  clock.t = 9999
+  assert.equal((await get(base, '/nope')).status, 429)
+  clock.t = 10000
+  const res = await get(base, '/nope')
+  assert.equal(res.status, 404)
+  assert.equal(res.headers.get('x-ratelimit-remaining'), '0')
+  await close()
+})
+
+test('default limit is 60', async () => {
+  const { base, close } = await start()
+  const res = await get(base, '/nope')
+  assert.equal(res.headers.get('x-ratelimit-limit'), '60')
+  assert.equal(res.headers.get('x-ratelimit-remaining'), '59')
+  await close()
+})
+
+test('partial override keeps windowMs at 60000', async () => {
+  const { base, close, clock } = await start({ rateLimit: { limit: 1 } })
+  await get(base, '/nope')
+  const res = await get(base, '/nope')
+  assert.equal(res.status, 429)
+  assert.equal(res.headers.get('retry-after'), '60')
+  clock.t = 59999
+  assert.equal((await get(base, '/nope')).status, 429)
+  clock.t = 60000
+  assert.equal((await get(base, '/nope')).status, 404)
+  await close()
+})
+
+test('state is per server instance', async () => {
+  const a = await start({ rateLimit: { limit: 1 } })
+  const b = await start({ rateLimit: { limit: 1 } })
+  assert.equal((await get(a.base, '/nope')).status, 404)
+  assert.equal((await get(b.base, '/nope')).status, 404)
+  await a.close()
+  await b.close()
+})

