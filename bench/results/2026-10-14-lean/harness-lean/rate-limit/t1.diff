@@ -0,0 +1,21 @@
+// Fixed-window request limiter. Each instance keeps its own per-key state.
+export function createRateLimiter({ limit = 60, windowMs = 60_000, now = Date.now } = {}) {
+  const windows = new Map()
+
+  return {
+    hit(key) {
+      const t = now()
+      let w = windows.get(key)
+      if (!w || t >= w.windowStart + windowMs) {
+        w = { windowStart: t, count: 0 }
+        windows.set(key, w)
+      }
+      if (w.count < limit) {
+        w.count += 1
+        return { allowed: true, limit, remaining: limit - w.count, retryAfter: 0 }
+      }
+      const retryAfter = Math.max(1, Math.ceil((w.windowStart + windowMs - t) / 1000))
+      return { allowed: false, limit, remaining: 0, retryAfter }
+    },
+  }
+}
