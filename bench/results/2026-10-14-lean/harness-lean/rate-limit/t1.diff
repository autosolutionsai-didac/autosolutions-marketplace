+++ b/test/rate-limit.test.js
@@ -0,0 +1,197 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createServer } from '../src/server.js'
+import { createRateLimiter } from '../src/rate-limit.js'
+import { Ledger } from '../src/ledger.js'
+
+async function start(options = {}) {
+  const server = createServer({ ledger: new Ledger(), ...options })
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const base = `http://127.0.0.1:${server.address().port}`
+  const close = () => new Promise((resolve) => { server.closeAllConnections(); server.close(resolve) })
+  return { base, close }
+}
+
+function get(base, path, key) {
+  const headers = {}
+  if (key) headers['x-api-key'] = key
+  return fetch(`${base}${path}`, { headers })
+}
+
+function post(base, key, body = { model: 'claude-sonnet-5', usage: {} }) {
+  const headers = { 'content-type': 'application/json' }
+  if (key) headers['x-api-key'] = key
+  return fetch(`${base}/events`, { method: 'POST', headers, body: JSON.stringify(body) })
+}
+
+test('unit: allows up to limit per window, rejects the rest with remaining 0', () => {
+  let t = 1_000
+  const limiter = createRateLimiter({ limit: 2, windowMs: 10_000, now: () => t })
+  assert.deepEqual(limiter.hit('a'), { allowed: true, limit: 2, remaining: 1, retryAfter: 0 })
+  assert.deepEqual(limiter.hit('a'), { allowed: true, limit: 2, remaining: 0, retryAfter: 0 })
+  assert.deepEqual(limiter.hit('a'), { allowed: false, limit: 2, remaining: 0, retryAfter: 10 })
+  t = 3_500
+  assert.equal(limiter.hit('a').retryAfter, 8)
+  t = 10_999
+  assert.equal(limiter.hit('a').retryAfter, 1)
+})
+
+test('unit: rejections do not count and a new window starts at the request time', () => {
+  let t = 0
+  const limiter = createRateLimiter({ limit: 1, windowMs: 10_000, now: () => t })
+  assert.equal(limiter.hit('a').allowed, true)
+  t = 5_000
+  assert.equal(limiter.hit('a').allowed, false)
+  t = 10_000
+  assert.deepEqual(limiter.hit('a'), { allowed: true, limit: 1, remaining: 0, retryAfter: 0 })
+  t = 14_000
+  assert.equal(limiter.hit('a').allowed, false)
+})
+
+test('unit: defaults to 60 requests per 60 s window', () => {
+  const limiter = createRateLimiter({ now: () => 1_000 })
+  for (let i = 0; i < 60; i++) assert.equal(limiter.hit('a').allowed, true)
+  assert.deepEqual(limiter.hit('a'), { allowed: false, limit: 60, remaining: 0, retryAfter: 60 })
+})
+
+test('unit: each limiter instance has its own state', () => {
+  const one = createRateLimiter({ limit: 1, now: () => 1_000 })
+  const two = createRateLimiter({ limit: 1, now: () => 1_000 })
+  assert.equal(one.hit('a').allowed, true)
+  assert.equal(one.hit('a').allowed, false)
+  assert.equal(two.hit('a').allowed, true)
+})
+
+test('(a) default limit is 60 per key', async () => {
+  const { base, close } = await start({ now: () => 1_000 })
+  for (let i = 0; i < 60; i++) {
+    const res = await get(base, '/nope', 'acme')
+    assert.equal(res.status, 404)
+  }
+  const res = await get(base, '/nope', 'acme')
+  assert.equal(res.status, 429)
+  assert.equal(res.headers.get('x-ratelimit-limit'), '60')
+  assert.equal(res.headers.get('x-ratelimit-remaining'), '0')
+  await close()
+})
+
+test('(b) custom limit, Retry-After counts down and rejections do not count', async () => {
+  let t = 1_000
+  const { base, close } = await start({ now: () => t, rateLimit: { limit: 2, windowMs: 10_000 } })
+
+  const first = await get(base, '/nope', 'acme')
+  assert.equal(first.status, 404)
+  assert.equal(first.headers.get('x-ratelimit-limit'), '2')
+  assert.equal(first.headers.get('x-ratelimit-remaining'), '1')
+
+  const second = await get(base, '/nope', 'acme')
+  assert.equal(second.headers.get('x-ratelimit-remaining'), '0')
+
+  const third = await get(base, '/nope', 'acme')
+  assert.equal(third.status, 429)
+  assert.equal(third.headers.get('retry-after'), '10')
+  assert.equal(third.headers.get('x-ratelimit-limit'), '2')
+  assert.equal(third.headers.get('x-ratelimit-remaining'), '0')
+  assert.deepEqual(await third.json(), { error: 'rate_limited', retryAfter: 10 })
+
+  t += 2_500
+  const fourth = await get(base, '/nope', 'acme')
+  assert.equal(fourth.status, 429)
+  assert.equal(fourth.headers.get('retry-after'), '8')
+
+  t = 10_999
+  const fifth = await get(base, '/nope', 'acme')
+  assert.equal(fifth.headers.get('retry-after'), '1')
+  await close()
+})
+
+test('(c) a request at the window end starts a new window at its own time', async () => {
+  let t = 1_000
+  const { base, close } = await start({ now: () => t, rateLimit: { limit: 2, windowMs: 10_000 } })
+  await get(base, '/nope', 'acme')
+  await get(base, '/nope', 'acme')
+  assert.equal((await get(base, '/nope', 'acme')).status, 429)
+
+  t = 11_000
+  const reset = await get(base, '/nope', 'acme')
+  assert.equal(reset.status, 404)
+  assert.equal(reset.headers.get('x-ratelimit-remaining'), '1')
+
+  // Window is [11_000, 21_000), not aligned to multiples of windowMs.
+  t = 20_999
+  const inside = await get(base, '/nope', 'acme')
+  assert.equal(inside.headers.get('x-ratelimit-remaining'), '0')
+
+  t = 21_000
+  const next = await get(base, '/nope', 'acme')
+  assert.equal(next.headers.get('x-ratelimit-remaining'), '1')
+  await close()
+})
+
+test('(d) keys are independent and missing keys share the anonymous bucket', async () => {
+  const { base, close } = await start({ now: () => 1_000, rateLimit: { limit: 1 } })
+  assert.equal((await get(base, '/nope', 'a')).status, 404)
+  assert.equal((await get(base, '/nope', 'a')).status, 429)
+  assert.equal((await get(base, '/nope', 'b')).status, 404)
+
+  assert.equal((await get(base, '/nope', null)).status, 404)
+  assert.equal((await get(base, '/nope', null)).status, 429)
+  await close()
+})
+
+test('(e) 400, 401 and 404 count toward the limit and then get 429 before auth or routing', async () => {
+  const { base, close } = await start({ now: () => 1_000, rateLimit: { limit: 2 } })
+
+  const unauthorized = await post(base, null)
+  assert.equal(unauthorized.status, 401)
+  assert.equal(unauthorized.headers.get('x-ratelimit-remaining'), '1')
+
+  const notFound = await get(base, '/nope', null)
+  assert.equal(notFound.status, 404)
+  assert.equal(notFound.headers.get('x-ratelimit-remaining'), '0')
+
+  const limited = await post(base, null)
+  assert.equal(limited.status, 429)
+  assert.deepEqual(await limited.json(), { error: 'rate_limited', retryAfter: 60 })
+
+  const invalid = await post(base, 'acme', { model: 'nope', usage: {} })
+  assert.equal(invalid.status, 400)
+  assert.equal(invalid.headers.get('x-ratelimit-remaining'), '1')
+  await close()
+})
+
+test('(f) GET /health is never limited, has no rate-limit headers and uses no quota', async () => {
+  const { base, close } = await start({ now: () => 1_000, rateLimit: { limit: 2 } })
+  for (let i = 0; i < 50; i++) {
+    const res = await get(base, '/health', 'acme')
+    assert.equal(res.status, 200)
+    assert.deepEqual(await res.json(), { ok: true })
+    assert.equal(res.headers.get('x-ratelimit-limit'), null)
+    assert.equal(res.headers.get('x-ratelimit-remaining'), null)
+    assert.equal(res.headers.get('retry-after'), null)
+  }
+  const res = await get(base, '/nope', 'acme')
+  assert.equal(res.headers.get('x-ratelimit-remaining'), '1')
+  await close()
+})
+
+test('(g) with a frozen clock the window never expires', async () => {
+  const { base, close } = await start({ now: () => 1_000, rateLimit: { limit: 1, windowMs: 10_000 } })
+  assert.equal((await get(base, '/nope', 'acme')).status, 404)
+  for (let i = 0; i < 3; i++) {
+    const res = await get(base, '/nope', 'acme')
+    assert.equal(res.status, 429)
+    assert.equal(res.headers.get('retry-after'), '10')
+  }
+  await close()
+})
+
+test('(h) a partial option keeps the default 60 s window', async () => {
+  const { base, close } = await start({ now: () => 1_000, rateLimit: { limit: 1 } })
+  assert.equal((await get(base, '/nope', 'acme')).status, 404)
+  const res = await get(base, '/nope', 'acme')
+  assert.equal(res.status, 429)
+  assert.equal(res.headers.get('retry-after'), '60')
+  assert.equal(res.headers.get('x-ratelimit-limit'), '1')
+  await close()
+})

