+// Fixed-window rate limiter. State lives in a Map per limiter instance.
+// The clock is injected via `now` so callers and tests control time.
+
+export const DEFAULT_RATE_LIMIT = { limit: 60, windowMs: 60_000 }
+
+export function createRateLimiter({ limit, windowMs, now }) {
+  const windows = new Map()
+
+  function check(key) {
+    const t = now()
+    let entry = windows.get(key)
+    if (!entry || t >= entry.windowStart + windowMs) {
+      entry = { windowStart: t, count: 0 }
+      windows.set(key, entry)
+    }
+    if (entry.count < limit) {
+      entry.count++
+      return { allowed: true, limit, remaining: Math.max(0, limit - entry.count), retryAfter: 0 }
+    }
+    const retryAfter = Math.max(1, Math.ceil((entry.windowStart + windowMs - t) / 1000))
+    return { allowed: false, limit, remaining: 0, retryAfter }
+  }
+
+  return { check }
+}
