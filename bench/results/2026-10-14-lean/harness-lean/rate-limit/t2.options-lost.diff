+++ b/test/rate-limit.test.js
@@ -0,0 +1,166 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createServer } from '../src/server.js'
+import { Ledger } from '../src/ledger.js'
+import { createRateLimiter, DEFAULT_RATE_LIMIT } from '../src/rate-limit.js'
+
+async function start(options = {}) {
+  const clock = { t: 0 }
+  const server = createServer({ ledger: new Ledger(), now: () => clock.t, ...options })
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const base = `http://127.0.0.1:${server.address().port}`
+  const close = () => new Promise((resolve) => { server.closeAllConnections(); server.close(resolve) })
+  return { base, close, clock }
+}
+
+const get = (base, path, key) => fetch(`${base}${path}`, { headers: key ? { 'x-api-key': key } : {} })
+const postNoKey = (base) => fetch(`${base}/events`, { method: 'POST', body: '{}' })
+const hdr = (res) => ({
+  limit: res.headers.get('x-ratelimit-limit'),
+  remaining: res.headers.get('x-ratelimit-remaining'),
+  retryAfter: res.headers.get('retry-after'),
+})
+
+test('limit 3: allowed with decreasing remaining, then 429', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 3 } })
+  for (const remaining of ['2', '1', '0']) {
+    const res = await get(base, '/nope', 'k')
+    assert.equal(res.headers.get('x-ratelimit-limit'), '3')
+    assert.equal(res.headers.get('x-ratelimit-remaining'), remaining)
+    assert.equal(res.headers.get('retry-after'), null)
+  }
+  const res = await get(base, '/nope', 'k')
+  assert.equal(res.status, 429)
+  assert.deepEqual(await res.json(), { error: 'rate_limited', retryAfter: 60 })
+  assert.deepEqual(hdr(res), { limit: '3', remaining: '0', retryAfter: '60' })
+  await close()
+})
+
+test('Retry-After rounds up', async () => {
+  const { base, close, clock } = await start({ rateLimit: { limit: 1, windowMs: 10_000 } })
+  assert.equal((await get(base, '/x', 'k')).status, 404)
+  clock.t = 1_500
+  const a = await get(base, '/x', 'k')
+  assert.equal(a.status, 429)
+  assert.equal(a.headers.get('retry-after'), '9')
+  clock.t = 9_999
+  const b = await get(base, '/x', 'k')
+  assert.equal(b.headers.get('retry-after'), '1')
+  assert.deepEqual(await b.json(), { error: 'rate_limited', retryAfter: 1 })
+  await close()
+})
+
+test('window resets exactly at windowStart + windowMs', async () => {
+  const { base, close, clock } = await start({ rateLimit: { limit: 2, windowMs: 10_000 } })
+  clock.t = 500
+  await get(base, '/x', 'k')
+  await get(base, '/x', 'k')
+  clock.t = 10_499
+  assert.equal((await get(base, '/x', 'k')).status, 429)
+  clock.t = 10_500
+  const ok = await get(base, '/x', 'k')
+  assert.equal(ok.status, 404)
+  assert.equal(ok.headers.get('x-ratelimit-remaining'), '1')
+  await get(base, '/x', 'k')
+  clock.t = 12_000
+  const res = await get(base, '/x', 'k')
+  assert.equal(res.status, 429)
+  assert.equal(res.headers.get('retry-after'), '9')
+  await close()
+})
+
+test('keys are independent', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1 } })
+  await get(base, '/x', 'a')
+  assert.equal((await get(base, '/x', 'a')).status, 429)
+  const b = await get(base, '/x', 'b')
+  assert.equal(b.status, 404)
+  assert.equal(b.headers.get('x-ratelimit-remaining'), '0')
+  await close()
+})
+
+test('missing key shares the anonymous bucket, including 401 and 404', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 3 } })
+  const r1 = await postNoKey(base)
+  assert.equal(r1.status, 401)
+  assert.deepEqual(hdr(r1), { limit: '3', remaining: '2', retryAfter: null })
+  const r2 = await get(base, '/unknown')
+  assert.equal(r2.status, 404)
+  assert.equal(r2.headers.get('x-ratelimit-remaining'), '1')
+  const r3 = await get(base, '/unknown', 'anonymous')
+  assert.equal(r3.headers.get('x-ratelimit-remaining'), '0')
+  assert.equal((await get(base, '/unknown')).status, 429)
+  assert.equal((await postNoKey(base)).status, 429)
+  await close()
+})
+
+test('limited requests that would be 404 or 401 are counted then become 429', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1 } })
+  assert.equal((await get(base, '/nothing', 'j')).status, 404)
+  assert.equal((await get(base, '/nothing', 'j')).status, 429)
+  assert.equal((await postNoKey(base)).status, 401)
+  assert.equal((await postNoKey(base)).status, 429)
+  await close()
+})
+
+test('GET /health is exempt and has no rate-limit headers', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 2 } })
+  const check = async (path) => {
+    const res = await get(base, path)
+    assert.equal(res.status, 200)
+    assert.deepEqual(hdr(res), { limit: null, remaining: null, retryAfter: null })
+  }
+  await check('/health')
+  assert.equal((await get(base, '/x')).headers.get('x-ratelimit-remaining'), '1')
+  await check('/health?x=1')
+  assert.equal((await get(base, '/x')).headers.get('x-ratelimit-remaining'), '0')
+  assert.equal((await get(base, '/x')).status, 429)
+  await get(base, '/x', 'k')
+  await get(base, '/x', 'k')
+  assert.equal((await get(base, '/x', 'k')).status, 429)
+  await check('/health')
+  await check('/health')
+  const post = await fetch(`${base}/health`, { method: 'POST' })
+  assert.equal(post.status, 429)
+  await close()
+})
+
+test('defaults: 60 per 60s', async () => {
+  const { base, close } = await start()
+  let res
+  for (let i = 0; i < 60; i++) res = await get(base, '/x', 'k')
+  assert.equal(res.headers.get('x-ratelimit-limit'), '60')
+  assert.equal(res.headers.get('x-ratelimit-remaining'), '0')
+  res = await get(base, '/x', 'k')
+  assert.equal(res.status, 429)
+  assert.deepEqual(await res.json(), { error: 'rate_limited', retryAfter: 60 })
+  await close()
+})
+
+test('partial override keeps default windowMs', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 2 } })
+  await get(base, '/x', 'k')
+  await get(base, '/x', 'k')
+  const res = await get(base, '/x', 'k')
+  assert.equal(res.headers.get('x-ratelimit-limit'), '2')
+  assert.equal(res.headers.get('retry-after'), '60')
+  await close()
+})
+
+test('clock comes from options.now, not real time', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1, windowMs: 50 } })
+  await get(base, '/x', 'k')
+  await new Promise((resolve) => setTimeout(resolve, 120))
+  assert.equal((await get(base, '/x', 'k')).status, 429)
+  await close()
+})
+
+test('createRateLimiter check directly', () => {
+  assert.deepEqual(DEFAULT_RATE_LIMIT, { limit: 60, windowMs: 60_000 })
+  let t = 0
+  const limiter = createRateLimiter({ limit: 1, windowMs: 1_000, now: () => t })
+  assert.deepEqual(limiter.check('__proto__'), { allowed: true, limit: 1, remaining: 0, retryAfter: 0 })
+  t = 400
+  assert.deepEqual(limiter.check('__proto__'), { allowed: false, limit: 1, remaining: 0, retryAfter: 1 })
+  assert.equal(limiter.check('other').allowed, true)
+})

