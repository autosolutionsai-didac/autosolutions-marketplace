index 0000000..158a037
--- /dev/null
+++ b/src/rate-limit.js
@@ -0,0 +1,24 @@
+export const DEFAULT_RATE_LIMIT = { limit: 60, windowMs: 60_000 }
+
+// Fixed windows per key. A window starts at the first request for a key and
+// ends once now() >= windowStart + windowMs. Time comes only from the injected clock.
+export function createRateLimiter({ limit = 60, windowMs = 60_000, now = Date.now } = {}) {
+  const windows = new Map()
+
+  return {
+    check(key) {
+      const t = now()
+      let w = windows.get(key)
+      if (!w || t >= w.windowStart + windowMs) {
+        w = { windowStart: t, count: 0 }
+        windows.set(key, w)
+      }
+      if (w.count < limit) {
+        w.count++
+        return { allowed: true, limit, remaining: Math.max(0, limit - w.count), retryAfter: 0 }
+      }
+      const retryAfter = Math.max(1, Math.ceil((w.windowStart + windowMs - t) / 1000))
+      return { allowed: false, limit, remaining: 0, retryAfter }
+    },
+  }
+}
