@@ -0,0 +1,32 @@
+// Fixed-window limiter. Keys are independent; state lives in the returned closure.
+export function createRateLimiter({ limit = 60, windowMs = 60_000, now = Date.now } = {}) {
+  const entries = new Map()
+  let nextSweep = 0
+
+  function check(key) {
+    const t = now()
+
+    // Drop expired windows now and then so the Map cannot grow without bound.
+    // An expired entry behaves exactly like a missing one, so this changes nothing observable.
+    if (t >= nextSweep) {
+      for (const [k, e] of entries) if (t >= e.windowStart + windowMs) entries.delete(k)
+      nextSweep = t + windowMs
+    }
+
+    let entry = entries.get(key)
+    if (!entry || t >= entry.windowStart + windowMs) {
+      entry = { windowStart: t, count: 0 }
+      entries.set(key, entry)
+    }
+
+    if (entry.count < limit) {
+      entry.count++
+      return { allowed: true, limit, remaining: Math.max(0, limit - entry.count), retryAfter: 0 }
+    }
+
+    const retryAfter = Math.max(1, Math.ceil((entry.windowStart + windowMs - t) / 1000))
+    return { allowed: false, limit, remaining: 0, retryAfter }
+  }
+
+  return { check }
+}
