diff --git a/test/rate-limit.test.js b/test/rate-limit.test.js
new file mode 100644
index 0000000..aea0de2
--- /dev/null
+++ b/test/rate-limit.test.js
@@ -0,0 +1,216 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createServer } from '../src/server.js'
+import { Ledger } from '../src/ledger.js'
+import { createRateLimiter } from '../src/rate-limit.js'
+
+async function start(options = {}) {
+  const server = createServer({ ledger: new Ledger(), now: () => 1_000, ...options })
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const base = `http://127.0.0.1:${server.address().port}`
+  const close = () => new Promise((resolve) => { server.closeAllConnections(); server.close(resolve) })
+  return { base, close }
+}
+
+const event = { model: 'claude-sonnet-5', usage: { inputTokens: 1_000, outputTokens: 100 } }
+
+function post(base, key, body = event) {
+  const headers = { 'content-type': 'application/json' }
+  if (key) headers['x-api-key'] = key
+  return fetch(`${base}/events`, { method: 'POST', headers, body: JSON.stringify(body) })
+}
+
+test('limiter allows `limit` calls and counts remaining down to 0', () => {
+  let t = 1_000
+  const rl = createRateLimiter({ limit: 2, windowMs: 10_000, now: () => t })
+  assert.deepEqual(rl.check('a'), { allowed: true, limit: 2, remaining: 1, retryAfter: 0 })
+  assert.deepEqual(rl.check('a'), { allowed: true, limit: 2, remaining: 0, retryAfter: 0 })
+})
+
+test('limiter rejects over-limit calls with retryAfter and does not consume quota', () => {
+  let t = 1_000
+  const rl = createRateLimiter({ limit: 2, windowMs: 10_000, now: () => t })
+  rl.check('a')
+  rl.check('a')
+  assert.deepEqual(rl.check('a'), { allowed: false, limit: 2, remaining: 0, retryAfter: 10 })
+  t = 5_000
+  assert.equal(rl.check('a').retryAfter, 6)
+  t = 10_999
+  assert.deepEqual(rl.check('a'), { allowed: false, limit: 2, remaining: 0, retryAfter: 1 })
+  t = 11_000
+  // the rejected calls did not count, so the new window starts with one used
+  assert.deepEqual(rl.check('a'), { allowed: true, limit: 2, remaining: 1, retryAfter: 0 })
+})
+
+test('a new window starts exactly at windowStart + windowMs', () => {
+  let t = 1_000
+  const rl = createRateLimiter({ limit: 1, windowMs: 1_000, now: () => t })
+  assert.equal(rl.check('a').allowed, true)
+  t = 1_999
+  assert.equal(rl.check('a').allowed, false)
+  t = 2_000
+  assert.deepEqual(rl.check('a'), { allowed: true, limit: 1, remaining: 0, retryAfter: 0 })
+})
+
+test('retryAfter rounds up and is at least 1', () => {
+  let t = 1_000
+  const rl = createRateLimiter({ limit: 1, windowMs: 10_000, now: () => t })
+  rl.check('a')
+  t = 1_500
+  assert.equal(rl.check('a').retryAfter, 10)
+  t = 10_999
+  assert.equal(rl.check('a').retryAfter, 1)
+})
+
+test('keys are independent', () => {
+  let t = 1_000
+  const rl = createRateLimiter({ limit: 1, windowMs: 10_000, now: () => t })
+  assert.equal(rl.check('a').allowed, true)
+  assert.equal(rl.check('a').allowed, false)
+  assert.equal(rl.check('b').allowed, true)
+})
+
+test('server returns 429 after limit per x-api-key with Retry-After and body', async () => {
+  let t = 1_000
+  const { base, close } = await start({ rateLimit: { limit: 2, windowMs: 10_000 }, now: () => t })
+  const first = await post(base, 'acme')
+  assert.equal(first.status, 201)
+  assert.equal(first.headers.get('x-ratelimit-limit'), '2')
+  assert.equal(first.headers.get('x-ratelimit-remaining'), '1')
+  const second = await post(base, 'acme')
+  assert.equal(second.status, 201)
+  assert.equal(second.headers.get('x-ratelimit-remaining'), '0')
+  const third = await post(base, 'acme')
+  assert.equal(third.status, 429)
+  assert.equal(third.headers.get('retry-after'), '10')
+  assert.equal(third.headers.get('x-ratelimit-remaining'), '0')
+  assert.deepEqual(await third.json(), { error: 'rate_limited', retryAfter: 10 })
+  await close()
+})
+
+test('Retry-After counts the seconds left in the window, rounded up, at least 1', async () => {
+  let t = 1_000
+  const { base, close } = await start({ rateLimit: { limit: 1, windowMs: 10_000 }, now: () => t })
+  assert.equal((await post(base, 'acme')).status, 201)
+  t = 1_500
+  const mid = await post(base, 'acme')
+  assert.equal(mid.status, 429)
+  assert.equal(mid.headers.get('retry-after'), '10')
+  t = 10_999
+  const late = await post(base, 'acme')
+  assert.equal(late.headers.get('retry-after'), '1')
+  await close()
+})
+
+test('after windowMs passes the key is allowed again with remaining reset', async () => {
+  let t = 1_000
+  const { base, close } = await start({ rateLimit: { limit: 2, windowMs: 10_000 }, now: () => t })
+  await post(base, 'acme')
+  await post(base, 'acme')
+  assert.equal((await post(base, 'acme')).status, 429)
+  t += 10_000
+  const res = await post(base, 'acme')
+  assert.equal(res.status, 201)
+  assert.equal(res.headers.get('x-ratelimit-remaining'), '1')
+  await close()
+})
+
+test('different keys have their own counters', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1, windowMs: 10_000 } })
+  assert.equal((await post(base, 'acme')).status, 201)
+  assert.equal((await post(base, 'acme')).status, 429)
+  const other = await post(base, 'beta')
+  assert.equal(other.status, 201)
+  assert.equal(other.headers.get('x-ratelimit-remaining'), '0')
+  await close()
+})
+
+test('requests without x-api-key share the anonymous key, and over-limit gets 429 not 401 or 404', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 2, windowMs: 10_000 } })
+  const unauth = await post(base, null)
+  assert.equal(unauth.status, 401)
+  assert.equal(unauth.headers.get('x-ratelimit-remaining'), '1')
+  const missing = await fetch(`${base}/nope`)
+  assert.equal(missing.status, 404)
+  assert.equal(missing.headers.get('x-ratelimit-remaining'), '0')
+  const over = await post(base, null)
+  assert.equal(over.status, 429)
+  assert.deepEqual(await over.json(), { error: 'rate_limited', retryAfter: 10 })
+  const overMissing = await fetch(`${base}/nope`)
+  assert.equal(overMissing.status, 429)
+  await close()
+})
+
+test('GET /health is never limited, counted or given rate-limit headers', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 2, windowMs: 10_000 } })
+  await post(base, null)
+  await fetch(`${base}/nope`)
+  assert.equal((await fetch(`${base}/nope`)).status, 429)
+  for (let i = 0; i < 5; i++) {
+    const res = await fetch(`${base}/health`)
+    assert.equal(res.status, 200)
+    assert.deepEqual(await res.json(), { ok: true })
+    assert.equal(res.headers.has('x-ratelimit-limit'), false)
+    assert.equal(res.headers.has('x-ratelimit-remaining'), false)
+  }
+  await close()
+})
+
+test('health calls do not consume the anonymous quota', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 2, windowMs: 10_000 } })
+  for (let i = 0; i < 5; i++) assert.equal((await fetch(`${base}/health`)).status, 200)
+  const first = await fetch(`${base}/nope`)
+  assert.equal(first.status, 404)
+  assert.equal(first.headers.get('x-ratelimit-remaining'), '1')
+  for (let i = 0; i < 5; i++) assert.equal((await fetch(`${base}/health`)).status, 200)
+  assert.equal((await fetch(`${base}/nope`)).status, 404)
+  assert.equal((await fetch(`${base}/nope`)).status, 429)
+  await close()
+})
+
+test('defaults allow 60 requests per window and reject the 61st', async () => {
+  const { base, close } = await start()
+  const first = await fetch(`${base}/nope`)
+  assert.equal(first.headers.get('x-ratelimit-limit'), '60')
+  for (let i = 1; i < 60; i++) assert.equal((await fetch(`${base}/nope`)).status, 404)
+  const over = await fetch(`${base}/nope`)
+  assert.equal(over.status, 429)
+  assert.equal(over.headers.get('retry-after'), '60')
+  await close()
+})
+
+test('headers are set on CSV and docs responses too', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 5, windowMs: 10_000 } })
+  await post(base, 'acme')
+  const csv = await fetch(`${base}/invoices/acme?format=csv`)
+  assert.equal(csv.status, 200)
+  assert.equal(csv.headers.get('x-ratelimit-limit'), '5')
+  assert.equal(csv.headers.get('x-ratelimit-remaining'), '4')
+  const doc = await fetch(`${base}/docs/api.md`)
+  assert.equal(doc.status, 200)
+  assert.equal(doc.headers.get('x-ratelimit-limit'), '5')
+  assert.equal(doc.headers.get('x-ratelimit-remaining'), '3')
+  await close()
+})
+
+test('the injected clock controls the window, not real time', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1, windowMs: 100 }, now: () => 1_000 })
+  assert.equal((await post(base, 'acme')).status, 201)
+  await new Promise((resolve) => setTimeout(resolve, 150))
+  const res = await post(base, 'acme')
+  assert.equal(res.status, 429)
+  assert.equal(res.headers.get('retry-after'), '1')
+  await close()
+})
+
+test('requests whose path fails to parse are still counted and limited', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1, windowMs: 10_000 } })
+  const first = await fetch(`${base}//`)
+  assert.equal(first.status, 500)
+  assert.equal(first.headers.get('x-ratelimit-limit'), '1')
+  assert.equal(first.headers.get('x-ratelimit-remaining'), '0')
+  const second = await fetch(`${base}//`)
+  assert.equal(second.status, 429)
+  assert.equal(second.headers.get('retry-after'), '10')
+  await close()
+})

