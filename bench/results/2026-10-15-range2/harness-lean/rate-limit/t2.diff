+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import net from 'node:net'
+import { createServer } from '../src/server.js'
+import { Ledger } from '../src/ledger.js'
+import { DEFAULT_RATE_LIMIT, createRateLimiter, resolveRateLimit } from '../src/rate-limit.js'
+
+async function start(options = {}) {
+  const server = createServer({ ledger: new Ledger(), now: () => 1_000, ...options })
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const base = `http://127.0.0.1:${server.address().port}`
+  const close = () => new Promise((resolve) => { server.closeAllConnections(); server.close(resolve) })
+  return { base, close }
+}
+
+async function request(base, path, { key, method = 'GET', body } = {}) {
+  const headers = {}
+  if (key !== undefined) headers['x-api-key'] = key
+  if (body !== undefined) headers['content-type'] = 'application/json'
+  const res = await fetch(`${base}${path}`, {
+    method,
+    headers,
+    body: body === undefined ? undefined : JSON.stringify(body),
+  })
+  return { status: res.status, headers: res.headers, text: await res.text() }
+}
+
+const event = { model: 'claude-sonnet-5', usage: { inputTokens: 1_000_000, outputTokens: 100_000 } }
+
+function post(base, key, body = event) {
+  return request(base, '/events', { key, method: 'POST', body })
+}
+
+test('defaults allow 60 requests per key per window, then 429', async () => {
+  const { base, close } = await start()
+  try {
+    for (let i = 1; i <= DEFAULT_RATE_LIMIT.limit; i++) {
+      const res = await request(base, '/nope', { key: 'k' })
+      assert.equal(res.status, 404)
+      assert.equal(res.headers.get('x-ratelimit-limit'), '60')
+      assert.equal(res.headers.get('x-ratelimit-remaining'), String(60 - i))
+    }
+    assert.equal((await request(base, '/nope', { key: 'k' })).status, 429)
+  } finally {
+    await close()
+  }
+})
+
+test('custom limit counts down remaining and then rejects', async () => {
+  let t = 0
+  const { base, close } = await start({ now: () => t, rateLimit: { limit: 3, windowMs: 10000 } })
+  try {
+    for (const remaining of ['2', '1', '0']) {
+      const res = await request(base, '/nope', { key: 'k' })
+      assert.equal(res.status, 404)
+      assert.equal(res.headers.get('x-ratelimit-remaining'), remaining)
+    }
+    const res = await request(base, '/nope', { key: 'k' })
+    assert.equal(res.status, 429)
+    assert.equal(res.headers.get('x-ratelimit-remaining'), '0')
+  } finally {
+    await close()
+  }
+})
+
+test('429 body and Retry-After match the time left in the window', async () => {
+  let t = 0
+  const { base, close } = await start({ now: () => t, rateLimit: { limit: 1, windowMs: 10000 } })
+  try {
+    assert.equal((await request(base, '/nope', { key: 'k' })).status, 404)
+    for (const [offset, retryAfter] of [[1, 10], [9001, 1], [9999, 1]]) {
+      t = offset
+      const res = await request(base, '/nope', { key: 'k' })
+      assert.equal(res.status, 429)
+      assert.equal(res.headers.get('content-type'), 'application/json')
+      assert.equal(res.text, `{"error":"rate_limited","retryAfter":${retryAfter}}`)
+      assert.deepEqual(JSON.parse(res.text), { error: 'rate_limited', retryAfter })
+      assert.equal(res.headers.get('retry-after'), String(retryAfter))
+    }
+  } finally {
+    await close()
+  }
+
+  t = 0
+  const short = await start({ now: () => t, rateLimit: { limit: 1, windowMs: 500 } })
+  try {
+    assert.equal((await request(short.base, '/nope', { key: 'k' })).status, 404)
+    t = 1
+    const res = await request(short.base, '/nope', { key: 'k' })
+    assert.equal(res.status, 429)
+    assert.deepEqual(JSON.parse(res.text), { error: 'rate_limited', retryAfter: 1 })
+    assert.equal(res.headers.get('retry-after'), '1')
+  } finally {
+    await short.close()
+  }
+})
+
+test('window boundary: old window until its end, new window starts at that moment', async () => {
+  let t = 0
