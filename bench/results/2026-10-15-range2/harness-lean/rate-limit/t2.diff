+export const DEFAULT_RATE_LIMIT = { limit: 60, windowMs: 60000 }
+
+// Fixed-window limiter keyed by string. All time comes from the injected `now`.
+export function createRateLimiter({ limit, windowMs, now }) {
+  assertPositiveInteger('limit', limit)
+  assertPositiveInteger('windowMs', windowMs)
+  const entries = new Map()
+
+  return {
+    hit(key) {
+      const t = now()
+      let entry = entries.get(key)
+      if (!entry || t >= entry.windowStart + windowMs) {
+        entry = { windowStart: t, count: 0 }
+        entries.set(key, entry)
+      }
+      if (entry.count < limit) {
+        entry.count += 1
+        return { allowed: true, limit, remaining: limit - entry.count, retryAfter: null }
+      }
+      const retryAfter = Math.max(1, Math.ceil((entry.windowStart + windowMs - t) / 1000))
+      return { allowed: false, limit, remaining: 0, retryAfter }
+    },
+  }
+}
+
+// Merges a partial rateLimit option over the defaults. Validation happens in createRateLimiter.
+export function resolveRateLimit(option) {
+  if (option === undefined) return { ...DEFAULT_RATE_LIMIT }
+  if (option === null || typeof option !== 'object' || Array.isArray(option)) {
+    throw new RangeError('rateLimit must be an object')
+  }
+  return { ...DEFAULT_RATE_LIMIT, ...option }
+}
+
+function assertPositiveInteger(name, value) {
+  if (!(Number.isSafeInteger(value) && value >= 1)) {
+    throw new RangeError(`${name} must be an integer between 1 and Number.MAX_SAFE_INTEGER`)
+  }
+}
