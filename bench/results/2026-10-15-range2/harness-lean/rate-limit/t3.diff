@@ -0,0 +1,41 @@
+const DEFAULTS = { limit: 60, windowMs: 60_000 }
+
+// Merges rateLimit options over the defaults and validates the result. Throws TypeError or RangeError.
+export function normalizeRateLimit(rateLimit = {}) {
+  if (rateLimit === null || typeof rateLimit !== 'object' || Array.isArray(rateLimit)) {
+    throw new TypeError('rateLimit must be an object')
+  }
+  const { limit = DEFAULTS.limit, windowMs = DEFAULTS.windowMs } = rateLimit
+  return { limit: positiveInteger('limit', limit), windowMs: positiveInteger('windowMs', windowMs) }
+}
+
+// Fixed-window limiter. Each key gets `limit` hits per window of `windowMs`, timed by the injected now().
+export function createRateLimiter({ limit, windowMs, now }) {
+  const options = normalizeRateLimit({ limit, windowMs })
+  const windows = new Map()
+
+  return {
+    hit(key) {
+      const t = now()
+      let entry = windows.get(key)
+      if (!entry || t >= entry.windowStart + options.windowMs) {
+        entry = { windowStart: t, count: 0 }
+        windows.set(key, entry)
+      }
+      if (entry.count < options.limit) {
+        entry.count += 1
+        return { allowed: true, limit: options.limit, remaining: options.limit - entry.count, retryAfter: 0 }
+      }
+      const retryAfter = Math.max(1, Math.ceil((entry.windowStart + options.windowMs - t) / 1000))
+      return { allowed: false, limit: options.limit, remaining: 0, retryAfter }
+    },
+  }
+}
+
+function positiveInteger(name, value) {
+  if (typeof value !== 'number') throw new TypeError(`${name} must be a number`)
+  if (!Number.isSafeInteger(value) || value < 1) {
+    throw new RangeError(`${name} must be an integer from 1 to ${Number.MAX_SAFE_INTEGER}`)
+  }
+  return value
+}
