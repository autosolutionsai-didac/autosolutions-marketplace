@@ -0,0 +1,382 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createServer } from '../src/server.js'
+import { createRateLimiter } from '../src/rate-limit.js'
+import { Ledger } from '../src/ledger.js'
+
+async function start(options = {}) {
+  const clock = { t: 1_000 }
+  const server = createServer({ ledger: new Ledger(), now: () => clock.t, ...options })
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const base = `http://127.0.0.1:${server.address().port}`
+  const close = () => new Promise((resolve) => { server.closeAllConnections(); server.close(resolve) })
+  return { base, close, clock }
+}
+
+function get(base, path, key) {
+  const headers = key === undefined ? {} : { 'x-api-key': key }
+  return fetch(`${base}${path}`, { headers })
+}
+
+function post(base, key, body = {}) {
+  const headers = { 'content-type': 'application/json' }
+  if (key !== undefined) headers['x-api-key'] = key
+  return fetch(`${base}/events`, { method: 'POST', headers, body: JSON.stringify(body) })
+}
+
+// Reads the body so the connection is released, then returns the response.
+async function settle(res) {
+  await res.text()
+  return res
+}
+
+function clockedLimiter(options) {
+  const clock = { t: 0 }
+  return { clock, limiter: createRateLimiter({ ...options, now: () => clock.t }) }
+}
+
+test('limiter allows the first limit requests and rejects the next', () => {
+  const { clock, limiter } = clockedLimiter({ limit: 3, windowMs: 1_000 })
+  assert.deepEqual(limiter.check('a'), { allowed: true, limit: 3, remaining: 2, retryAfter: 0 })
+  assert.deepEqual(limiter.check('a'), { allowed: true, limit: 3, remaining: 1, retryAfter: 0 })
+  assert.deepEqual(limiter.check('a'), { allowed: true, limit: 3, remaining: 0, retryAfter: 0 })
+  clock.t = 10
+  assert.deepEqual(limiter.check('a'), { allowed: false, limit: 3, remaining: 0, retryAfter: 1 })
+  assert.deepEqual(limiter.check('a'), { allowed: false, limit: 3, remaining: 0, retryAfter: 1 })
+})
+
+test('limiter starts the window at the first request, not an aligned epoch', () => {
+  const { clock, limiter } = clockedLimiter({ limit: 1, windowMs: 1_000 })
+  clock.t = 1_500
+  assert.equal(limiter.check('a').allowed, true)
+  clock.t = 2_499
+  assert.equal(limiter.check('a').allowed, false)
+  clock.t = 2_500
+  assert.equal(limiter.check('a').allowed, true)
+})
+
+test('limiter window boundary: rejected at start + windowMs - 1, new window at start + windowMs', () => {
+  const { clock, limiter } = clockedLimiter({ limit: 2, windowMs: 1_000 })
+  clock.t = 0
+  limiter.check('a')
+  limiter.check('a')
+  clock.t = 999
+  assert.equal(limiter.check('a').allowed, false)
+  clock.t = 1_000
+  assert.deepEqual(limiter.check('a'), { allowed: true, limit: 2, remaining: 1, retryAfter: 0 })
+})
+
+test('limiter rejected requests do not extend or reset the window', () => {
+  const { clock, limiter } = clockedLimiter({ limit: 1, windowMs: 1_000 })
+  limiter.check('a')
+  clock.t = 500
+  assert.equal(limiter.check('a').allowed, false)
+  clock.t = 999
+  assert.equal(limiter.check('a').allowed, false)
+  clock.t = 1_000
+  assert.equal(limiter.check('a').allowed, true)
+})
+
+test('limiter retryAfter is rounded up to whole seconds, minimum 1', () => {
+  const long = clockedLimiter({ limit: 1, windowMs: 60_000 })
+  long.limiter.check('a')
+  long.clock.t = 1_500
+  assert.equal(long.limiter.check('a').retryAfter, 59)
+
+  const short = clockedLimiter({ limit: 1, windowMs: 500 })
+  short.limiter.check('a')
+  assert.equal(short.limiter.check('a').retryAfter, 1)
+  short.clock.t = 499
+  assert.equal(short.limiter.check('a').retryAfter, 1)
+})
+
+test('limiter keys have independent buckets', () => {
+  const { limiter } = clockedLimiter({ limit: 1, windowMs: 1_000 })
+  assert.equal(limiter.check('a').allowed, true)
+  assert.equal(limiter.check('a').allowed, false)
+  assert.equal(limiter.check('b').allowed, true)
+  assert.equal(limiter.check('__proto__').allowed, true)
+})
+
+test('limiter reads time only from the injected clock, never Date.now', () => {
+  const realNow = Date.now
+  Date.now = () => { throw new Error('Date.now called') }
+  try {
+    const { limiter } = clockedLimiter({ limit: 1, windowMs: 1_000 })
+    assert.equal(limiter.check('a').allowed, true)
+  } finally {
+    Date.now = realNow
+  }
+})
+
+test('createRateLimiter validates options with TypeError and RangeError', () => {
+  for (const limit of ['60', NaN, null, true]) {
+    assert.throws(() => createRateLimiter({ limit }), TypeError)
+  }
+  for (const limit of [0, -1, 1.5, Infinity, -Infinity, Number.MAX_SAFE_INTEGER + 1]) {
+    assert.throws(() => createRateLimiter({ limit }), RangeError)
+  }
+  for (const windowMs of ['1000', NaN]) {
+    assert.throws(() => createRateLimiter({ windowMs }), TypeError)
+  }
+  for (const windowMs of [0, -5, 2.5, Infinity]) {
+    assert.throws(() => createRateLimiter({ windowMs }), RangeError)
+  }
+  assert.throws(() => createRateLimiter({ now: 1_000 }), TypeError)
+  assert.throws(() => createRateLimiter({ now: 'clock' }), TypeError)
+  assert.doesNotThrow(() => createRateLimiter({ limit: Number.MAX_SAFE_INTEGER, windowMs: 1 }))
+})
+
+test('429 responses are counted per request, with countdown headers', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 3 } })
+  const seen = []
+  for (let i = 0; i < 5; i++) {
+    const res = await settle(await get(base, '/nope', 'acme'))
+    seen.push([res.status, res.headers.get('x-ratelimit-limit'), res.headers.get('x-ratelimit-remaining')])
+  }
+  assert.deepEqual(seen, [
+    [404, '3', '2'],
+    [404, '3', '1'],
+    [404, '3', '0'],
+    [429, '3', '0'],
+    [429, '3', '0'],
+  ])
+  await close()
+})
+
+test('the limit+1-th request gets 429 with an exact body and JSON content type', async () => {
+  const { base, close, clock } = await start({ rateLimit: { limit: 2, windowMs: 60_000 } })
+  await settle(await get(base, '/health', undefined))
+  await settle(await get(base, '/nope', 'k'))
+  await settle(await get(base, '/nope', 'k'))
+  clock.t = 2_500
+  const res = await get(base, '/nope', 'k')
+  assert.equal(res.status, 429)
+  assert.match(res.headers.get('content-type'), /^application\/json/)
+  assert.equal(res.headers.get('retry-after'), '59')
+  assert.equal(await res.text(), '{"error":"rate_limited","retryAfter":59}')
+  await close()
+})
+
+test('Retry-After header equals the body retryAfter', async () => {
+  const { base, close, clock } = await start({ rateLimit: { limit: 1, windowMs: 500 } })
+  await settle(await get(base, '/nope', 'k'))
+  const res = await get(base, '/nope', 'k')
+  const body = await res.json()
+  assert.equal(res.status, 429)
+  assert.equal(res.headers.get('retry-after'), String(body.retryAfter))
+  assert.equal(body.retryAfter, 1)
+  clock.t = 1_500
+  const later = await get(base, '/nope', 'k')
+  assert.equal(later.status, 404)
+  await close()
+})
+
+test('HTTP window boundary: still limited at start + windowMs - 1, new window at start + windowMs', async () => {
+  const { base, close, clock } = await start({ rateLimit: { limit: 2, windowMs: 1_000 } })
+  await settle(await get(base, '/nope', 'k'))
+  await settle(await get(base, '/nope', 'k'))
+  clock.t = 1_999
+  const limited = await get(base, '/nope', 'k')
+  assert.equal(limited.status, 429)
+  assert.equal(limited.headers.get('retry-after'), '1')
+  await settle(limited)
+  clock.t = 2_000
+  const fresh = await get(base, '/nope', 'k')
+  assert.equal(fresh.status, 404)
+  assert.equal(fresh.headers.get('x-ratelimit-remaining'), '1')
+  await close()
+})
+
+test('separate keys have independent buckets', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1 } })
+  assert.equal((await settle(await get(base, '/nope', 'a'))).status, 404)
+  assert.equal((await settle(await get(base, '/nope', 'a'))).status, 429)
+  assert.equal((await settle(await get(base, '/nope', 'b'))).status, 404)
+  await close()
+})
+
+test('missing and empty x-api-key share the anonymous bucket', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 2 } })
+  assert.equal((await settle(await get(base, '/nope', undefined))).headers.get('x-ratelimit-remaining'), '1')
+  assert.equal((await settle(await get(base, '/nope', ''))).headers.get('x-ratelimit-remaining'), '0')
+  assert.equal((await settle(await get(base, '/nope', undefined))).status, 429)
+  await close()
+})
+
+test('a literal "anonymous" key maps to the same bucket as a missing key', async () => {
+  // Documents the mapping from the spec: the key is the raw header, so this collides with the fallback.
+  const { base, close } = await start({ rateLimit: { limit: 1 } })
+  assert.equal((await settle(await get(base, '/nope', undefined))).status, 404)
+  assert.equal((await settle(await get(base, '/nope', 'anonymous'))).status, 429)
+  await close()
+})
+
+test('POST /events without a key (401) and unknown paths (404) are counted and carry headers', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 2 } })
+  const first = await post(base, undefined, {})
+  assert.equal(first.status, 401)
+  assert.equal(first.headers.get('x-ratelimit-limit'), '2')
+  assert.equal(first.headers.get('x-ratelimit-remaining'), '1')
+  await settle(first)
+  const second = await get(base, '/nope', undefined)
+  assert.equal(second.status, 404)
+  assert.equal(second.headers.get('x-ratelimit-remaining'), '0')
+  await settle(second)
+  await close()
+})
+
+test('a 429 is returned instead of a 401 or 404 once the limit is exceeded', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1 } })
+  await settle(await get(base, '/nope', undefined))
+  const unauth = await post(base, undefined, {})
+  assert.equal(unauth.status, 429)
+  assert.deepEqual(await unauth.json(), { error: 'rate_limited', retryAfter: 60 })
+  await close()
+})
+
+test('the limiter runs before routing for valid requests too', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1 } })
+  const body = { model: 'claude-sonnet-5', usage: { inputTokens: 1_000, outputTokens: 100 } }
+  assert.equal((await settle(await post(base, 'acme', body))).status, 201)
+  const res = await post(base, 'acme', body)
+  assert.equal(res.status, 429)
+  await close()
+})
+
+test('GET /health is never limited, has no rate-limit headers and does not consume quota', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 2 } })
+  for (let i = 0; i < 10; i++) {
+    const res = await get(base, i % 2 ? '/health?x=1' : '/health', 'k')
+    assert.equal(res.status, 200)
+    assert.deepEqual(await res.json(), { ok: true })
+    assert.equal(res.headers.get('x-ratelimit-limit'), null)
+    assert.equal(res.headers.get('x-ratelimit-remaining'), null)
+    assert.equal(res.headers.get('retry-after'), null)
+  }
+  const res = await get(base, '/nope', 'k')
+  assert.equal(res.status, 404)
+  assert.equal(res.headers.get('x-ratelimit-remaining'), '1')
+  await settle(res)
+  await close()
+})
+
+test('HEAD and POST to /health are limited and still 404', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1 } })
+  const head = await fetch(`${base}/health`, { method: 'HEAD', headers: { 'x-api-key': 'k' } })
+  assert.equal(head.status, 404)
+  assert.equal(head.headers.get('x-ratelimit-remaining'), '0')
+  const post429 = await settle(await fetch(`${base}/health`, { method: 'POST', headers: { 'x-api-key': 'k' } }))
+  assert.equal(post429.status, 429)
+  await close()
+})
+
+test('default limit is 60 when rateLimit is omitted', async () => {
+  const { base, close } = await start()
+  for (let i = 1; i <= 60; i++) {
+    const res = await settle(await get(base, '/nope', 'k'))
+    assert.equal(res.status, 404, `request ${i}`)
+    assert.equal(res.headers.get('x-ratelimit-limit'), '60')
+  }
+  const res = await settle(await get(base, '/nope', 'k'))
+  assert.equal(res.status, 429)
+  await close()
+})
+
+test('partial options keep the default windowMs of 60000', async () => {
+  const { base, close, clock } = await start({ rateLimit: { limit: 2 } })
+  await settle(await get(base, '/nope', 'k'))
+  await settle(await get(base, '/nope', 'k'))
+  clock.t = 60_999
+  const limited = await get(base, '/nope', 'k')
+  assert.equal(limited.status, 429)
+  assert.equal(limited.headers.get('retry-after'), '1')
+  await settle(limited)
+  clock.t = 61_000
+  assert.equal((await settle(await get(base, '/nope', 'k'))).status, 404)
+  await close()
+})
+
+test('partial options: windowMs alone keeps the default limit of 60', async () => {
+  const { base, close } = await start({ rateLimit: { windowMs: 1_000 } })
+  const res = await settle(await get(base, '/nope', 'k'))
+  assert.equal(res.headers.get('x-ratelimit-limit'), '60')
+  assert.equal(res.headers.get('x-ratelimit-remaining'), '59')
+  await close()
+})
+
+test('explicit undefined fields fall back to defaults', async () => {
+  const { base, close } = await start({ rateLimit: { limit: undefined, windowMs: undefined } })
+  const res = await settle(await get(base, '/nope', 'k'))
+  assert.equal(res.headers.get('x-ratelimit-limit'), '60')
+  await close()
+})
+
+test('limit: 1 works', async () => {
+  const { base, close } = await start({ rateLimit: { limit: 1 } })
+  const first = await settle(await get(base, '/nope', 'k'))
+  assert.equal(first.headers.get('x-ratelimit-remaining'), '0')
+  assert.equal((await settle(await get(base, '/nope', 'k'))).status, 429)
+  await close()
+})
+
+test('rejected requests do not extend the window over HTTP', async () => {
+  const { base, close, clock } = await start({ rateLimit: { limit: 1, windowMs: 1_000 } })
+  await settle(await get(base, '/nope', 'k'))
+  clock.t = 1_500
+  await settle(await get(base, '/nope', 'k'))
+  clock.t = 2_000
+  assert.equal((await settle(await get(base, '/nope', 'k'))).status, 404)
+  await close()
+})
+
+test('invalid rateLimit options throw from createServer', () => {
+  const bad = [
+    { limit: 0 },
+    { limit: -1 },
+    { limit: 1.5 },
+    { limit: NaN },
+    { limit: Infinity },
+    { limit: '60' },
+    { limit: null },
+    { limit: Number.MAX_SAFE_INTEGER + 1 },
+    { windowMs: 0 },
+    { windowMs: '1000' },
