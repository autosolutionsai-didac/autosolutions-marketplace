+// Fixed-window rate limiter. Each key gets `limit` requests per `windowMs`, counted from its first request in the window.
+export function createRateLimiter({ limit = 60, windowMs = 60_000, now = Date.now } = {}) {
+  checkInteger('limit', limit)
+  checkInteger('windowMs', windowMs)
+  if (typeof now !== 'function') throw new TypeError('now must be a function')
+
+  const windows = new Map()
+
+  return {
+    check(key) {
+      const t = now()
+      let entry = windows.get(key)
+      if (!entry || t >= entry.start + windowMs) {
+        entry = { start: t, count: 0 }
+        windows.set(key, entry)
+      }
+      if (entry.count < limit) {
+        entry.count += 1
+        return { allowed: true, limit, remaining: limit - entry.count, retryAfter: 0 }
+      }
+      const retryAfter = Math.max(1, Math.ceil((entry.start + windowMs - t) / 1000))
+      return { allowed: false, limit, remaining: 0, retryAfter }
+    },
+  }
+}
+
+function checkInteger(name, value) {
+  if (typeof value !== 'number' || Number.isNaN(value)) throw new TypeError(`${name} must be a number`)
+  if (!Number.isSafeInteger(value) || value < 1) throw new RangeError(`${name} must be an integer from 1 to MAX_SAFE_INTEGER`)
+}
