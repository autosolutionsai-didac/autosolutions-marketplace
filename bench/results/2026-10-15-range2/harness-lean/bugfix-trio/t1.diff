 // Renders rows as CSV with a header line. Lines end with \n.
+// Per RFC 4180, a field is wrapped in double quotes when it contains a comma,
+// a double quote, CR or LF; embedded double quotes are doubled. null and
+// undefined render as an empty field.
 export function toCSV(rows, columns) {
-  const lines = [columns.join(',')]
+  const lines = [columns.map(cell).join(',')]
   for (const row of rows) {
     lines.push(columns.map((column) => cell(row[column])).join(','))
   }
@@ -9,5 +12,7 @@ export function toCSV(rows, columns) {
 
 function cell(value) {
   if (value === null || value === undefined) return ''
-  return String(value)
+  const s = String(value)
+  if (/[",\r\n]/.test(s)) return '"' + s.replaceAll('"', '""') + '"'
+  return s
 }
