@@ -13,7 +13,20 @@ export function formatUSD(cents) {
 }
 
 // Applies a percentage discount (0 to 100) to an amount in cents.
+// The result is cents * (100 - percent) / 100 rounded half up to a whole cent.
+// The percent is read as its shortest decimal form (0.04 is exactly 4/100),
+// and the arithmetic is done in BigInt so that ties and large values are exact.
 export function applyDiscount(cents, percent) {
   if (!(percent >= 0 && percent <= 100)) throw new RangeError('percent must be between 0 and 100')
-  return Math.floor((cents * (100 - percent)) / 100)
+  if (!(Number.isSafeInteger(cents) && cents >= 0)) throw new RangeError('cents must be a non-negative integer')
+  // toExponential() with no argument gives the shortest digits that round-trip, e.g. "1.25e+1"
+  const [digits, exp] = percent.toExponential().split('e')
+  const frac = digits.split('.')[1] ?? ''
+  const d = Math.max(0, frac.length - Number(exp))
+  const s = 10n ** BigInt(d)
+  // percent = P / s exactly
+  const P = BigInt(digits.replace('.', '')) * 10n ** BigInt(d - frac.length + Number(exp))
+  const num = BigInt(cents) * (100n * s - P)
+  const den = 100n * s
+  return Number((2n * num + den) / (2n * den))
 }
