+})
+
+test('toCSV ends with exactly one trailing newline', () => {
+  assert.equal(toCSV([], ['a', 'b']), 'a,b\n')
+  assert.equal(toCSV([{ a: 'x,y', b: 1 }], ['a', 'b']), 'a,b\n"x,y",1\n')
