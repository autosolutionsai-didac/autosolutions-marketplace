@@ -13,3 +13,38 @@ test('toCSV renders a header and one line per row', () => {
 test('toCSV leaves missing values empty', () => {
   assert.equal(toCSV([{ a: null }], ['a', 'b']), 'a,b\n,\n')
 })
+
+test('toCSV quotes fields containing a comma', () => {
+  assert.equal(toCSV([{ a: 'team, alpha' }], ['a']), 'a\n"team, alpha"\n')
+})
+
+test('toCSV doubles double quotes and wraps the field', () => {
+  assert.equal(toCSV([{ a: 'say "hi"' }], ['a']), 'a\n"say ""hi"""\n')
+  assert.equal(toCSV([{ a: '"' }], ['a']), 'a\n""""\n')
+})
+
+test('toCSV quotes fields containing line breaks verbatim', () => {
+  assert.equal(toCSV([{ a: 'a\nb' }], ['a']), 'a\n"a\nb"\n')
+  assert.equal(toCSV([{ a: 'a\rb' }], ['a']), 'a\n"a\rb"\n')
+  assert.equal(toCSV([{ a: 'a\r\nb' }], ['a']), 'a\n"a\r\nb"\n')
+})
+
+test('toCSV escapes several special characters in one field', () => {
+  assert.equal(toCSV([{ a: 'x,"y"\nz' }], ['a']), 'a\n"x,""y""\nz"\n')
+})
+
+test('toCSV leaves fields without special characters unquoted', () => {
