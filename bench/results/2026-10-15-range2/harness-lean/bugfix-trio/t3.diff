diff --git a/src/csv.js b/src/csv.js
index f1dc79f..26ffecc 100644
--- a/src/csv.js
+++ b/src/csv.js
@@ -1,13 +1,16 @@
-// Renders rows as CSV with a header line. Lines end with \n.
+// Renders rows as CSV with a header line. Fields are quoted per RFC 4180. Lines end with \n.
 export function toCSV(rows, columns) {
-  const lines = [columns.join(',')]
+  const lines = [columns.map(cell).join(',')]
   for (const row of rows) {
     lines.push(columns.map((column) => cell(row[column])).join(','))
   }
   return lines.join('\n') + '\n'
 }
 
+// Quotes a field when it contains a comma, double quote, CR or LF (RFC 4180).
 function cell(value) {
   if (value === null || value === undefined) return ''
-  return String(value)
+  const text = String(value)
+  if (!/[",\r\n]/.test(text)) return text
+  return '"' + text.replaceAll('"', '""') + '"'
 }
