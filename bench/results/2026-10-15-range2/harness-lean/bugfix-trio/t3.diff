 }
 
-// Applies a percentage discount (0 to 100) to an amount in cents.
+// Applies a percentage discount (0 to 100) to an amount in cents, rounding half up to the nearest cent.
 export function applyDiscount(cents, percent) {
   if (!(percent >= 0 && percent <= 100)) throw new RangeError('percent must be between 0 and 100')
-  return Math.floor((cents * (100 - percent)) / 100)
+  if (!Number.isSafeInteger(cents) || cents < 0) throw new RangeError('cents must be a non-negative integer')
+  const scaled = percent * 10_000
+  const s = Math.round(scaled)
+  if (Math.abs(scaled - s) < 1e-6) {
+    // percent has at most 4 decimals: exact integer arithmetic in ten-thousandths of a percent
+    const n = BigInt(cents) * BigInt(1_000_000 - s)
+    const q = n / 1_000_000n
+    const r = n % 1_000_000n
+    return Number(q + (r * 2n >= 1_000_000n ? 1n : 0n))
+  }
+  return Math.floor((cents * (100 - percent)) / 100 + 0.5)
 }
