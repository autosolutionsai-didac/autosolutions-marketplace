diff --git a/test/csv.test.js b/test/csv.test.js
index 9603268..e1edd5a 100644
--- a/test/csv.test.js
+++ b/test/csv.test.js
@@ -13,3 +13,36 @@ test('toCSV renders a header and one line per row', () => {
 test('toCSV leaves missing values empty', () => {
   assert.equal(toCSV([{ a: null }], ['a', 'b']), 'a,b\n,\n')
 })
+
+test('toCSV quotes fields containing a comma', () => {
+  assert.equal(toCSV([{ key: 'team, alpha', n: 1 }], ['key', 'n']), 'key,n\n"team, alpha",1\n')
+})
+
+test('toCSV doubles double quotes inside quoted fields', () => {
+  assert.equal(toCSV([{ a: 'say "hi"' }], ['a']), 'a\n"say ""hi"""\n')
+  assert.equal(toCSV([{ a: '"' }], ['a']), 'a\n""""\n')
+})
+
+test('toCSV quotes fields with LF, CR or CRLF and keeps the break verbatim', () => {
+  assert.equal(toCSV([{ a: 'a\nb' }], ['a']), 'a\n"a\nb"\n')
+  assert.equal(toCSV([{ a: 'a\rb' }], ['a']), 'a\n"a\rb"\n')
+  assert.equal(toCSV([{ a: 'a\r\nb' }], ['a']), 'a\n"a\r\nb"\n')
+})
+
+test('toCSV does not quote fields without comma, quote, CR or LF', () => {
+  const values = ['plain', 'has space', ' lead and trail ', 'semi;colon', 'tab\there', 'café 日本', 0, 3000000]
+  const expected = ['plain', 'has space', ' lead and trail ', 'semi;colon', 'tab\there', 'café 日本', '0', '3000000']
+  assert.equal(toCSV(values.map((a) => ({ a })), ['a']), 'a\n' + expected.join('\n') + '\n')
+})
+
+test('toCSV renders empty string, null and undefined as empty unquoted fields', () => {
+  assert.equal(toCSV([{ a: '', b: null, c: undefined }], ['a', 'b', 'c']), 'a,b,c\n,,\n')
+})
+
+test('toCSV applies the same quoting to header names', () => {
+  assert.equal(toCSV([], ['a,b', 'c']), '"a,b",c\n')
+})
+
+test('toCSV renders zero rows as the header line only', () => {
+  assert.equal(toCSV([], ['a', 'b']), 'a,b\n')
+})
diff --git a/test/money.test.js b/test/money.test.js
index 917bae5..fcffd90 100644
--- a/test/money.test.js
+++ b/test/money.test.js
@@ -22,3 +22,42 @@ test('applyDiscount', () => {
   assert.throws(() => applyDiscount(1_000, 101), RangeError)
   assert.throws(() => applyDiscount(1_000, -1), RangeError)
 })
+
+test('applyDiscount rounds half up to the nearest cent', () => {
+  // regression: 1001 x 85% = 850.85 must round to 851, not truncate to 850
+  assert.equal(applyDiscount(1_001, 15), 851)
+  // exact .5 tie rounds up
+  assert.equal(applyDiscount(10, 15), 9)
+  assert.equal(applyDiscount(1_000, 10), 900)
+  // exact decimal percents, including ties
+  assert.equal(applyDiscount(100, 12.5), 88)
+  assert.equal(applyDiscount(1, 50), 1)
+  assert.equal(applyDiscount(1, 99.5), 0)
+  assert.equal(applyDiscount(3, 50), 2)
+  assert.equal(applyDiscount(10, 0.1), 10)
+  assert.equal(applyDiscount(500, 0.1), 500)
+  // boundaries
+  assert.equal(applyDiscount(0, 37.5), 0)
+  assert.equal(applyDiscount(777, 0), 777)
+  assert.equal(applyDiscount(777, 100), 0)
+  assert.equal(applyDiscount(Number.MAX_SAFE_INTEGER, 0), Number.MAX_SAFE_INTEGER)
+  assert.equal(applyDiscount(900_719_925_474_099, 15), 765_611_936_652_984)
+  // percents with more than 4 decimals still return a finite integer
+  const odd = applyDiscount(1_000, 33.33333)
+  assert.ok(Number.isInteger(odd))
+  assert.equal(odd, 667)
+  // every integer cents and integer percent matches half-up integer arithmetic
+  for (let cents = 0; cents <= 10_000; cents++) {
+    for (let percent = 0; percent <= 100; percent++) {
+      assert.equal(applyDiscount(cents, percent), Math.floor((cents * (100 - percent) + 50) / 100), `${cents} ${percent}`)
+    }
+  }
+  // invalid cents are rejected
+  for (const cents of [-1, 1.5, NaN, Infinity, Number.MAX_SAFE_INTEGER + 2]) {
+    assert.throws(() => applyDiscount(cents, 10), RangeError)
+  }
+  // invalid percents are rejected
+  for (const percent of [-0.01, 100.01, NaN]) {
+    assert.throws(() => applyDiscount(1_000, percent), RangeError)
+  }
+})
