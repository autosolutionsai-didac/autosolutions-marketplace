+})
+
+test('toCSV keeps line breaks verbatim inside quotes', () => {
+  const rows = [{ a: 'a\nb', b: 'a\rb', c: 'a\r\nb' }]
+  assert.equal(toCSV(rows, ['a', 'b', 'c']), 'a,b,c\n"a\nb","a\rb","a\r\nb"\n')
+})
+
+test('toCSV quotes a lone comma and a mix of specials', () => {
+  assert.equal(toCSV([{ a: ',', b: 'a,"b"\r\n' }], ['a', 'b']), 'a,b\n",","a,""b""\r\n"\n')
+})
