 }
 
-// Applies a percentage discount (0 to 100) to an amount in cents.
+// Applies a percentage discount (0 to 100) to an amount in cents. The result is
+// cents x (100 - percent) / 100 rounded half up to the nearest integer cent.
 export function applyDiscount(cents, percent) {
-  if (!(percent >= 0 && percent <= 100)) throw new RangeError('percent must be between 0 and 100')
-  return Math.floor((cents * (100 - percent)) / 100)
+  if (typeof percent !== 'number' || !(percent >= 0 && percent <= 100)) throw new RangeError('percent must be between 0 and 100')
+  if (!Number.isSafeInteger(cents) || cents < 0) throw new RangeError('cents must be a non-negative integer')
+  // Kept share in millionths of a percent: exact for percents with up to 6 decimal
+  // places; finer percents are rounded to the nearest millionth of a percent.
+  const keep = Math.round((100 - percent) * 1_000_000)
+  // BigInt division truncates and both operands are non-negative, so adding half
+  // the divisor rounds half up.
+  return Number((BigInt(cents) * BigInt(keep) + 50_000_000n) / 100_000_000n)
 }
