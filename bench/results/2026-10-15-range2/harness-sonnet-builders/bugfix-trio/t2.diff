diff --git a/test/money.test.js b/test/money.test.js
index 917bae5..f2e6df8 100644
--- a/test/money.test.js
+++ b/test/money.test.js
@@ -22,3 +22,42 @@ test('applyDiscount', () => {
   assert.throws(() => applyDiscount(1_000, 101), RangeError)
   assert.throws(() => applyDiscount(1_000, -1), RangeError)
 })
+
+test('applyDiscount rounds half up to the nearest cent', () => {
+  assert.equal(applyDiscount(1_001, 15), 851)
+  assert.equal(applyDiscount(10, 15), 9)
+  // exact ties round up
+  assert.equal(applyDiscount(1, 50), 1)
+  assert.equal(applyDiscount(3, 50), 2)
+  assert.equal(applyDiscount(5, 10), 5)
+  // not ties
+  assert.equal(applyDiscount(1_001, 10), 901)
+  assert.equal(applyDiscount(14, 50), 7)
+  assert.equal(applyDiscount(10, 14), 9)
+  assert.equal(applyDiscount(10, 16), 8)
+  // non-integer percents
+  assert.equal(applyDiscount(4, 12.5), 4)
+  assert.equal(applyDiscount(2, 12.5), 2)
+  assert.equal(applyDiscount(100, 33.33), 67)
+  assert.equal(applyDiscount(1, 0.5), 1)
+  assert.equal(applyDiscount(500, 0.1), 500)
+  // boundaries
+  assert.equal(applyDiscount(0, 37.5), 0)
+  assert.equal(applyDiscount(12_345, 0), 12_345)
+  assert.equal(applyDiscount(12_345, 100), 0)
+  // large values stay exact
+  assert.equal(applyDiscount(Number.MAX_SAFE_INTEGER, 0), Number.MAX_SAFE_INTEGER)
+  assert.equal(applyDiscount(Number.MAX_SAFE_INTEGER, 50), 4_503_599_627_370_496)
+  // matches exact BigInt arithmetic across a sweep
+  for (const percent of [0, 0.000001, 0.1, 7.25, 12.5, 33.33, 99.999999, 100]) {
+    for (const cents of [0, 1, 2, 3, 7, 99, 1_001, 123_456_789, Number.MAX_SAFE_INTEGER]) {
+      const keep = BigInt(Math.round((100 - percent) * 1e6))
+      assert.equal(applyDiscount(cents, percent), Number((BigInt(cents) * keep + 50_000_000n) / 100_000_000n))
+    }
+  }
+})
+
+test('applyDiscount rejects invalid inputs', () => {
+  for (const p of [101, -1, NaN, '10', null, undefined]) assert.throws(() => applyDiscount(100, p), RangeError)
+  for (const c of [-1, 1.5, NaN, Infinity, Number.MAX_SAFE_INTEGER + 1, '5']) assert.throws(() => applyDiscount(c, 10), RangeError)
+})
