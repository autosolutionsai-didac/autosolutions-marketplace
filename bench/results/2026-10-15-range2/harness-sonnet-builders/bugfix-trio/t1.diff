+// Exact decimal form of a finite non-negative number: value = p / 10^d.
+function toFraction(n) {
+  const [, int, frac = '', exp = '0'] = /^(\d+)(?:\.(\d+))?(?:e([+-]?\d+))?$/.exec(String(n))
+  let p = BigInt(int + frac)
+  let d = frac.length - Number(exp)
+  if (d < 0) {
+    p *= 10n ** BigInt(-d)
+    d = 0
+  }
+  return { p, d: BigInt(d) }
+}
+
 // Applies a percentage discount (0 to 100) to an amount in cents.
+// The result is cents * (100 - percent) / 100 computed exactly, rounded half up
+// to the nearest integer cent (e.g. 850.85 -> 851, 8.5 -> 9).
 export function applyDiscount(cents, percent) {
-  if (!(percent >= 0 && percent <= 100)) throw new RangeError('percent must be between 0 and 100')
-  return Math.floor((cents * (100 - percent)) / 100)
+  if (typeof percent !== 'number' || !Number.isFinite(percent) || !(percent >= 0 && percent <= 100)) {
+    throw new RangeError('percent must be between 0 and 100')
+  }
+  if (!Number.isSafeInteger(cents) || cents < 0) {
+    throw new RangeError('cents must be a non-negative integer')
+  }
+  const { p, d } = toFraction(percent)
+  const den = 100n * 10n ** d
+  const num = BigInt(cents) * (den - p)
+  return Number((2n * num + den) / (2n * den))
 }
