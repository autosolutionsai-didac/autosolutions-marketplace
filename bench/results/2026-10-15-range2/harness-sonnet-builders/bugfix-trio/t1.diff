--- a/test/csv.test.js
+++ b/test/csv.test.js
@@ -13,3 +13,38 @@ test('toCSV renders a header and one line per row', () => {
 test('toCSV leaves missing values empty', () => {
   assert.equal(toCSV([{ a: null }], ['a', 'b']), 'a,b\n,\n')
 })
+
+test('toCSV quotes a key containing a comma', () => {
+  assert.equal(
+    toCSV([{ key: 'team, alpha', requests: 1 }], ['key', 'requests']),
+    'key,requests\n"team, alpha",1\n',
+  )
+})
+
+test('toCSV quotes and doubles double quotes', () => {
+  assert.equal(toCSV([{ a: 'say "hi"', b: '"' }], ['a', 'b']), 'a,b\n"say ""hi""",""""\n')
+})
+
+test('toCSV keeps line breaks verbatim inside quotes', () => {
+  assert.equal(toCSV([{ a: 'a\nb', b: 'a\rb', c: 'a\r\nb' }], ['a', 'b', 'c']), 'a,b,c\n"a\nb","a\rb","a\r\nb"\n')
+})
+
+test('toCSV leaves ordinary fields unquoted', () => {
+  const row = { a: 'plain', b: 3_000_000, c: 0, d: 'two words', e: ' x ', f: 'a;b', g: 'a\tb', h: 'café ✓', i: '' }
+  assert.equal(
+    toCSV([row], Object.keys(row)),
+    'a,b,c,d,e,f,g,h,i\nplain,3000000,0,two words, x ,a;b,a\tb,café ✓,\n',
+  )
+})
+
+test('toCSV handles null, undefined and a lone comma', () => {
+  assert.equal(toCSV([{ a: null, b: undefined, c: ',' }], ['a', 'b', 'c']), 'a,b,c\n,,","\n')
+})
+
+test('toCSV quotes header names with special characters', () => {
+  assert.equal(toCSV([{ 'a,b': 1, 'c"d': 2 }], ['a,b', 'c"d']), '"a,b","c""d"\n1,2\n')
+})
+
+test('toCSV quotes non-string values whose text contains a comma', () => {
+  assert.equal(toCSV([{ a: [1, 2], b: -1.5 }], ['a', 'b']), 'a,b\n"1,2",-1.5\n')
+})
