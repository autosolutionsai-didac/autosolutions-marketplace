@@ -15,6 +15,43 @@ test('microToCents rounds to the nearest cent', () => {
   assert.equal(microToCents(15_000), 2)
 })
 
+test('applyDiscount rounds half up to the nearest cent', () => {
+  assert.equal(applyDiscount(1001, 15), 851)
+  assert.equal(applyDiscount(10, 15), 9)
+  assert.equal(applyDiscount(1003, 15), 853)
+  assert.equal(applyDiscount(1, 60), 0)
+  assert.equal(applyDiscount(1, 50), 1)
+  assert.equal(applyDiscount(3, 50), 2)
+  assert.equal(applyDiscount(1, 99.5), 0)
+  assert.equal(applyDiscount(100, 12.5), 88)
+  assert.equal(applyDiscount(500, 33.3), 334)
+  assert.equal(applyDiscount(1000, 0.05), 1000)
+  assert.equal(applyDiscount(10, 1e-7), 10)
+  assert.equal(applyDiscount(10, 99.99999), 0)
+  assert.equal(applyDiscount(Number.MAX_SAFE_INTEGER, 0), Number.MAX_SAFE_INTEGER)
+  assert.equal(applyDiscount(Number.MAX_SAFE_INTEGER, 50), 4503599627370496)
+  assert.equal(applyDiscount(Number.MAX_SAFE_INTEGER, 100), 0)
+  assert.equal(applyDiscount(0, 37.5), 0)
+})
+
+test('applyDiscount matches an integer oracle for integer percents', () => {
+  for (let c = 0; c <= 2000; c++) {
+    for (let p = 0; p <= 100; p++) {
+      const expected = Math.floor((2 * c * (100 - p) + 100) / 200)
+      assert.equal(applyDiscount(c, p), expected, `${c} ${p}`)
+    }
+  }
+})
+
+test('applyDiscount rejects invalid input', () => {
+  for (const p of [101, -1, -0.0001, 100.0001, NaN, Infinity, -Infinity, '15', null, undefined]) {
+    assert.throws(() => applyDiscount(1_000, p), RangeError, String(p))
+  }
+  for (const c of [-1, 1.5, NaN, Infinity, 2 ** 53, '10', undefined]) {
+    assert.throws(() => applyDiscount(c, 10), RangeError, String(c))
+  }
+})
+
 test('applyDiscount', () => {
   assert.equal(applyDiscount(1_000, 0), 1_000)
   assert.equal(applyDiscount(1_000, 10), 900)
