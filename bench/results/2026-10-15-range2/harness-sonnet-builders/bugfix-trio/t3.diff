@@ -13,3 +13,34 @@ test('toCSV renders a header and one line per row', () => {
 test('toCSV leaves missing values empty', () => {
   assert.equal(toCSV([{ a: null }], ['a', 'b']), 'a,b\n,\n')
 })
+
+test('toCSV quotes fields containing a comma', () => {
+  assert.equal(toCSV([{ a: 'team, alpha' }], ['a']), 'a\n"team, alpha"\n')
+})
+
+test('toCSV doubles double quotes and quotes the field', () => {
+  assert.equal(toCSV([{ a: 'say "hi"' }], ['a']), 'a\n"say ""hi"""\n')
+  assert.equal(toCSV([{ a: '"' }], ['a']), 'a\n""""\n')
+})
+
+test('toCSV quotes fields containing LF, CR or CRLF verbatim', () => {
+  assert.equal(toCSV([{ a: 'a\nb' }], ['a']), 'a\n"a\nb"\n')
+  assert.equal(toCSV([{ a: 'a\rb' }], ['a']), 'a\n"a\rb"\n')
+  assert.equal(toCSV([{ a: 'a\r\nb' }], ['a']), 'a\n"a\r\nb"\n')
+})
+
+test('toCSV leaves other fields unquoted', () => {
+  const values = [0, 3_000_000, '', ' pad ', 'a\tb', 'a;b', "it's", 'héllo ✓']
+  const columns = values.map((_, i) => 'c' + i)
+  const rows = [Object.fromEntries(values.map((v, i) => ['c' + i, v]))]
+  assert.equal(toCSV(rows, columns), columns.join(',') + '\n' + values.join(',') + '\n')
+})
+
+test('toCSV converts non-strings before checking', () => {
