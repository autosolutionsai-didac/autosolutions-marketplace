+
+// Applies a percentage discount (0 to 100, at most two decimals) to an amount in
+// cents, rounding half up to the nearest cent using exact integer arithmetic.
 export function applyDiscount(cents, percent) {
+  if (!Number.isSafeInteger(cents) || cents < 0) throw new RangeError('cents must be a non-negative integer')
+  if (typeof percent !== 'number' || Number.isNaN(percent)) throw new RangeError('percent must be a number')
