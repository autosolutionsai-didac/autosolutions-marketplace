+  const invoice = ledger.invoice('acme')
+  assert.equal(invoice.subtotalCents, 1_001)
+  assert.equal(invoice.totalCents, 851)
+})
+
+test('setDiscount and the constructor validate the percent', () => {
+  const ledger = new Ledger()
+  for (const p of [101, -1, NaN, Infinity, '15', 33.333, null]) {
+    assert.throws(() => ledger.setDiscount('k', p), ValidationError, `setDiscount ${String(p)}`)
+    assert.throws(() => new Ledger({ discounts: { k: p } }), ValidationError, `constructor ${String(p)}`)
+  }
+  for (const p of [0, 15, 12.5, 33.33, 100]) {
+    ledger.setDiscount('k', p)
+    assert.equal(ledger.discounts.k, p)
+  }
+  ledger.record({ key: 'k', model: 'claude-sonnet-5', usage, at: 1 })
+  assert.doesNotThrow(() => ledger.invoice('k'))
+})
diff --git a/test/money.test.js b/test/money.test.js
index 917bae5..cb6731c 100644
--- a/test/money.test.js
+++ b/test/money.test.js
@@ -22,3 +22,46 @@ test('applyDiscount', () => {
   assert.throws(() => applyDiscount(1_000, 101), RangeError)
   assert.throws(() => applyDiscount(1_000, -1), RangeError)
 })
+
+test('applyDiscount rounds half up to the nearest cent', () => {
+  assert.equal(applyDiscount(1_001, 15), 851)
+  assert.equal(applyDiscount(10, 15), 9)
+  assert.equal(applyDiscount(1, 50), 1)
+  assert.equal(applyDiscount(3, 50), 2)
+  assert.equal(applyDiscount(1, 60), 0)
+  assert.equal(applyDiscount(0, 37), 0)
+  assert.equal(applyDiscount(4, 12.5), 4)
+  assert.equal(applyDiscount(100, 33.33), 67)
+  assert.equal(applyDiscount(1, 0.5), 1)
+  assert.equal(applyDiscount(Number.MAX_SAFE_INTEGER, 0), Number.MAX_SAFE_INTEGER)
+  assert.equal(applyDiscount(Number.MAX_SAFE_INTEGER, 50), 4503599627370496)
+  assert.equal(applyDiscount(Number.MAX_SAFE_INTEGER, 100), 0)
+})
+
+test('applyDiscount matches exact integer half-up for many inputs', () => {
+  for (let cents = 0; cents <= 200; cents++) {
+    for (let bp = 0; bp <= 10_000; bp += 7) {
+      const expected = Math.floor((cents * (10_000 - bp) + 5_000) / 10_000)
+      assert.equal(applyDiscount(cents, bp / 100), expected, `${cents} at ${bp / 100}%`)
+    }
+  }
+})
+
+test('applyDiscount rejects invalid input', () => {
+  for (const p of [101, -1, -0.01, 100.01, NaN, Infinity, '15', 33.333, null, undefined]) {
+    assert.throws(() => applyDiscount(1_000, p), RangeError, `percent ${String(p)}`)
+  }
+  for (const c of [-1, 10.5, NaN, Infinity, '100', null, Number.MAX_SAFE_INTEGER + 1]) {
+    assert.throws(() => applyDiscount(c, 10), RangeError, `cents ${String(c)}`)
+  }
+})
+
+test('applyDiscount error messages describe the problem', () => {
+  for (const p of ['15', null, undefined, true, 10n, NaN, {}]) {
+    assert.throws(() => applyDiscount(1_000, p), { name: 'RangeError', message: 'percent must be a number' }, `percent ${String(p)}`)
+  }
+  for (const p of [101, -1, -0.01, 100.01, Infinity, -Infinity]) {
+    assert.throws(() => applyDiscount(1_000, p), { name: 'RangeError', message: 'percent must be between 0 and 100' }, `percent ${p}`)
+  }
+  assert.throws(() => applyDiscount(1_000, 33.333), { name: 'RangeError', message: 'percent must have at most two decimal places' })
+})
